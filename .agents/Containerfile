# Shared Linux tools; future harness targets can extend this stage.
FROM docker.io/library/node:22-bookworm-slim AS development
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl bash jq ca-certificates python3 python3-pip python3-venv \
    build-essential pkg-config cmake unzip zip ripgrep procps \
    && rm -rf /var/lib/apt/lists/*
# The node image supplies uid/gid 1000; rootless keep-id maps the host user here.
RUN mkdir -p /home/node/.codex /home/node/.headroom /proxy-auth /workspace \
    && chown -R node:node /home/node /proxy-auth /workspace
ENV HOME=/home/node
WORKDIR /workspace

FROM development AS codex
ARG CODEX_VERSION=0.159.3
RUN npm install --global --cache /tmp/codex-build-cache @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force --cache /tmp/codex-build-cache
COPY codex-entrypoint.sh /usr/local/bin/agent-entrypoint
RUN chmod 755 /usr/local/bin/agent-entrypoint
ENV CODEX_HOME=/home/node/.codex
# Runtime updates and cache stay in the harness's dedicated state volume.
ENV NPM_CONFIG_PREFIX=/home/node/.agent-tools/npm \
    NPM_CONFIG_CACHE=/home/node/.agent-tools/npm-cache \
    PATH=/home/node/.agent-tools/npm/bin:$PATH
USER node
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
CMD ["bash"]

FROM development AS headroom
ARG HEADROOM_VERSION=0.39.1
RUN python3 -m venv /opt/headroom \
    && /opt/headroom/bin/pip install --no-cache-dir "headroom-ai[proxy]==${HEADROOM_VERSION}"
ENV PATH=/opt/headroom/bin:$PATH
COPY headroom-entrypoint.sh /usr/local/bin/headroom-entrypoint
COPY headroom-dashboard.py /usr/local/bin/headroom-dashboard.py
RUN chmod 755 /usr/local/bin/headroom-entrypoint
USER node
ENTRYPOINT ["/usr/local/bin/headroom-entrypoint"]
