# .env.example — copy to `.env` (which is git-ignored) and fill in the secrets.
#
#   cp .env.example .env
#
# Get the real secret values from the team / Azure Key Vault.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for Visual Studio docker-compose debugging
# ─────────────────────────────────────────────────────────────────────────────
# Every service in docker-compose.yaml is gated behind a `profiles:` key. With no
# active profile, Visual Studio's docker-compose build fails with
#   DT1001: no service selected
# COMPOSE_PROFILES activates them all so VS (and bare `docker compose`) see them.
COMPOSE_PROFILES=all
#
# The e2e-tests service lives in docker-compose.e2e.yml, kept OUT of
# docker-compose.yaml so VS doesn't try to manage the one-shot test runner and
# fail with "Cannot find the container for the service 'e2e-tests'". This line
# merges it back in for bare `docker compose` (so `make test-e2e` still works).
# Visual Studio passes an explicit `-f docker-compose.yaml` and ignores
# COMPOSE_FILE, so it never sees e2e-tests.  (On Windows the separator is `;`.)
COMPOSE_FILE=docker-compose.yaml;docker-compose.e2e.yml

# ─────────────────────────────────────────────────────────────────────────────
# DfE Sign-In (test environment)
# ─────────────────────────────────────────────────────────────────────────────
DFESIGNIN_APICLIENTSECRET=<dfe-signin-api-client-secret>
DFESIGNIN_CLIENTSECRET=<dfe-signin-client-secret>
DFESIGNIN_CLIENTID=CheckPerformanceData
DFESIGNIN_BASEURL=https://test-api.signin.education.gov.uk/
DFESIGNIN_AUDIENCE=signin.education.gov.uk
DFESIGNIN_METADATAADDRESS=https://test-oidc.signin.education.gov.uk/.well-known/openid-configuration
DFESIGNIN_SERVICEID=<dfe-signin-service-id>

# ─────────────────────────────────────────────────────────────────────────────
# Postgres + pgAdmin (local dev defaults)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=cypd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PGADMIN_IMAGE_TAG=9.14.0
PGADMIN_DEFAULT_EMAIL=admin@education.gov.uk
PGADMIN_DEFAULT_PASSWORD=<pgadmin-password>

# ─────────────────────────────────────────────────────────────────────────────
# Zendesk integration (rules-engine worker). Secrets + custom-field IDs come
# from the team — the IDs are specific to the Zendesk instance.
# ─────────────────────────────────────────────────────────────────────────────
ZendeskSettings_Subdomain=esfa-preprod
ZendeskSettings_Domain=zendesk
ZendeskSettings_Email=<zendesk-service-account-email>
ZendeskSettings_ApiToken=<zendesk-api-token>
ZendeskSettings_ClientId=<zendesk-client-id>
ZendeskSettings_ClientSecret=<zendesk-client-secret>

ZendeskTicketFields_UpnId=
