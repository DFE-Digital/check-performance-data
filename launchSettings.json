{
  "profiles": {
    "Docker Compose": {
      "commandName": "DockerCompose",
      "commandVersion": "1.0",
      "composeProfile": {
        "includes": [
          "rules_engine",
          "web",
          "database",
          "storage"
        ],
        "launchBrowser": true,
        "launchUrl": "http://localhost:8080",
        "applicationUrl": "https://localhost:8080",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    }
  }
}