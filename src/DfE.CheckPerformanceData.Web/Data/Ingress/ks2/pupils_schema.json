{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pupils_schema.json",
  "title": "KS2 pupils",
  "description": "One row of the supplier's (LDS) KS2 pupil file, transcribed from the KS2 field specification. One schema serves the September and December files: they have the same fields in the same order, and only the column letters differ (x-csv.columns 'september' and 'december'). Field references are the CSV headers. Four supplier columns are read under the names the journeys read (x-ingress.source): P_INCL <- PINCL_Flag, SEX <- Sex, SENF <- SEN, ETHNIC <- ETHNICITY.",
  "type": "object",
  "additionalProperties": false,
  "x-ingress": {
    "collection": "pupils",
    "pageTab": "pupils",
    "institutionKey": "LAESTAB",
    "inclusion": {
      "field": "P_INCL",
      "included": [
        "201"
      ],
      "descriptionField": "P_INCL_DESC",
      "descriptions": {
        "201": "Pupil included in KS2 calculations as at the end of KS2.",
        "202": "Pupil excluded from KS2 calculations as not at the end of KS2.",
        "203": "Pupil excluded from KS2 calculations at the request of the school."
      }
    }
  },
  "x-download": {
    "fileName": "ks2pupils.csv",
    "label": "Pupils"
  },
  "x-display": {
    "tab": "pupils",
    "section": "Pupils",
    "selectorOrder": 0
  },
  "properties": {
    "INCLUDED": {
      "type": "boolean",
      "description": "Stamped by ingress from x-ingress.inclusion: true when P_INCL is an included code. Not a supplier column, so not downloaded or shown.",
      "x-csv": {
        "columns": {},
        "heading": "Included"
      },
      "x-display": {
        "label": "Included",
        "visible": false,
        "order": 999
      }
    },
    "LAESTAB": {
      "type": [
        "string",
        "null"
      ],
      "description": "7-digit LA/establishment number",
      "x-csv": {
        "columns": {
          "september": "A",
          "december": "A"
        },
        "heading": "DfE Establishment number"
      },
      "x-display": {
        "label": "DfE Establishment number",
        "visible": false,
        "order": 9
      }
    },
    "URN": {
      "type": [
        "integer",
        "null"
      ],
      "description": "6-digit school unique reference number",
      "minimum": 0,
      "maximum": 999999,
      "x-csv": {
        "columns": {
          "september": "B",
          "december": "B"
        },
        "heading": "School Unique Reference Number (URN)"
      },
      "x-display": {
        "label": "School URN",
        "visible": false,
        "order": 10
      }
    },
    "UPN": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unique Pupil Number. May be incorrect or missing: it is not yet used directly in the calculation of performance data.",
