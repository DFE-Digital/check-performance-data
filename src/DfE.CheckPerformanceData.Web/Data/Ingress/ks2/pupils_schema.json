        "columns": {
          "september": "C",
          "december": "C"
        },
        "heading": "Unique Pupil Number (UPN)"
      },
      "x-display": {
        "label": "UPN",
        "visible": true,
        "order": 4,
        "searchable": true
      }
    },
    "CYPMD_ID": {
