        "columns": {
          "default": "N"
        },
        "heading": "Qualification type"
      },
      "x-display": {
        "label": "Qualification type",
        "visible": true,
        "order": 3
      }
    },
    "PTQ_INCLUDE": {
      "type": [
        "string",
        "null"
      ],
      "description": "Key stage 4 result is in the list of qualifications that count in 2025 performance measures: N = No, Y = Yes, null = KS2 results.",
