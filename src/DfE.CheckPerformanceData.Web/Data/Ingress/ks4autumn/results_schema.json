{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results_schema.json",
  "title": "Results",
  "description": "One row of the supplier's (LDS) KS4 results file, transcribed from the LDS Data Spec tab 'KS4 Results Data (Restructured)'. Field references are the CSV headers; the 'Column heading provided on file' is the heading of the CSV a school downloads, in column order A-AM. MATCHREF, EXAMCAND and MATCHREG have no column and the EBacc fields marked removed (2026) are left out. QAN, QUAL_NAME, SYLLABUS and SESSION are not CSV columns: x-ingress.source fills them from GNUMBER, QUALIFICATION_DESCRIPTION, BRDSUBNO and SEASON_AND_YEAR. The slot stamps SOURCE. Like the other results schemas, it sets no maxLength.",
  "type": "object",
  "additionalProperties": false,
  "x-ingress": {
    "collection": "results",
    "pageTab": "results",
    "institutionKey": "LAESTAB"
  },
  "x-download": {
    "fileName": "ks4results.csv",
    "label": "Results"
  },
  "x-display": {
    "tab": "results",
    "section": "Results",
    "selectorOrder": 0
  },
  "properties": {
    "CANDNO": {
      "type": [
        "string",
        "null"
      ],
      "description": "A number allocated to each pupil within each school",
      "x-csv": {
        "columns": {
          "default": "A"
        },
        "heading": "Candidate number"
      },
      "x-display": {
        "label": "Candidate number",
        "visible": false
      }
    },
    "CYPMD_ID": {
      "type": [
        "string",
        "null"
      ],
      "description": "A unique pupil ID used in the Check Your Performance Measures Data service",
      "x-csv": {
        "columns": {
          "default": "B"
        },
        "heading": "CYPMD ID"
      },
      "x-display": {
        "label": "CYPMD ID",
        "visible": false
      }
    },
    "SURNAME": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pupil surname",
      "x-csv": {
        "columns": {
          "default": "C"
        },
        "heading": "Surname"
      },
      "x-display": {
        "label": "Surname",
        "visible": true,
        "order": 1,
        "searchable": true
      }
    },
    "FORENAME": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pupil forename",
      "x-csv": {
        "columns": {
          "default": "D"
        },
        "heading": "Forename"
      },
      "x-display": {
        "label": "Forename",
        "visible": true,
        "order": 2,
        "searchable": true
      }
    },
    "Sex": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pupil sex (F = female, M = male, or blank)",
      "x-csv": {
        "columns": {
          "default": "E"
        },
        "heading": "Sex"
      },
      "x-display": {
        "label": "Sex",
        "visible": false
      }
    },
    "DOB": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pupil date of birth in format DD/MM/YYYY",
      "x-csv": {
        "columns": {
          "default": "F"
        },
        "heading": "Date of birth"
      },
      "x-display": {
        "label": "Date of birth",
        "visible": false
      }
    },
    "AGE": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pupil age at the start of the school year (31 August 2025)",
      "x-csv": {
        "columns": {
          "default": "G"
        },
        "heading": "Age"
      },
      "x-display": {
        "label": "Age",
        "visible": false
      }
    },
    "P_INCL": {
      "type": [
        "string",
        "null"
      ],
