        "columns": {
          "default": "S"
        },
        "heading": "Discount code"
      },
      "x-display": {
        "label": "Discount code",
        "visible": false
      }
    },
    "WOLF_INCLUDED": {
      "type": [
        "string",
        "null"
      ],
      "description": "Qualification category: 0 = not included in the current methodology, 1 = technical awards, 2 = GCSE and established iGCSE, 3 = graded music examinations at grade 6 and above, 4 = other level 3 qualifications.",
      "x-csv": {
        "columns": {
          "default": "T"
        },
        "heading": "Qualification inclusion category"
      },
      "x-display": {
        "label": "Qualification inclusion category",
        "visible": false
      }
    },
    "QUALIFICATION_DESCRIPTION": {
      "type": [
        "string",
