      "x-csv": {
        "columns": {
          "default": "K"
        },
        "heading": "UPN"
      },
      "x-display": {
        "label": "UPN",
        "visible": false
      }
    },
    "EXAMNO": {
      "type": [
        "string",
        "null"
      ],
