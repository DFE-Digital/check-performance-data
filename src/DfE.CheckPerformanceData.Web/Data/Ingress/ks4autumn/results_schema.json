        "columns": {
          "default": "O"
        },
        "heading": "KS4 result included in current method"
      },
      "x-display": {
        "label": "KS4 result included in current method",
        "visible": false
      }
    },
    "R_INCL": {
      "type": [
        "string",
        "null"
      ],
      "description": "Which discounting rules apply to the qualification: 41 = included in 2025 secondary school performance measures, 42 = discounted by an earlier or a better result, 43 = not counted as only three non-GCSEs can count, 45 = not included in secondary school performance measures, 49 = Covid impacted and cannot be amended.",
