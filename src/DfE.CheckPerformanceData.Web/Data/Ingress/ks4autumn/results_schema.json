    "SCORE": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scaled score (KS2 2017 onwards), 0-999 or N. Set to null in 2025 and 2026: there is no KS2 prior attainment data from 2020 and 2021 (Covid).",
      "x-csv": {
        "columns": {
          "default": "Y"
        },
        "heading": "Scaled Score"
      },
      "x-display": {
        "label": "Scaled Score",
        "visible": false
      }
    },
    "KS2_SPECIAL_CONSIDERATION": {
      "type": [
        "string",
        "null"
      ],
