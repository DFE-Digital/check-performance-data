{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results-late-2_schema.json",
  "title": "Late results 2",
  "description": "One row of the 16-19 second late results file, which arrives in November (data specification: 1618 names). The same columns as results-late_schema.json, but its own collection, download and section, so late results 1 and late results 2 are two datasets on the Results tab rather than one. The slot stamps SOURCE (16to19_LR2). A property with x-ingress.source is read from that CSV column, so the journey's QAN, QUAL_NAME, SYLLABUS and SESSION are filled from the supplier's own column names.",
  "type": "object",
  "additionalProperties": false,
  "x-ingress": {
    "collection": "results-late-2",
    "pageTab": "results",
    "institutionKey": "LAESTAB"
  },
  "x-download": {
    "fileName": "late-results-2.csv",
    "label": "Late results 2"
  },
  "x-display": {
    "tab": "results",
    "section": "Late results 2",
    "selectorOrder": 3
  },
  "properties": {
    "LAESTAB": {
      "type": [
        "string",
        "null"
      ],
      "description": "DfE number for the institution",
      "x-csv": {
        "columns": {
          "default": "A"
        },
        "heading": "DfE Establishment Number"
      },
      "x-display": {
        "label": "DfE Establishment Number",
        "visible": false
      }
    },
    "CYPMD_ID": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student identifier (16-18: 50001-999999)",
      "x-csv": {
        "columns": {
          "default": "B"
        },
        "heading": "CYPMD ID"
      },
      "x-display": {
        "label": "CYPMD ID",
        "visible": false
      }
    },
    "SURNAME": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student surname",
      "x-csv": {
        "columns": {
          "default": "C"
        },
        "heading": "Surname"
      },
      "x-display": {
        "label": "Surname",
        "visible": true,
        "order": 1,
        "searchable": true
      }
    },
    "FORENAMES": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student forename",
      "x-csv": {
        "columns": {
          "default": "D"
        },
        "heading": "Forename"
      },
      "x-display": {
        "label": "Forename",
        "visible": true,
        "order": 2,
        "searchable": true
      }
    },
    "AB_CODE_NDAQ": {
      "type": [
        "string",
        "null"
      ],
      "description": "Awarding body",
      "x-csv": {
        "columns": {
          "default": "E"
        },
        "heading": "Awarding Body"
      },
      "x-display": {
        "label": "Awarding Body",
        "visible": false
      }
    },
    "Short_Qual_Desc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Type of qualification",
      "x-csv": {
        "columns": {
          "default": "F"
        },
        "heading": "Qualification type"
      },
      "x-display": {
        "label": "Qualification type",
        "visible": true,
        "order": 3
      }
    },
    "SESSION": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exam season and year, from EXAM_YEAR_SEASON",
      "x-ingress": {
        "source": "EXAM_YEAR_SEASON"
      },
      "x-csv": {
        "columns": {
          "default": "G"
        },
        "heading": "Exam/Assessment SEASON AND YEAR"
      },
      "x-display": {
        "label": "Exam/Assessment SEASON AND YEAR",
        "visible": true,
        "order": 6
      }
    },
    "EXAM_DATE": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exam date",
      "x-csv": {
        "columns": {
          "default": "H"
        },
        "heading": "Exam date"
      },
      "x-display": {
        "label": "Exam date",
        "visible": false
      }
    },
    "Discount_Code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Discount code",
      "x-csv": {
        "columns": {
          "default": "I"
        },
        "heading": "Discount Code"
      },
      "x-display": {
        "label": "Discount Code",
        "visible": false
      }
    },
    "QUAL_NAME": {
      "type": [
        "string",
        "null"
      ],
      "description": "Qualification description, from SYLLABUS_TITLE",
      "x-ingress": {
        "source": "SYLLABUS_TITLE"
      },
      "x-csv": {
        "columns": {
          "default": "J"
        },
        "heading": "Qualification description"
      },
      "x-display": {
        "label": "Qualification description",
        "visible": true,
        "order": 4
      }
    },
    "QAN": {
      "type": [
        "string",
        "null"
      ],
      "description": "Qualification number, from GNUMBER",
      "x-ingress": {
        "source": "GNUMBER"
      },
      "x-csv": {
        "columns": {
          "default": "K"
        },
        "heading": "QAN number"
      },
      "x-display": {
        "label": "QAN number",
        "visible": true,
        "order": 5
      }
    },
    "SYLLABUS": {
      "type": [
        "string",
        "null"
      ],
      "description": "Syllabus code, from BRDSUBNO",
      "x-ingress": {
        "source": "BRDSUBNO"
      },
      "x-csv": {
        "columns": {
          "default": "L"
        },
        "heading": "Syllabus code"
      },
      "x-display": {
        "label": "Syllabus code",
        "visible": false
      }
    },
    "GRADE": {
      "type": [
        "string",
        "null"
      ],
      "description": "Grade",
      "x-csv": {
        "columns": {
          "default": "M"
        },
        "heading": "Grade"
      },
      "x-display": {
        "label": "Grade",
        "visible": true,
        "order": 7
      }
    },
    "Late_Result_Type": {
      "type": [
        "string",
        "null"
      ],
      "description": "'Amendment' (corrects a result in an earlier file) or 'New'",
      "x-csv": {
        "columns": {
          "default": "N"
        },
        "heading": "Late result type"
      },
      "x-display": {
        "label": "Late result type",
        "visible": true,
        "order": 8
      }
    },
    "SOURCE": {
      "type": [
        "string",
        "null"
      ],
      "description": "The results file the row came in, stamped from the dataset slot (16to19_LR2). Not a CSV column.",
      "x-csv": {
        "columns": {},
        "heading": "Source file"
      },
      "x-display": {
        "label": "Source file",
        "visible": false
      }
    }
  }
}
