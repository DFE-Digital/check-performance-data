{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "students-aims_schema.json",
  "title": "Pupil aims",
  "description": "One row of the 16-19 pupil aims data file, as the data specification defines it (fields 1-15, headed by field reference): one row per student per learning aim. The descriptive column heading is the heading of the CSV a school downloads, in column order A-N. cypmd_pk has no column and is not exported. Rows are split by LAESTAB, the student's institution; AimLAESTAB is where the aim was recorded and may differ.",
  "type": "object",
  "additionalProperties": false,
  "x-ingress": {
    "collection": "students-aims",
    "pageTab": "students",
    "institutionKey": "LAESTAB"
  },
  "x-download": {
    "fileName": "ks5aim25.csv",
    "label": "Pupil aims"
  },
  "x-display": {
    "tab": "students",
    "section": "Pupil aims",
    "selectorOrder": 4
  },
  "properties": {
    "LAESTAB": {
      "type": [
        "string",
        "null"
      ],
      "description": "DfE number for institution",
      "x-csv": {
        "columns": {
          "default": "A"
        },
        "heading": "DfE number"
      },
      "x-display": {
        "label": "DfE number",
        "visible": false
      }
    },
    "URN": {
      "type": [
        "string",
        "null"
      ],
      "description": "School or college URN",
      "x-csv": {
        "columns": {
          "default": "B"
        },
        "heading": "URN"
      },
      "x-display": {
        "label": "URN",
        "visible": false
      }
    },
    "UKPRN": {
      "type": [
        "string",
        "null"
      ],
      "description": "School or college UKPRN",
      "x-csv": {
        "columns": {
          "default": "C"
        },
        "heading": "UKPRN"
      },
      "x-display": {
        "label": "UKPRN",
        "visible": false
      }
    },
    "AimLAESTAB": {
      "type": [
        "string",
        "null"
      ],
      "description": "The DfE number for the provider where an aim is recorded. This maybe different to where the student is allocated or qualification assessed.",
      "x-csv": {
        "columns": {
          "default": "D"
        },
        "heading": "DfE number where the aim was recorded"
      },
      "x-display": {
        "label": "DfE number where the aim was recorded",
        "visible": true,
        "order": 6
      }
    },
    "ULN": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student's Unique Learner Number",
      "x-csv": {
        "columns": {
          "default": "E"
        },
        "heading": "ULN"
      },
      "x-display": {
        "label": "ULN",
        "visible": false
      }
    },
    "CYPMD_ID": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student index number (for use in checking exercise)",
      "x-csv": {
        "columns": {
          "default": "F"
        },
        "heading": "CYPMD ID"
      },
      "x-display": {
        "label": "CYPMD ID",
        "visible": false
      }
    },
    "SURNAME": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student surname",
      "x-csv": {
        "columns": {
          "default": "G"
        },
        "heading": "Surname"
      },
      "x-display": {
        "label": "Surname",
        "visible": true,
        "order": 1,
        "searchable": true
      }
    },
    "FORENAMES": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student forename",
      "x-csv": {
        "columns": {
          "default": "H"
        },
        "heading": "Forename"
      },
      "x-display": {
        "label": "Forename",
        "visible": true,
        "order": 2,
        "searchable": true
      }
    },
    "SEX": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student Sex (F = female, M = male)",
      "x-csv": {
        "columns": {
          "default": "I"
        },
        "heading": "Sex"
      },
      "x-display": {
        "label": "Sex",
        "visible": false
      }
    },
    "DOB": {
      "type": [
        "string",
        "null"
      ],
      "description": "Student date of birth in format DD/MM/YYYY",
      "x-csv": {
        "columns": {
          "default": "J"
        },
        "heading": "Date of birth"
      },
      "x-display": {
        "label": "Date of birth",
        "visible": false
      }
    },
    "AGE": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Student age at beginning of the reporting year (i.e. 31 August 2025)",
      "x-csv": {
        "columns": {
          "default": "K"
        },
        "heading": "Age"
      },
      "x-display": {
        "label": "Age",
        "visible": false
      }
    },
    "LearningAimReference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Qualification number for each qualification (one row per qualification)",
      "x-csv": {
        "columns": {
          "default": "L"
        },
        "heading": "Qualification number"
      },
      "x-display": {
        "label": "Qualification number",
        "visible": true,
        "order": 3
      }
    },
    "Subj_Desc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Subject description for this learning aim",
      "x-csv": {
        "columns": {
          "default": "M"
        },
        "heading": "Description of subject"
      },
      "x-display": {
        "label": "Description of subject",
        "visible": true,
        "order": 4
      }
    },
    "Aim_Type": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Learning aim type (2 = tech levels, 4 = tech certifications, 5 = other level 2 vocational qualifications). Tech certifications are a subset of the level 2 vocational category.",
      "x-csv": {
        "columns": {
          "default": "N"
        },
        "heading": "Aim type"
      },
      "x-display": {
        "label": "Aim type",
        "visible": true,
        "order": 5
      }
    },
    "cypmd_pk": {
      "type": [
        "string",
        "null"
      ],
      "description": "primary key for use by Oracle team (aimlaestab,pupilid,learningaimreference)",
      "x-csv": {
        "columns": {},
        "heading": "cypmd_pk"
      },
      "x-display": {
        "label": "cypmd_pk",
        "visible": false
      }
    }
  }
}
