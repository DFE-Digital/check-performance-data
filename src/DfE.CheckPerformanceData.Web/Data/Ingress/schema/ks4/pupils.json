{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pupils.json",
  "title": "Pupils",
  "description": "Dev seed schema for a KS4 pupil file, in the shape PupilRecord reads. There is no confirmed supplier KS4 schema in the repo yet; replace this when there is.",
