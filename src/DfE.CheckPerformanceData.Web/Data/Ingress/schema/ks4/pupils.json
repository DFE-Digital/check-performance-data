      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "x-csv": {
        "columns": {
          "default": "A"
        },
        "heading": "Surname"
      },
      "x-display": {
        "label": "Last name",
        "visible": true,
        "order": 0,
        "searchable": true
      }
    },
    "FORENAME": {
