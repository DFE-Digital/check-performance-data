      "questions": [
        {
          "id": "social-care-reason",
          "contentKey": true,
          "type": "Radio",
          "title": "What happened to {pupilName} that made it very hard for them to go to school or sit exams?",
          "hint": "Select one option",
          "options": [
            {
              "value": "social-care-situation",
              "label": "Social care situation"
            },
            {
              "value": "police-involvement",
              "label": "Police involvement"
            },
            {
              "value": "detained-in-prison",
              "label": "Detained in prison, remand centre, or secure unit for at least 4 months"
            }
          ]
        },
        {
          "id": "sat-exams",
          "type": "Radio",
          "title": "Has {pupilName} sat any exams as a year 11 pupil?",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        }
      ]
