@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.AdminLandingViewModel
@{
    ViewData["Title"] = "Administration";
}

@if (TempData["DangerZoneResult"] is string dangerZoneResult)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@dangerZoneResult</p>
        </div>
    </div>
}

<h1 class="govuk-heading-xl">Administration</h1>
<p class="govuk-body-l">
    Administrative tools for managing the Check Performance Data service.
</p>

@foreach (var group in Model.Groups)
{
    <section class="admin-nav-group govuk-!-margin-bottom-8"
             aria-labelledby="@($"group-{group.Key}")">
        <h2 id="@($"group-{group.Key}")" class="govuk-heading-l">@group.Title</h2>
        <p class="govuk-body">@group.Description</p>

        <ul class="govuk-list admin-nav-list">
            @foreach (var entry in group.Children)
            {
                <li class="admin-nav-list__item">
                    @if (entry.Enabled && entry.HttpMethod == "POST")
                    {
                        <form action="@entry.Url" method="post" class="admin-tile-form">
                            @Html.AntiForgeryToken()
                            <h3 class="govuk-heading-m">
                                <button type="submit" class="govuk-link admin-tile-form__link" data-prevent-double-click="true">@entry.Title</button>
                            </h3>
                        </form>
                        <p class="govuk-body">@entry.Description</p>
                    }
                    else if (entry.Enabled)
                    {
                        <h3 class="govuk-heading-m">
                            <a class="govuk-link" href="@entry.Url">@entry.Title</a>
                        </h3>
                        <p class="govuk-body">@entry.Description</p>
                    }
                    else
                    {
                        <h3 class="govuk-heading-m admin-nav-list__title--muted">
                            @entry.Title
                            <strong class="govuk-tag govuk-tag--grey admin-nav-list__tag">Coming soon</strong>
                        </h3>
                        <p class="govuk-body admin-nav-list__description--muted">@entry.Description</p>
                    }
                </li>
            }
        </ul>
    </section>
}
