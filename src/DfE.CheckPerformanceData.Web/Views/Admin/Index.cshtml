@using DfE.CheckPerformanceData.Web.Controllers.ViewModels
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.AdminLandingViewModel
@{
    ViewData["Title"] = "Administration";
}

@if (TempData["DangerZoneResult"] is string dangerZoneResult)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@dangerZoneResult</p>
        </div>
    </div>
}

<h1 class="govuk-heading-xl">Administration</h1>
<p class="govuk-body-l">
    Administrative tools for managing the Check Performance Data service.
</p>

@foreach (var group in Model.Roots)
{
    <section class="admin-nav-group govuk-!-margin-bottom-8"
             aria-labelledby="@($"group-{group.Entry.Key}")">
        <h2 id="@($"group-{group.Entry.Key}")" class="govuk-heading-l">@group.Entry.Title</h2>
        <p class="govuk-body">@group.Entry.Description</p>

        <ul class="govuk-list admin-nav-list">
            @foreach (var child in group.Children)
            {
                @await Html.PartialAsync("_AdminLandingTile", new AdminLandingNodePartialModel(child, 3))
            }
        </ul>
    </section>
}
