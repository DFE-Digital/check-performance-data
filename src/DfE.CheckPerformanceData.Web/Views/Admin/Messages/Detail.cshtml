@using System.Globalization
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.MessagesDetailViewModel
@{
    ViewData["Title"] = "Message";
    var m = Model.Message;
}

<a class="govuk-back-link" href="/admin/Messages/Inbox">Back to messages inbox</a>

<h1 class="govuk-heading-xl">Message</h1>

<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Submitted</dt>
        <dd class="govuk-summary-list__value">
            @m.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Session ID</dt>
        <dd class="govuk-summary-list__value">
            <code>@m.SessionId</code>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Email</dt>
        <dd class="govuk-summary-list__value">
            @if (string.IsNullOrWhiteSpace(m.Email))
            {
                <span class="govuk-hint govuk-!-margin-bottom-0">no reply address provided</span>
            }
            else
            {
                @m.Email
            }
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Status</dt>
        <dd class="govuk-summary-list__value">
            @if (m.IsRead)
            {
                <span class="govuk-tag govuk-tag--grey">Read</span>
                <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                    Marked read by <code>@m.ReadByAdminSub</code>
                    on @m.ReadAtUtc?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC.
                </p>
            }
            else
            {
                <span class="govuk-tag govuk-tag--blue">New</span>
            }
        </dd>
    </div>
</dl>

<h2 class="govuk-heading-m">What were you looking for?</h2>
<p class="govuk-body" style="white-space: pre-wrap">@m.WhatLookingFor</p>

<h2 class="govuk-heading-m">What did you actually get?</h2>
@if (string.IsNullOrWhiteSpace(m.WhatGot))
{
    <p class="govuk-hint">Not supplied.</p>
}
else
{
    <p class="govuk-body" style="white-space: pre-wrap">@m.WhatGot</p>
}

<div class="govuk-button-group govuk-!-margin-top-4">
    @if (!m.IsRead)
    {
        <form method="post" action="/admin/Messages/Inbox/@m.Id/MarkRead">
            @Html.AntiForgeryToken()
            <button class="govuk-button" data-module="govuk-button" type="submit">Mark as read</button>
        </form>
    }
    <a class="govuk-link" href="/admin/Search/Session/@m.SessionId">View this session's searches</a>
</div>
