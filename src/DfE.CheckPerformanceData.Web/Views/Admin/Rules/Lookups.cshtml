@using DfE.CheckPerformanceData.Web.Admin.Rules
@model LookupsViewModel
@{
    ViewData["Title"] = "Country languages";
}

<a href="/admin/rules" class="govuk-back-link">Back to rules configuration</a>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@success</p>
        </div>
    </div>
}

<h1 class="govuk-heading-xl">Country languages</h1>
<p class="govuk-body">
    Maps a country code to its official languages. Used by the "official language" rule condition.
</p>
<a role="button" draggable="false" class="govuk-button" data-module="govuk-button" href="/admin/rules/lookups/add">Add country</a>

@if (Model.IsEmpty)
{
    <p class="govuk-body">No country-language lookups have been published yet.</p>
}
else
{
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">Country languages</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Country name</th>
                <th scope="col" class="govuk-table__header">Country code</th>
                <th scope="col" class="govuk-table__header">Official languages</th>
                <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var row in Model.Rows)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@row.CountryName</td>
                    <td class="govuk-table__cell"><code>@row.CountryCode</code></td>
                    <td class="govuk-table__cell">@row.Languages</td>
                    <td class="govuk-table__cell">
                        <div class="rules-actions">
                            <a class="rules-action rules-action--edit" href="/admin/rules/lookups/@row.CountryCode/edit"
                               aria-label="Edit @row.CountryName" title="Edit">
                                <svg class="rules-action__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                </svg>
                            </a>
                            <form class="rules-actions__form" method="post" action="/admin/rules/lookups/@row.CountryCode/remove">
                                @Html.AntiForgeryToken()
                                <button class="rules-action rules-action--remove" type="submit"
                                        aria-label="Remove @row.CountryName" title="Remove">
                                    <svg class="rules-action__icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <circle cx="12" cy="12" r="11" fill="#d4351c" />
                                        <path d="M8 8l8 8M16 8l-8 8" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
