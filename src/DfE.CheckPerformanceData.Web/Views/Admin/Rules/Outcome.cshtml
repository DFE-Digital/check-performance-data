@using DfE.CheckPerformanceData.Application.RulesEngine
@using DfE.CheckPerformanceData.Web.Admin.Rules
@model OutcomeDetailViewModel
@{
    ViewData["Title"] = Model.Label;

    string TagClass(DecisionStatus s) => s switch
    {
        DecisionStatus.AutoApproved => "govuk-tag--green",
        DecisionStatus.AutoRejected => "govuk-tag--red",
        _ => "govuk-tag--yellow"
    };

    string TagText(DecisionStatus s) => s switch
    {
        DecisionStatus.AutoApproved => "Auto approved",
        DecisionStatus.AutoRejected => "Auto rejected",
        _ => "Scrutiny"
    };

    // Movable branches (the "Otherwise" branch has no actions). Used to disable Up on the first
    // movable branch and Down on the last. BranchViewModel has no index, so match by Id (Ids are
    // unique and used in the move/edit/remove routes).
    var movable = Model.Branches.Where(b => !b.IsOtherwise).ToList();
    var firstMovableId = movable.FirstOrDefault()?.Id;
    var lastMovableId = movable.LastOrDefault()?.Id;
}

<a href="/admin/rules/outcomes" class="govuk-back-link">Back to outcomes</a>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@success</p>
        </div>
    </div>
}

<span class="govuk-caption-xl">Decision outcome</span>
<h1 class="govuk-heading-xl">@Model.Label</h1>
<p class="govuk-body-s govuk-hint">Key: <code>@Model.Key</code></p>

<p class="govuk-body">
    Branches are evaluated top to bottom. The first branch whose condition is true decides the outcome.
</p>

<a class="govuk-button" data-module="govuk-button" href="/admin/rules/outcomes/@Model.Key/branches/add">Add branch</a>

@if (OutcomeDeletionPolicy.IsFormBound(Model.Key))
{
    <div class="govuk-inset-text">
        This outcome can't be deleted because the request form still routes to it. Remove it from the form
        mapping in code (<code>AnswerFieldMap</code>) before it can be deleted.
    </div>
}
else
{
    <p class="govuk-body"><a class="govuk-link" href="/admin/rules/outcomes/@Model.Key/delete">Delete this outcome</a></p>
}

@foreach (var branch in Model.Branches)
{
    <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
            <h2 class="govuk-summary-card__title">@branch.Id</h2>
            <ul class="govuk-summary-card__actions">
                <li class="govuk-summary-card__action">
                    <strong class="govuk-tag @TagClass(branch.Status)">@TagText(branch.Status)</strong>
                </li>
                @if (!branch.IsOtherwise)
                {
                    var isFirst = branch.Id == firstMovableId;
                    var isLast = branch.Id == lastMovableId;
                    <li class="govuk-summary-card__action">
                        <a class="rules-action rules-action--edit"
                           href="/admin/rules/outcomes/@Model.Key/branches/@branch.Id/edit"
                           aria-label="Edit branch @branch.Id" title="Edit">
                            <svg class="rules-action__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                            </svg>
                        </a>
                    </li>
                    <li class="govuk-summary-card__action">
                        <form class="rules-actions__form" method="post" action="/admin/rules/outcomes/@Model.Key/branches/@branch.Id/move">
                            @Html.AntiForgeryToken()
                            <button class="rules-action rules-action--move" name="direction" value="up" type="submit"
                                    aria-label="Move branch @branch.Id up" title="@(isFirst ? null : "Move up")" disabled="@isFirst">
                                <svg class="rules-action__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M12 19V5M12 5l-6 6M12 5l6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </form>
                    </li>
                    <li class="govuk-summary-card__action">
                        <form class="rules-actions__form" method="post" action="/admin/rules/outcomes/@Model.Key/branches/@branch.Id/move">
                            @Html.AntiForgeryToken()
                            <button class="rules-action rules-action--move" name="direction" value="down" type="submit"
                                    aria-label="Move branch @branch.Id down" title="@(isLast ? null : "Move down")" disabled="@isLast">
                                <svg class="rules-action__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M12 5v14M12 19l-6-6M12 19l6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </form>
                    </li>
                    <li class="govuk-summary-card__action">
                        <a class="rules-action rules-action--remove"
                           href="/admin/rules/outcomes/@Model.Key/branches/@branch.Id/remove"
                           aria-label="Remove branch @branch.Id" title="Remove">
                            <svg class="rules-action__icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <circle cx="12" cy="12" r="11" fill="#d4351c" />
                                <path d="M8 8l8 8M16 8l-8 8" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="govuk-summary-card__content">
            <h3 class="govuk-heading-s govuk-!-margin-bottom-1">When</h3>
            <ul class="govuk-list govuk-list--bullet">
                @await Html.PartialAsync("~/Views/Admin/Rules/_PredicateNode.cshtml", branch.Condition)
            </ul>
        </div>
    </div>
}
