@using DfE.CheckPerformanceData.Web.Admin.Rules
@model RulesUploadViewModel
@{
    ViewData["Title"] = Model.Title;
}

<a href="/admin/rules" class="govuk-back-link">Back to rules configuration</a>

@if (Model.Errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in Model.Errors) { <li>@error</li> }
                </ul>
            </div>
        </div>
    </div>
}

<h1 class="govuk-heading-xl">@Model.Title</h1>

<p class="govuk-body">
    Upload a <code>@Model.FileName</code> file to publish it as the live configuration. This creates the
    first saved version. The rules engine worker reloads the published configuration about every 5 minutes.
</p>

<div class="govuk-inset-text">
    Upload is only available while this configuration is empty. Once it holds data, edit it through the
    rules pages instead.
</div>

<form method="post" enctype="multipart/form-data" action="/admin/rules/upload/@Model.Type">
    @Html.AntiForgeryToken()
    <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="file">Select the JSON file</label>
        <div id="file-hint" class="govuk-hint">The file must be a valid <code>@Model.FileName</code>.</div>
        <input class="govuk-file-upload" id="file" name="file" type="file"
               accept=".json,application/json" aria-describedby="file-hint" />
    </div>
    <div class="govuk-button-group">
        <button class="govuk-button" data-module="govuk-button" type="submit">Upload</button>
        <a class="govuk-link" href="/admin/rules">Cancel</a>
    </div>
</form>
