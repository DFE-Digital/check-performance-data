@using System.Globalization
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SearchSessionDrillInViewModel
@{
    ViewData["Title"] = "Session " + Model.ShortSessionId;
    var purgeModalId = "session-purge-modal";
}

<a class="govuk-back-link" href="/admin/Search/">Back to search analytics</a>

<h1 class="govuk-heading-xl">Session @Model.ShortSessionId</h1>

<p class="govuk-body-s">
    <code>@Model.SessionId</code>
</p>

<h2 class="govuk-heading-l">Searches in this session</h2>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">When (UTC)</th>
            <th scope="col" class="govuk-table__header">Query</th>
            <th scope="col" class="govuk-table__header">Scope</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Results</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Latency (ms)</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var e in Model.Events)
        {
            var queryText = !string.IsNullOrEmpty(e.QueryRaw)
                ? e.QueryRaw
                : (e.QueryNormalised ?? string.Empty);
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    @e.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                </td>
                <td class="govuk-table__cell">
                    @if (!string.IsNullOrEmpty(queryText))
                    {
                        <a class="govuk-link" href="/search?q=@Uri.EscapeDataString(queryText)"
                           target="_blank" rel="noopener noreferrer">@queryText</a>
                    }
                </td>
                <td class="govuk-table__cell">@(e.Scope ?? string.Empty)</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@e.ResultsTotal</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@e.LatencyMs</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="govuk-heading-l">Related messages</h2>

@if (Model.Messages.Count == 0)
{
    <p class="govuk-body">No feedback messages were submitted from this session.</p>
}
else
{
    <ul class="govuk-list govuk-list--bullet">
        @foreach (var msg in Model.Messages)
        {
            <li>
                <a class="govuk-link" href="/admin/Messages/Inbox/@msg.Id">
                    @msg.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC —
                    @msg.FirstLinePreview
                </a>
            </li>
        }
    </ul>
}

<div class="govuk-form-group govuk-!-margin-top-8">
    <h2 class="govuk-heading-l">Delete this session's data</h2>
    <p class="govuk-body">
        Permanently deletes every search event and support message from session
        @Model.ShortSessionId. This cannot be undone.
    </p>

    <button type="button" class="govuk-button govuk-button--warning"
            data-confirm-trigger="@purgeModalId" aria-haspopup="dialog"
            aria-controls="@purgeModalId" data-module="govuk-button">
        Delete this session's data
    </button>

    <govuk-confirm-modal id="@purgeModalId"
                         title="Delete this session's data?"
                         warning-text="This permanently deletes every search event and support message from this session. This cannot be undone."
                         body="Session @Model.ShortSessionId will be removed from the search analytics and messages inbox."
                         confirm-label="Yes, delete this session's data"
                         destructive="true"
                         form-action="/admin/Search/Session/@Model.SessionId/Delete"
                         form-method="post">
        @Html.AntiForgeryToken()
    </govuk-confirm-modal>
</div>
