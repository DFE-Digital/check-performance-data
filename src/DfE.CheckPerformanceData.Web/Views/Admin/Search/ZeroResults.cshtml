@using System.Globalization
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SearchAnalyticsQueryDrillInViewModel
@{
    ViewData["Title"] = "Zero-result queries";
    var rangeQs = "range=" + Uri.EscapeDataString(Model.RangeKey);
    string PageLink(int p) => $"/admin/Search/ZeroResults?{rangeQs}&page={p}";
    const string tableId = "sa-zero-results-table";
    var firstRow = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastRow = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

<link rel="stylesheet" href="~/css/search-analytics.css" asp-append-version="true" />

<a class="govuk-back-link" href="/admin/Search/?@rangeQs">Back to search analytics</a>

<h1 class="govuk-heading-xl">Zero-result queries</h1>
<p class="govuk-body">
    Queries that returned no results in the selected window &mdash; the &ldquo;write this content next&rdquo; list.
</p>

@if (Model.TotalCount == 0)
{
    <p class="govuk-body">No zero-result queries recorded in this window.</p>
}
else
{
    <p class="govuk-body-s govuk-hint">
        Showing @firstRow to @lastRow of @Model.TotalCount quer@(Model.TotalCount == 1 ? "y" : "ies").
    </p>

    <div class="govuk-form-group">
        <label class="govuk-label" for="sa-zero-results-filter">Filter loaded rows</label>
        <div class="govuk-hint">Instant filter, no server round-trip.</div>
        <input class="govuk-input sa-filter-input" id="sa-zero-results-filter"
               type="search" data-filter-target="@tableId" autocomplete="off" />
    </div>

    <table class="govuk-table" id="@tableId">
        <caption class="govuk-table__caption govuk-table__caption--s govuk-visually-hidden">Zero-result queries</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header" title="The normalised search term users typed. Grouped so 'Widget' and 'widget' count together.">Query</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric" title="How many times this query was fired in the selected window (all of which returned no results).">Zero-result count</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var row in Model.Rows)
            {
                <tr class="govuk-table__row" data-filter-key="@row.QueryNormalised">
                    <td class="govuk-table__cell">
                        <a class="govuk-link" href="/search?q=@Uri.EscapeDataString(row.QueryNormalised)"
                           target="_blank" rel="noopener noreferrer">@row.QueryNormalised</a>
                    </td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@row.Count.ToString("N0", CultureInfo.CurrentCulture)</td>
                </tr>
            }
        </tbody>
    </table>

    @await Component.InvokeAsync("Pager", new
    {
        currentPage = Model.Page,
        totalPages = Model.TotalPages,
        urlBuilder = (Func<int, string>)PageLink,
    })
}

@section Scripts {
    <script src="~/js/search-analytics.js" asp-append-version="true"></script>
}
