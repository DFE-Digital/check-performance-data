@using System.Globalization
@using DfE.CheckPerformanceData.Application.Analytics
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SingleSeriesChartModel
@{
    // Single-series line chart, server-rendered inline SVG. Used for tiles 2/3
    // (unique users / zero-result count). Same layout + axis conventions as
    // _VolumeChart.cshtml; only one line and one Y-axis. No client-side chart library.
    var buckets = Model?.Series ?? Array.Empty<VolumeBucket>();
    var title = Model?.Title ?? string.Empty;
    var yAxisLabel = Model?.YAxisLabel ?? string.Empty;
    var seriesColour = Model?.SeriesColour ?? "#1d70b8";
    var valueUnit = Model?.ValueUnit ?? string.Empty;

    const int width = 700;
    const int height = 260;
    const int padLeft = 56;
    const int padBottom = 44;
    const int padTop = 20;
    const int padRight = 20;

    var plotW = width - padLeft - padRight;
    var plotH = height - padTop - padBottom;

    var maxValue = buckets.Count == 0 ? 0 : buckets.Max(b => b.SearchCount);
    var safeMax = maxValue == 0 ? 1 : maxValue;

    string X(int index) => buckets.Count <= 1
        ? (padLeft + plotW / 2).ToString(CultureInfo.InvariantCulture)
        : (padLeft + (plotW * (double)index / (buckets.Count - 1))).ToString("0.##", CultureInfo.InvariantCulture);

    string Y(int count) =>
        (padTop + plotH - (plotH * (double)count / safeMax)).ToString("0.##", CultureInfo.InvariantCulture);

    var pointsString = string.Join(" ", buckets.Select((b, i) => $"{X(i)},{Y(b.SearchCount)}"));

    var ariaLabel = buckets.Count == 0
        ? $"{title}: no data."
        : $"{title}: peak {maxValue}{valueUnit}, {buckets[^1].SearchCount}{valueUnit} in the most recent bucket.";

    var xTicks = ChartAxisTicks.XAxisTicks(
        buckets.Select(b => b.BucketStart).ToArray(),
        plotWidthPx: plotW);
    var yFractions = ChartAxisTicks.YAxisFractions(maxValue);
}

@if (buckets.Count == 0)
{
    <p class="govuk-body">No data to chart for this window.</p>
}
else
{
    <ul class="sa-chart__legend">
        <li class="sa-chart__legend-item">
            <span class="sa-chart__legend-glyph--circle" aria-hidden="true"
                  style="background:@seriesColour"></span>
            <span class="govuk-body-s">@yAxisLabel</span>
        </li>
    </ul>

    var bucketIsoJson = "[" + string.Join(",", buckets.Select(b => "\"" + b.BucketStart.ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture) + "\"")) + "]";
    var seriesValuesJson = "[" + string.Join(",", buckets.Select(b => b.SearchCount.ToString(CultureInfo.InvariantCulture))) + "]";
    var valueSuffix = " " + (yAxisLabel ?? string.Empty).ToLowerInvariant();
    <svg class="sa-chart" viewBox="0 0 @width @height" role="img"
         aria-label="@ariaLabel" focusable="false"
         data-sa-crosshair="true"
         data-sa-plot-left="@padLeft"
         data-sa-plot-top="@padTop"
         data-sa-plot-width="@plotW"
         data-sa-plot-height="@plotH"
         data-sa-buckets="@bucketIsoJson"
         data-sa-values="@seriesValuesJson"
         data-sa-value-suffix="@valueSuffix">
        <title>@title</title>

        <line x1="@padLeft" y1="@padTop" x2="@padLeft" y2="@(padTop + plotH)"
              stroke="#b1b4b6" stroke-width="1" aria-hidden="true" />
        <line x1="@padLeft" y1="@(padTop + plotH)" x2="@(padLeft + plotW)" y2="@(padTop + plotH)"
              stroke="#b1b4b6" stroke-width="1" aria-hidden="true" />

        @foreach (var fraction in yFractions)
        {
            var y = padTop + plotH - (plotH * fraction);
            var yStr = y.ToString("0.##", CultureInfo.InvariantCulture);
            var yTextStr = (y + 4).ToString("0.##", CultureInfo.InvariantCulture);
            <line x1="@padLeft" y1="@yStr" x2="@(padLeft + plotW)" y2="@yStr"
                  stroke="#f3f2f1" stroke-width="1" aria-hidden="true" />
            @Html.Raw($"<text class=\"sa-chart__axis-tick\" x=\"{padLeft - 6}\" y=\"{yTextStr}\" text-anchor=\"end\" fill=\"{System.Net.WebUtility.HtmlEncode(seriesColour)}\" font-size=\"11\">{ChartAxisTicks.YAxisLabel(fraction, maxValue)}</text>")
        }

        @foreach (var tick in xTicks)
        {
            var xPos = X(tick.Index);
            <line x1="@xPos" y1="@(padTop + plotH)" x2="@xPos"
                  y2="@(padTop + plotH + 4)" stroke="#b1b4b6" stroke-width="1" aria-hidden="true" />
            @Html.Raw($"<text class=\"sa-chart__axis-tick\" x=\"{xPos}\" y=\"{padTop + plotH + 18}\" text-anchor=\"middle\" fill=\"#505a5f\" font-size=\"11\">{System.Net.WebUtility.HtmlEncode(tick.Label)}</text>")
        }

        @Html.Raw($"<text class=\"sa-chart__axis-title\" x=\"{padLeft - 6}\" y=\"{padTop - 6}\" text-anchor=\"end\" fill=\"{System.Net.WebUtility.HtmlEncode(seriesColour)}\" font-size=\"10\">{System.Net.WebUtility.HtmlEncode(yAxisLabel)}</text>")
        <text class="sa-chart__axis-title" x="@(padLeft + plotW / 2)" y="@(height - 4)" text-anchor="middle" fill="#505a5f" font-size="10">Time (UTC)</text>

        @Html.Raw($"<polyline fill=\"none\" stroke=\"{System.Net.WebUtility.HtmlEncode(seriesColour)}\" stroke-width=\"2\" points=\"{pointsString}\" aria-hidden=\"true\" />")

        @for (var i = 0; i < buckets.Count; i++)
        {
            @Html.Raw($"<circle cx=\"{X(i)}\" cy=\"{Y(buckets[i].SearchCount)}\" r=\"3\" fill=\"{System.Net.WebUtility.HtmlEncode(seriesColour)}\" aria-hidden=\"true\" />")
        }
    </svg>

    @* Same cap-and-link rule as the volume chart's inline fallback: keep the DOM tight for
       admins on the landing page; the drill-in shows the full paged series. *@
    var inlineCapRaw = ViewContext.ViewData["sa-inline-row-cap"] as int?;
    var inlineCap = inlineCapRaw is { } capValue && capValue > 0 ? capValue : 20;
    var drillInUrl = Model?.DrillInUrl;
    var displayedBuckets = buckets.Count > inlineCap ? buckets.Take(inlineCap).ToList() : (IReadOnlyList<VolumeBucket>)buckets;
    var valueColHeaderTitle = string.Equals(yAxisLabel, "Unique sessions", StringComparison.OrdinalIgnoreCase)
        ? "How many distinct browser sessions searched in that bucket."
        : (string.Equals(yAxisLabel, "Zero-result searches", StringComparison.OrdinalIgnoreCase)
            ? "How many searches in that bucket returned nothing."
            : yAxisLabel);
    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">View @((yAxisLabel ?? string.Empty).ToLowerInvariant()) data table</span>
        </summary>
        <div class="govuk-details__text">
            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-table__caption--s">@title</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header" title="Start of the time bucket. Bucket width follows the Chart bucket size selector above.">Bucket (UTC)</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric" title="@valueColHeaderTitle">@yAxisLabel</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var bucket in displayedBuckets)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@bucket.BucketStart.ToString("u")</td>
                            <td class="govuk-table__cell govuk-table__cell--numeric">@bucket.SearchCount.ToString("N0", CultureInfo.CurrentCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (buckets.Count > inlineCap && !string.IsNullOrEmpty(drillInUrl))
            {
                <p class="govuk-body">
                    Showing the first @displayedBuckets.Count of @buckets.Count.ToString("N0", CultureInfo.CurrentCulture) buckets.
                    <a class="govuk-link" href="@drillInUrl">@Model!.DrillInLinkText &rarr;</a>
                </p>
            }
        </div>
    </details>
}
