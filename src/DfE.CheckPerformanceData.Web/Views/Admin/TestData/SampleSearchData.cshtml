@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SeedSampleSearchDataViewModel
@{
    ViewData["Title"] = "Seed sample search data";
    var progressUrl = "/admin/test-data/sample-search-data/progress";
    var cancelUrlBase = "/admin/test-data/sample-search-data/";
    var dashboardUrl = "/admin/Search/";
    var activeJobId = Model.ActiveJobId?.ToString();
}

<a class="govuk-back-link" href="/admin">Back to administration</a>

<h1 class="govuk-heading-xl">Seed sample search data</h1>

@if (!string.IsNullOrEmpty(Model.SuccessBanner))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="seed-search-banner-title" data-module="govuk-notification-banner"
         data-testid="seed-sample-search-data-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="seed-search-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
                @Model.SuccessBanner
                <a class="govuk-notification-banner__link" href="@dashboardUrl">View the analytics dashboard</a>.
            </p>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body-l">
            Generate a plausible mix of search events and feedback messages spanning a chosen
            time window so the search-analytics dashboard has demo content.
        </p>
        <p class="govuk-body">
            Rows written by this tool are indistinguishable from real search activity — they
            appear on the analytics dashboard, in the admin messages inbox, and in the
            top-queries tables. The retention job eventually purges seeded rows alongside real
            events (per the 90-day search-events window and 365-day search-messages window).
        </p>
        <p class="govuk-body">
            This page is available only in the local development environment; the endpoint
            returns 404 in Test and Production.
        </p>

        <form method="post" action="/admin/test-data/sample-search-data"
              id="seed-sample-search-data-form"
              data-testid="seed-sample-search-data-form"
              data-progress-url="@progressUrl"
              data-cancel-url-base="@cancelUrlBase"
              data-dashboard-url="@dashboardUrl"
              data-resume-job-id="@activeJobId">
            @Html.AntiForgeryToken()

            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                    <h2 class="govuk-fieldset__heading">Time span preset</h2>
                </legend>
                <div class="govuk-hint">
                    Presets set both the window width and a plausible default row count. Pick
                    the shortest window that gives the dashboard enough data for what you are
                    demoing.
                </div>
                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="preset-24h" name="preset"
                               type="radio" value="24h" checked
                               aria-describedby="preset-24h-hint" />
                        <label class="govuk-label govuk-radios__label" for="preset-24h">
                            Last 24 hours
                        </label>
                        <div id="preset-24h-hint" class="govuk-hint govuk-radios__hint">
                            About 500 events, spread with a working-hours weighting.
                        </div>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="preset-week" name="preset"
                               type="radio" value="week"
                               aria-describedby="preset-week-hint" />
                        <label class="govuk-label govuk-radios__label" for="preset-week">
                            Last week
                        </label>
                        <div id="preset-week-hint" class="govuk-hint govuk-radios__hint">
                            About 2,000 events over the last 7 days.
                        </div>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="preset-month" name="preset"
                               type="radio" value="month"
                               aria-describedby="preset-month-hint" />
                        <label class="govuk-label govuk-radios__label" for="preset-month">
                            Last month
                        </label>
                        <div id="preset-month-hint" class="govuk-hint govuk-radios__hint">
                            About 8,000 events over the last 30 days.
                        </div>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="preset-quarter" name="preset"
                               type="radio" value="quarter"
                               aria-describedby="preset-quarter-hint" />
                        <label class="govuk-label govuk-radios__label" for="preset-quarter">
                            Last quarter
                        </label>
                        <div id="preset-quarter-hint" class="govuk-hint govuk-radios__hint">
                            About 25,000 events over the last 90 days.
                        </div>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="preset-year" name="preset"
                               type="radio" value="year"
                               aria-describedby="preset-year-hint" />
                        <label class="govuk-label govuk-radios__label" for="preset-year">
                            Last year
                        </label>
                        <div id="preset-year-hint" class="govuk-hint govuk-radios__hint">
                            About 80,000 events over the last 365 days. Takes a few seconds.
                        </div>
                    </div>
                </div>
            </fieldset>

            <details class="govuk-details" data-module="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">Advanced — override the row counts</span>
                </summary>
                <div class="govuk-details__text">
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="eventCount">Events to seed</label>
                        <div class="govuk-hint">Leave blank to use the preset default.</div>
                        <input class="govuk-input govuk-input--width-5" id="eventCount"
                               name="eventCount" type="number" min="1" max="200000"
                               inputmode="numeric" />
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="messageCount">Feedback messages to seed</label>
                        <div class="govuk-hint">Leave blank to use ~8% of the events count.</div>
                        <input class="govuk-input govuk-input--width-5" id="messageCount"
                               name="messageCount" type="number" min="0" max="20000"
                               inputmode="numeric" />
                    </div>
                </div>
            </details>

            <button type="submit" class="govuk-button" data-module="govuk-button"
                    id="seed-sample-search-data-submit"
                    data-testid="seed-sample-search-data-submit"
                    data-idle-label="Seed data" data-busy-label="Seeding…">
                Seed data
            </button>
        </form>

        <p class="govuk-body-s govuk-hint">
            Existing search data is not deleted — click multiple times to accumulate more.
            To clear the sink, use the Danger zone tools.
        </p>
    </div>
</div>

@* Progress modal for the seed run. Opens as soon as the form is submitted; polls the
   in-memory job store every 500 ms; transitions to a Completed / Failed / Cancelled
   state once the background task finishes. The dialog is a native <dialog> element
   opened via .showModal() — same pattern as the govuk-confirm-modal tag helper, with
   its own semantic id + testid so E2E tests can target it precisely. *@
<dialog id="seed-progress-modal"
        class="govuk-modal-dialogue__box seed-progress-modal"
        aria-labelledby="seed-progress-modal-title"
        aria-describedby="seed-progress-modal-body"
        aria-modal="true"
        tabindex="-1"
        data-testid="seed-progress-modal">
    <div class="govuk-modal-dialogue__header">
        <button type="button" class="govuk-modal-dialogue__close" aria-label="close"
                data-element="govuk-modal-dialogue-close" data-modal-close>&times;</button>
    </div>
    <div class="govuk-modal-dialogue__content">
        <h2 class="govuk-modal-dialogue__heading govuk-heading-l"
            id="seed-progress-modal-title">Seeding sample search data</h2>

        <div id="seed-progress-modal-body" class="govuk-body">
            <p class="govuk-body">
                <strong>Preset:</strong>
                <span data-role="preset-label" data-testid="seed-progress-preset">…</span>
            </p>

            <p class="govuk-body" data-role="status-line">
                Seeded <strong data-role="events-written" data-testid="seed-progress-events">0</strong>
                of ~<span data-role="events-total">0</span> search events.
            </p>

            <p class="govuk-body" data-role="cursor-line" hidden>
                Currently at:
                <span data-role="current-cursor" data-testid="seed-progress-cursor">—</span> UTC.
            </p>

            <p class="govuk-body" data-role="eta-line" hidden>
                About <span data-role="eta-seconds">…</span> seconds remaining.
            </p>

            @* Progress bar. Fill width is set via inline style from JS; percentage text is
               painted below for screen-reader / non-JS-degraded users. *@
            <div class="seed-progress-bar" role="progressbar"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="0" data-role="progress-bar">
                <div class="seed-progress-bar__fill" data-role="progress-fill"
                     style="width: 0%;"></div>
            </div>
            <p class="govuk-hint" data-role="progress-percent-line">
                <span data-role="progress-percent">0</span>% complete
            </p>

            @* Rolling log of the last few progress ticks. Kept short (5 entries) so the
               modal does not scroll on a long seed. *@
            <details class="govuk-details" data-module="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">Recent progress log</span>
                </summary>
                <div class="govuk-details__text">
                    <ul class="seed-progress-log" data-role="progress-log">
                        <li class="seed-progress-log__empty">Waiting for the first tick…</li>
                    </ul>
                </div>
            </details>

            @* Success block — hidden until the state transitions to Completed. *@
            <div class="seed-progress-modal__result" data-role="result-completed" hidden>
                <p class="govuk-body govuk-!-font-weight-bold" data-testid="seed-progress-completed">
                    Seeded <span data-role="final-events">0</span> events and
                    <span data-role="final-messages">0</span> feedback messages
                    spanning <span data-role="final-preset">…</span>.
                </p>
                <p class="govuk-body">
                    <a class="govuk-link" href="@dashboardUrl">View dashboard →</a>
                </p>
            </div>

            @* Failure block — hidden until Failed. *@
            <div class="seed-progress-modal__result" data-role="result-failed" hidden>
                <p class="govuk-body govuk-error-message" data-testid="seed-progress-failed">
                    <span data-role="error-message">Seeding failed.</span>
                </p>
                <p class="govuk-body">
                    <button type="button" class="govuk-button govuk-button--secondary"
                            data-role="retry-button">Retry</button>
                </p>
            </div>

            @* Cancelled block — hidden until Completed with a Cancelled note. *@
            <div class="seed-progress-modal__result" data-role="result-cancelled" hidden>
                <p class="govuk-body" data-testid="seed-progress-cancelled">
                    <span data-role="cancelled-note">Seed cancelled.</span>
                </p>
            </div>
        </div>

        <div class="govuk-button-group">
            <button type="button" class="govuk-button govuk-button--warning"
                    data-role="cancel-button"
                    data-testid="seed-progress-cancel">Cancel seeding</button>
            <button type="button" class="govuk-button govuk-button--secondary"
                    data-role="close-button"
                    data-testid="seed-progress-close">
                Close (keep seeding in background)
            </button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/test-data-seed.js" asp-append-version="true" defer></script>
}
