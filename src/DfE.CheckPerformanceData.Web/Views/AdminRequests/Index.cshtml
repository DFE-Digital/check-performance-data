@using DfE.CheckPerformanceData.Application.RulesEngine
@using DfE.CheckPerformanceData.Application.AdminRequests
@using DfE.CheckPerformanceData.Domain.Enums
@using DfE.CheckPerformanceData.Web.Controllers.WindowAdmin
@model WindowRequestsResult
@{
    // Matches the <h1> below, which names the window this page is scoped to.
    ViewData["Title"] = $"Requests for {Model.WindowTitle}";

    string TagClass(DecisionStatus s) => s switch
    {
        DecisionStatus.AutoApproved => "govuk-tag--green",
        DecisionStatus.AutoRejected => "govuk-tag--red",
        _ => "govuk-tag--yellow"
    };

    string TagText(DecisionStatus s) => s switch
    {
        DecisionStatus.AutoApproved => "Auto approved",
        DecisionStatus.AutoRejected => "Auto rejected",
        _ => "Scrutiny"
    };

    // Must track the header count below: the trace detail row spans the whole table.
    const int ColumnCount = 11;
}

<a href="/admin/windows" class="govuk-back-link">Back to windows</a>

<h1 class="govuk-heading-xl">Requests for @Model.WindowTitle</h1>

@if (Model.Exercises.Count > 0)
{
    <form method="get" action="/admin/windows/requests" class="govuk-!-margin-bottom-6">
        <input type="hidden" name="windowId" value="@Model.WindowId" />
        <div class="govuk-form-group govuk-!-margin-bottom-3">
            <label class="govuk-label" for="exercise">Checking exercise</label>
            <select class="govuk-select" id="exercise" name="exercise">
                <option value="" selected="@(Model.SelectedExercise is null)">All exercises</option>
                @foreach (CheckingExerciseType exercise in Model.Exercises)
                {
                    <option value="@exercise" selected="@(Model.SelectedExercise == exercise)">
                        @ExerciseLabels.For(exercise)
                    </option>
                }
            </select>
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
            Apply filter
        </button>
    </form>
}

@* Disabled for now: the close-window replay has no action behind it while the close-window
   story is outstanding. Rendered rather than removed so its place on the page is kept, and
   aria-disabled carries the state to a screen reader as well as to the pointer. *@
<div class="govuk-!-margin-bottom-6">
    <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button"
            disabled aria-disabled="true" aria-describedby="close-window-hint">
        Process "Close Window"
    </button>
    <p class="govuk-hint" id="close-window-hint">This action is turned off.</p>
</div>

@if (Model.Rows.Count == 0)
{
    <p class="govuk-body">
        @(Model.SelectedExercise is { } selected
            ? $"There are no requests for {ExerciseLabels.For(selected)} in this window."
            : "There are no requests for this window.")
    </p>
}
else
{
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">
            Requests for @Model.WindowTitle
        </caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Reference</th>
                <th scope="col" class="govuk-table__header">Organisation URN</th>
                <th scope="col" class="govuk-table__header">Pupil</th>
                <th scope="col" class="govuk-table__header">Request type</th>
                <th scope="col" class="govuk-table__header">Checking exercise</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Submitted by</th>
                <th scope="col" class="govuk-table__header">Submitted</th>
                <th scope="col" class="govuk-table__header">Outcome</th>
                <th scope="col" class="govuk-table__header">Matched Rule</th>
                <th scope="col" class="govuk-table__header">Zendesk Id</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var row in Model.Rows)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@row.ReferenceNumber</td>
                    <td class="govuk-table__cell">@row.OrganisationUrn</td>
                    <td class="govuk-table__cell">@($"{row.PupilFirstname} {row.PupilSurname}".Trim())</td>
                    <td class="govuk-table__cell">@row.RequestTypeDescription</td>
                    <td class="govuk-table__cell">
                        @if (row.Exercise is { } rowExercise)
                        {
                            @ExerciseLabels.For(rowExercise)
                        }
                        else
                        {
                            <span class="govuk-hint govuk-!-margin-0">Not recorded</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@row.Status</td>
                    <td class="govuk-table__cell">@row.SubmittedByName</td>
                    <td class="govuk-table__cell">@row.Submitted.ToString("dd MMM yyyy HH:mm")</td>
                    <td class="govuk-table__cell">
                        @if (row.Outcome is { } outcome)
                        {
                            <strong class="govuk-tag @TagClass(outcome)">@TagText(outcome)</strong>
                        }
                        else
                        {
                            <span class="govuk-hint govuk-!-margin-0">Not yet processed</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@(row.MatchedRule ?? "—")</td>
                    <td class="govuk-table__cell">@(row.CrmId ?? "—")</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(row.DecisionTrace))
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell decision-trace__cell" colspan="@ColumnCount">
                            <details class="govuk-details govuk-!-margin-bottom-0" data-module="govuk-details">
                                <summary class="govuk-details__summary">
                                    <span class="govuk-details__summary-text">
                                        Decision trace for @row.ReferenceNumber
                                    </span>
                                </summary>
                                <div class="govuk-details__text decision-trace__scroll">
                                    <pre class="decision-trace__lines">@row.DecisionTrace</pre>
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
