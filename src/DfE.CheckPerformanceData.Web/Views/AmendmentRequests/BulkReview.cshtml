@model DfE.CheckPerformanceData.Web.Controllers.AmendmentRequests.BulkReviewViewModel

@{
    ViewBag.Title = "Review requests to submit";
    Layout = "_Layout";
}

<a class="govuk-back-link" href="@Url.Action("Index", "AmendmentRequests", new { windowId = Model.WindowId })">Back</a>

<span class="govuk-caption-l">Amendment requests</span>
<h1 class="govuk-heading-xl">Review requests to submit</h1>

@if (Model.Duplicates.Count > 0)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            The following requests will not be submitted because there is a duplicate for the pupil.
        </strong>
    </div>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Pupil name</th>
                <th scope="col" class="govuk-table__header">Request type</th>
                <th scope="col" class="govuk-table__header">Reason</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var item in Model.Duplicates)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@item.PupilName</td>
                    <td class="govuk-table__cell">@item.RequestTypeDescription</td>
                    <td class="govuk-table__cell">@item.DuplicateReason</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Submittable.Count == 0)
{
    <div class="govuk-inset-text">
        <p class="govuk-body">None of the selected requests can be submitted. Resolve the duplicates above and try again.</p>
    </div>
    <a class="govuk-button govuk-button--secondary" href="@Url.Action("Index", "AmendmentRequests", new { windowId = Model.WindowId })">Return to requests</a>
}
else
{
    <h2 class="govuk-heading-m">Requests to submit</h2>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Pupil name</th>
                <th scope="col" class="govuk-table__header">Request type</th>
                <th scope="col" class="govuk-table__header">Action</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var item in Model.Submittable)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@item.PupilName</td>
                    <td class="govuk-table__cell">@item.RequestTypeDescription</td>
                    <td class="govuk-table__cell"><a class="govuk-link" href="@Url.Action("Edit", "AmendmentRequests", new { windowId = Model.WindowId, referenceNumber = item.ReferenceNumber, fromBulk = true })">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>

    <form method="post" action="@Url.Action("BulkSubmit", "AmendmentRequests", new { windowId = Model.WindowId })">
        @Html.AntiForgeryToken()
        @foreach (var item in Model.Submittable)
        {
            <input type="hidden" name="references" value="@item.ReferenceNumber" />
        }
        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Submit requests</button>
            <a class="govuk-link" href="@Url.Action("Index", "AmendmentRequests", new { windowId = Model.WindowId })">Save and continue later</a>
        </div>
    </form>
}
