@using DfE.CheckPerformanceData.Domain.Enums
@model DfE.CheckPerformanceData.Web.Controllers.AmendmentRequests.AmendmentRequestsViewModel

@{
    ViewBag.Title = "Amendment request summary";
    Layout = "_Layout";
}

<a class="govuk-back-link" href="@Url.Action("Index", "CheckYourPupilData", new { windowId = Model.WindowId })">Back</a>

@if (TempData["DeletedMessage"] is string deletedMessage)
{
    <div class="govuk-notification-banner govuk-notification-banner--success"
         role="alert"
         aria-labelledby="deleted-banner-title"
         data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="deleted-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@deletedMessage</p>
        </div>
    </div>
}

<span class="govuk-caption-l">Amendment requests</span>
<h1 class="govuk-heading-xl">Amendment request summary</h1>

<div class="govuk-inset-text">
    <p class="govuk-body">Submit all @Model.WindowTitle requests by <strong>@Model.DeadlineText</strong></p>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="govuk-inset-text">
        <p class="govuk-body">You have no amendment requests for this window.</p>
    </div>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Pupil</th>
                <th scope="col" class="govuk-table__header">Request type</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Action</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var row in Model.Rows)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@row.PupilName</td>
                    <td class="govuk-table__cell">@row.RequestTypeDescription</td>
                    <td class="govuk-table__cell">
                        <strong class="govuk-tag @row.TagClass">@row.TagLabel</strong>
                    </td>
                    <td class="govuk-table__cell">
                        @{
                            var draftDeleteAction = row.RequestType == RequestType.ConfirmCorrect ? "ConfirmDeleteConfirmation" : "ConfirmDelete";
                        }
                        <a class="govuk-link govuk-!-margin-right-2" href="@Url.Action("Edit", "AmendmentRequests", new { windowId = Model.WindowId, referenceNumber = row.ReferenceNumber })">Edit</a>
                        <a class="govuk-link" href="@Url.Action(draftDeleteAction, "SubmittedRequest", new { windowId = Model.WindowId, referenceNumber = row.ReferenceNumber })">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="govuk-button govuk-button--secondary" href="@Url.Action("Index", "WhatToChange", new { windowId = Model.WindowId })">Raise a new request</a>

<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

<h2 class="govuk-heading-m">Summary of recent requests, decisions and issues</h2>

<govuk-tabs>
    <govuk-tabs-item id="requests" label="Requests">
        <div class="govuk-inset-text">
            <p class="govuk-body">You can edit your @Model.WindowTitle requests any time before <strong>@Model.DeadlineText</strong></p>
        </div>
        @if (Model.SubmittedRows.Count == 0)
        {
            <div class="govuk-inset-text">
                <p class="govuk-body">You have no submitted requests for this window.</p>
            </div>
        }
        else
        {
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Pupil name</th>
                        <th scope="col" class="govuk-table__header">Reference number</th>
                        <th scope="col" class="govuk-table__header">Request type</th>
                        <th scope="col" class="govuk-table__header">Status</th>
                        <th scope="col" class="govuk-table__header">Date</th>
                        <th scope="col" class="govuk-table__header">Actions</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var row in Model.SubmittedRows)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@row.PupilName</td>
                            <td class="govuk-table__cell">@row.ReferenceNumber</td>
                            <td class="govuk-table__cell">@row.RequestTypeDescription</td>
                            <td class="govuk-table__cell">
                                <strong class="govuk-tag @row.TagClass">@row.TagLabel</strong>
                            </td>
                            <td class="govuk-table__cell">@row.SubmittedDateText</td>
                            <td class="govuk-table__cell">
                                @{
                                    var viewAction = row.RequestType == RequestType.ConfirmCorrect ? "ViewConfirmation" : "View";
                                    var deleteAction = row.RequestType == RequestType.ConfirmCorrect ? "ConfirmDeleteConfirmation" : "ConfirmDelete";
                                }
                                <a class="govuk-link govuk-!-margin-right-2" href="@Url.Action(viewAction, "SubmittedRequest", new { windowId = Model.WindowId, referenceNumber = row.ReferenceNumber })">View</a>
                                @if (row.ShowDelete)
                                {
                                    <a class="govuk-link" href="@Url.Action(deleteAction, "SubmittedRequest", new { windowId = Model.WindowId, referenceNumber = row.ReferenceNumber })">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </govuk-tabs-item>
</govuk-tabs>
