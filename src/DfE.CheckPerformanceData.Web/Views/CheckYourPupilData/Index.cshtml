@using DfE.CheckPerformanceData.Web.Controllers
@using DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData
@model DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData.CheckYourPupilDataViewModel

@{
    ViewBag.Title = "Check Your Pupil Data";
    Layout = "_Layout";
}

<a asp-action="Index" asp-controller="Landing" class="govuk-back-link">Back</a>

<h1 class="govuk-heading-xl">Check your pupil data</h1>

<div class="school-details">
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Checking Window</dt>
            <dd class="govuk-summary-list__value">@Model.WindowTitle @if(!Model.IsWindowOpen) {<strong>(Closed)</strong>} </dd>
        </div>
        
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Establishment Name</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationName</dd>
        </div>
    </dl>
</div>

@if (Model.IsWindowOpen)
{
    <p class="govuk-body">Review your pupil data by checking the tables below. You can also download the data as a CSV
        file. You must request any changes to pupil data before @Model.WindowEndTime on @Model.WindowEndDate</p>
}
else
{
    <p class="govuk-body">This @Model.WindowTitle Checking Window is closed. You can still download the data as a CSV file.</p>
}

<p class="govuk-body">
    <a asp-action="DownloadAll" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId">Download all CSV files as a ZIP file</a>
</p>

<govuk-tabs>
    <govuk-tabs-item id="included" label="Included pupils">
        <h2 class="govuk-heading-l">Pupil included</h2>
        @if (Model.IncludedPupilsTotalPages == 0)
        {
            <p class="govuk-body">No included pupils</p>
        }
        else
        {
            <p class="govuk-body">Download <a asp-action="DownloadIncluded" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId">pupil included</a> as a CSV file.</p>
            @await Html.PartialAsync("_PupilSearch", new PupilSearchViewModel
            {
                WindowId = Model.WindowId,
                InputId = "includedSearch",
                InputName = "includedSearch",
                CurrentValue = Model.IncludedSearch,
                ActiveTab = "included",
                OtherPageName = "nonIncludedPage",
                OtherPage = Model.NonIncludedPupilsPage,
                OtherSearchName = "nonIncludedSearch",
                OtherSearch = Model.NonIncludedSearch
            })
            @await Html.PartialAsync("_PupilTable", Model.IncludedPupils)
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                CurrentPage = Model.IncludedPupilsPage,
                TotalPages = Model.IncludedPupilsTotalPages,
                WindowId = Model.WindowId,
                OtherPage = Model.NonIncludedPupilsPage,
                PageParam = "includedPage",
                TabAnchor = "#included",
                IncludedSearch = Model.IncludedSearch,
                NonIncludedSearch = Model.NonIncludedSearch
            })
        }
    </govuk-tabs-item>

    <govuk-tabs-item id="nonIncluded" label="Non-included pupils">
        <h2 class="govuk-heading-l">Pupil non-include</h2>
        @if (Model.NonIncludedPupilsTotalPages == 0)
        {
            <p class="govuk-body">No non-included pupils</p>
        }
        else
        {
            <p class="govuk-body">Download <a asp-action="DownloadNonIncluded" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId">pupil non-included</a> as a CSV file.</p>
            @await Html.PartialAsync("_PupilSearch", new PupilSearchViewModel
            {
                WindowId = Model.WindowId,
                InputId = "nonIncludedSearch",
                InputName = "nonIncludedSearch",
                CurrentValue = Model.NonIncludedSearch,
                ActiveTab = "nonIncluded",
                OtherPageName = "includedPage",
                OtherPage = Model.IncludedPupilsPage,
                OtherSearchName = "includedSearch",
                OtherSearch = Model.IncludedSearch
            })
            @await Html.PartialAsync("_PupilTable", Model.NonIncludedPupils)
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                CurrentPage = Model.NonIncludedPupilsPage,
                TotalPages = Model.NonIncludedPupilsTotalPages,
                WindowId = Model.WindowId,
                OtherPage = Model.IncludedPupilsPage,
                PageParam = "nonIncludedPage",
                TabAnchor = "#nonIncluded",
                IncludedSearch = Model.IncludedSearch,
                NonIncludedSearch = Model.NonIncludedSearch
            })
        }
    </govuk-tabs-item>
</govuk-tabs>

@if (Model.IsWindowOpen)
{
    <form method="post" action="@Url.Action("NextStep", "CheckYourPupilData", new { windowId = Model.WindowId })">
        <govuk-radios for="SelectedNextStep">
            <govuk-radios-fieldset>
                <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                    What would you like to do?
                </govuk-radios-fieldset-legend>

                <govuk-radios-hint>
                    Select one option.
                </govuk-radios-hint>

                <govuk-radios-item value="@NextSteps.RequestChange">Request a change to pupil data
                </govuk-radios-item>
                <govuk-radios-divider>or</govuk-radios-divider>
                <govuk-radios-item value="@NextSteps.Confirm">Confirm pupil data is correct</govuk-radios-item>
            </govuk-radios-fieldset>
        </govuk-radios>

        <govuk-button type="submit">Continue</govuk-button>
    </form>
}

