@using DfE.CheckPerformanceData.Web.Controllers
@using DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData
@model DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData.CheckYourPupilDataViewModel

@{
    // Matches the "check-pupil-data-title" EditableTitle <h1> default below.
    ViewBag.Title = "Check your pupil data";
    Layout = "_Layout";
}

<a asp-action="Index" asp-controller="LandingPage" class="govuk-back-link">Back</a>

@await Component.InvokeAsync("EditableTitle", new
{
    key = "check-pupil-data-title",
    defaultText = "Check your pupil data",
    headingLevel = "h1",
    cssClass = "govuk-heading-xl"
})


<p class="govuk-body">Review your pupil data by checking the tables below. You can also download the data as a CSV
    file. You must request any changes to pupil data before @Model.WindowEndTime on @Model.WindowEndDate</p>

<p class="govuk-body">
    <a asp-action="DownloadAll" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId">Download all
        CSV files as a ZIP file</a>
</p>

@* KS4 tabs by inclusion status; 16-19 stacks both tables in one "Pupils" tab, because there the
   tab axis is dataset — the other 16-19 import files become sibling tabs later. *@
<govuk-tabs>
    @if (Model.SectionsAsTabs)
    {
        foreach (var pupilSection in Model.Sections)
        {
            <govuk-tabs-item id="@pupilSection.Key" label="@pupilSection.TabLabel">
                @await Html.PartialAsync("_PupilSection", new PupilSectionViewModel
                {
                    WindowId = Model.WindowId,
                    Section = pupilSection,
                    AllSections = Model.Sections,
                    TabAnchor = pupilSection.Key
                })
            </govuk-tabs-item>
        }
    }
    else
    {
        <govuk-tabs-item id="pupils" label="Pupils">
            @foreach (var pupilSection in Model.Sections)
            {
                @await Html.PartialAsync("_PupilSection", new PupilSectionViewModel
                {
                    WindowId = Model.WindowId,
                    Section = pupilSection,
                    AllSections = Model.Sections,
                    TabAnchor = "pupils"
                })
            }
        </govuk-tabs-item>
    }
</govuk-tabs>

@if (Model.IsWindowOpen)
{
    <form method="post" action="@Url.Action("NextStep", "CheckYourPupilData", new { windowId = Model.WindowId })">
        @Html.AntiForgeryToken()
        <govuk-radios for="SelectedNextStep">
            <govuk-radios-fieldset>
                @* Not is-page-heading: that renders the legend as an <h1>, and this page already
                   has one (the "check-pupil-data-title" EditableTitle above). Two <h1>s leave the
                   document with no single unambiguous title. The legend keeps the --l size so it
                   looks unchanged. *@
                <govuk-radios-fieldset-legend class="govuk-fieldset__legend--l">
                    What would you like to do?
                </govuk-radios-fieldset-legend>

                <govuk-radios-hint>
                    Select one option.
                </govuk-radios-hint>

                <govuk-radios-item value="@NextSteps.RequestChange">Request a change to pupil data
                </govuk-radios-item>
                <govuk-radios-divider>or</govuk-radios-divider>
                <govuk-radios-item value="@NextSteps.Confirm">Confirm pupil data is correct</govuk-radios-item>
            </govuk-radios-fieldset>
        </govuk-radios>

        <govuk-button type="submit">Continue</govuk-button>
    </form>
}
