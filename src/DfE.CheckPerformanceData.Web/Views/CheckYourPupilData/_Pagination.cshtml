@model DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData.PaginationViewModel

@{
    string PageUrl(int page)
    {
        var includedPage = Model.PageParam == "includedPage" ? page : Model.OtherPage;
        var nonIncludedPage = Model.PageParam == "nonIncludedPage" ? page : Model.OtherPage;
        var activeTab = Model.TabAnchor.TrimStart('#');
        return Url.Action("Index", "CheckYourPupilData", new { windowId = Model.WindowId, includedPage, nonIncludedPage, activeTab, includedSearch = Model.IncludedSearch, nonIncludedSearch = Model.NonIncludedSearch })! + Model.TabAnchor;
    }
}

@* This tab's pages are 0-indexed; the shared pager works in 1-based page numbers, so shift the
   current page up by one and shift it back down when building each URL. The windowing (and the
   collapse of long page runs to an ellipsis) lives in the one shared control. *@
@await Html.PartialAsync("_Pager", new PagerModel
{
    CurrentPage = Model.CurrentPage + 1,
    TotalPages = Model.TotalPages,
    PageUrl = p => PageUrl(p - 1),
})
