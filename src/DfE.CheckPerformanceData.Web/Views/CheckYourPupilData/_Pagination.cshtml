@using DfE.CheckPerformanceData.Web.Common
@model DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData.PaginationViewModel

@{
    string PageUrl(int page)
    {
        // Built from every section so each keeps its own page and search term, and a third
        // section would need no new named query keys.
        var routeValues = new RouteValueDictionary { ["windowId"] = Model.WindowId };

        foreach (var section in Model.AllSections)
        {
            routeValues[section.PageParam] = section == Model.Section ? page : section.Page;
            routeValues[section.SearchParam] = section.Search;
        }

        if (!string.IsNullOrEmpty(Model.TabAnchor))
        {
            routeValues["activeTab"] = Model.TabAnchor;
        }

        var url = Url.Action("Index", "CheckYourPupilData", routeValues)!;
        return string.IsNullOrEmpty(Model.TabAnchor) ? url : url + "#" + Model.TabAnchor;
    }
}

@if (Model.Section.TotalPages > 1)
{
    <govuk-pagination>
        @if (Model.Section.Page > 0)
        {
            <govuk-pagination-previous href="@PageUrl(Model.Section.Page - 1)" />
        }
        @* First page, last page, and the current page with one either side — see
           PaginationWindow. A null entry is a skipped run, rendered as an ellipsis. *@
        @foreach (var page in PaginationWindow.Build(Model.Section.Page, Model.Section.TotalPages))
        {
            if (page is null)
            {
                <govuk-pagination-ellipsis />
            }
            else
            {
                <govuk-pagination-item href="@PageUrl(page.Value)" current="@(page.Value == Model.Section.Page)">@(page.Value + 1)</govuk-pagination-item>
            }
        }
        @if (Model.Section.Page < Model.Section.TotalPages - 1)
        {
            <govuk-pagination-next href="@PageUrl(Model.Section.Page + 1)" />
        }
    </govuk-pagination>
}
