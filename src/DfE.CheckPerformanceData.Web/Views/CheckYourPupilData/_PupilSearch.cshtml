@model DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData.PupilSearchViewModel

@{
    var others = Model.AllSections.Where(s => s != Model.Section).ToList();
}

<div class="pupil-search">
    <form method="get" action="@Url.Action("Index", "CheckYourPupilData", new { windowId = Model.WindowId })">
        @* Every other section's state rides along so searching one table never resets another. *@
        @foreach (var other in others)
        {
            <input type="hidden" name="@other.PageParam" value="@other.Page" />
            <input type="hidden" name="@other.SearchParam" value="@other.Search" />
        }
        @if (!string.IsNullOrEmpty(Model.ActiveTab))
        {
            <input type="hidden" name="activeTab" value="@Model.ActiveTab" />
        }
        <div class="govuk-form-group">
            <label class="govuk-label" for="@Model.Section.SearchParam">
                Search for a pupil by first or last name
            </label>
            <div class="pupil-search__row">
                <input class="govuk-input" id="@Model.Section.SearchParam" name="@Model.Section.SearchParam" type="text" value="@Model.Section.Search" />
                <button class="govuk-button" data-module="govuk-button">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.Section.Search))
                {
                    var clearRouteValues = new RouteValueDictionary { ["windowId"] = Model.WindowId };
                    if (!string.IsNullOrEmpty(Model.ActiveTab))
                    {
                        clearRouteValues["activeTab"] = Model.ActiveTab;
                    }
                    foreach (var other in others)
                    {
                        clearRouteValues[other.PageParam] = other.Page;
                        clearRouteValues[other.SearchParam] = other.Search;
                    }
                    <a class="govuk-button govuk-button--secondary" href="@Url.Action("Index", "CheckYourPupilData", clearRouteValues)">Clear</a>
                }
            </div>
        </div>
    </form>
</div>
