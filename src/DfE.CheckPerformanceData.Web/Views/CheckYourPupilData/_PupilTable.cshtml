@model DfE.CheckPerformanceData.Application.CheckYourPupilData.Columns.PupilTable

@* Columns come from PupilColumnSets (Application), so a 16-19 table renders its own column
   set — and the CSV export uses the same definition, so the two cannot drift apart. *@
<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @foreach (var header in Model.Headers)
            {
                <th class="govuk-table__header" scope="col">@header</th>
            }
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var row in Model.Rows)
        {
            <tr class="govuk-table__row">
                @foreach (var cell in row)
                {
                    <td class="govuk-table__cell">@cell</td>
                }
            </tr>
        }
    </tbody>
</table>
