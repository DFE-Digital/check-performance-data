@model List<DfE.CheckPerformanceData.Application.ContentPages.ContentPageSummaryDto>
@{
    ViewData["Title"] = "Content pages";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l">Content pages</h1>
        <p class="govuk-body">Pages built with the content page builder. Each one is edited as a draft and published when ready.</p>

        <a href="/guidance/new" class="govuk-button" data-module="govuk-button">Create content page</a>

        @if (Model.Count == 0)
        {
            <p class="govuk-body">No content pages yet. Create one to get started.</p>
        }
        else
        {
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Title</th>
                        <th scope="col" class="govuk-table__header">Slug</th>
                        <th scope="col" class="govuk-table__header">Status</th>
                        <th scope="col" class="govuk-table__header">Last updated</th>
                        <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var cp in Model)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@cp.Title</td>
                            <td class="govuk-table__cell"><code>@cp.Slug</code></td>
                            <td class="govuk-table__cell">
                                @if (cp.IsPublished)
                                {
                                    <strong class="govuk-tag govuk-tag--green">Published v@(cp.PublishedVersionNumber)</strong>
                                }
                                else
                                {
                                    <strong class="govuk-tag govuk-tag--grey">Draft</strong>
                                }
                            </td>
                            <td class="govuk-table__cell">@cp.UpdatedAt.ToString("d MMM yyyy, HH:mm")</td>
                            <td class="govuk-table__cell">
                                <a class="govuk-link govuk-!-margin-right-3" href="/guidance/@cp.Slug/edit">Edit</a>
                                @if (cp.IsPublished)
                                {
                                    <a class="govuk-link" href="/guidance/@cp.Slug">View</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
