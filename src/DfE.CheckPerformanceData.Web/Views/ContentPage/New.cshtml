@model DfE.CheckPerformanceData.Web.Models.Guidance.NewContentPageModel
@{
    ViewData["Title"] = "New content page";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">New content page</h1>

        <form method="post" action="/content-page/create">
            @Html.AntiForgeryToken()

            <div class="govuk-form-group">
                <label class="govuk-label" for="Title">Title</label>
                <input class="govuk-input" id="Title" name="Title" value="@Model.Title" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="Slug">Slug (optional)</label>
                <div class="govuk-hint">Leave blank to derive it from the title.</div>
                <input class="govuk-input" id="Slug" name="Slug" value="@Model.Slug" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="Caption">Caption (optional)</label>
                <input class="govuk-input" id="Caption" name="Caption" value="@Model.Caption" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="Layout">Layout</label>
                <select class="govuk-select" id="Layout" name="Layout">
                    <option value="nav-content" selected="@(Model.Layout == "nav-content" ? "selected" : null)">Side navigation and content</option>
                    <option value="full" selected="@(Model.Layout == "full" ? "selected" : null)">Full width</option>
                </select>
            </div>

            <button class="govuk-button" type="submit">Create page</button>
        </form>
    </div>
</div>
