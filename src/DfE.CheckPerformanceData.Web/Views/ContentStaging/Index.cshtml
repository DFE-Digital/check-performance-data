@using DfE.CheckPerformanceData.Application.ContentStaging
@{
    ViewData["Title"] = "Content staging import/export";
    var result = TempData["ContentStagingResult"] as string;
    var errors = (TempData["ContentStagingError"] as string)?
        .Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? [];
    var warnings = (TempData["ContentStagingWarnings"] as string)?
        .Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? [];
}

<a href="/admin" class="govuk-back-link">Back to administration</a>

<h1 class="govuk-heading-xl">Content staging import/export</h1>

@if (errors.Length > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                @if (errors.Length == 1)
                {
                    <p class="govuk-body">@errors[0]</p>
                }
                else
                {
                    <ul class="govuk-list govuk-error-summary__list">
                        @foreach (var e in errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(result))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="content-staging-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="content-staging-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@result</p>
        </div>
    </div>
}

@* Import warnings surface in their own default-variant (yellow) notification banner
   rather than tucked inside a collapsed <details> of the success banner. Sanitisation
   warnings ("N items had script tags removed on import") are exactly the kind of thing
   an operator needs to see immediately, not click-to-expand. Every warning is listed
   in full — the operator can eyeball the count in the heading and the specifics in
   the body. *@
@if (warnings.Length > 0)
{
    <div class="govuk-notification-banner" role="alert"
         aria-labelledby="content-staging-warnings-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="content-staging-warnings-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
                @(warnings.Length == 1 ? "The import produced 1 warning." : $"The import produced {warnings.Length} warnings.")
            </p>
            <ul class="govuk-list govuk-list--bullet">
                @foreach (var w in warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </div>
    </div>
}

<p class="govuk-body">
    Move pages and content blocks between environments. Export produces a zipped bundle of the
    current content; import replays that bundle through the application, so the normal validation,
    sanitisation and version history all apply.
</p>

<h2 class="govuk-heading-l">Export</h2>
<p class="govuk-body">
    Download pages and content blocks from this environment as a
    <code>@ContentBundle.CurrentSchema</code> bundle. Each page brings its most recent
    @ContentExportSelection.DefaultMaxVersionsPerNode versions, plus whichever version is
    currently live.
</p>

@* GET so the response is still a plain download the browser can retry from history. An
   unticked checkbox is simply absent from the query string, which binds to false. *@
<form method="get" action="/admin/content-staging/export">
    <div class="govuk-form-group">
        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="full-history" name="fullHistory" type="checkbox" value="true">
                <label class="govuk-label govuk-checkboxes__label" for="full-history">
                    Include full version history
                </label>
                <div id="full-history-hint" class="govuk-hint govuk-checkboxes__hint">
                    Exports every saved version of every page. Only needed when migrating an
                    environment wholesale — it can make the bundle many times larger.
                </div>
            </div>
        </div>
    </div>

    <button class="govuk-button" data-module="govuk-button" type="submit">
        Export everything
    </button>
    <a draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button" href="/admin/content-staging/select" role="button">
        Choose what to export
    </a>
</form>

<h2 class="govuk-heading-l">Import</h2>
<p class="govuk-body">
    Upload a bundle to preview it first: you'll see exactly what will be added and which items
    already exist, and can choose what to do with each collision before anything changes.
</p>
<form method="post" action="/admin/content-staging/preview" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="govuk-form-group">
        <label class="govuk-label govuk-label--m" for="bundle">Content bundle file</label>
        <div id="bundle-hint" class="govuk-hint">
            Select the <code>.zip</code> bundle exported from another environment. Bundles
            exported as <code>.json</code> by earlier releases still work, zipped or not.
        </div>
        <input class="govuk-file-upload" id="bundle" name="bundle" type="file"
               accept="application/zip,.zip,application/json,.json" aria-describedby="bundle-hint">
    </div>

    <button class="govuk-button" data-module="govuk-button" data-prevent-double-click="true" type="submit">
        Preview import
    </button>
</form>

@* Reset content is a throwaway-environment tool: it deletes every page and content block.
   Rendered only where the controller says the route will accept it (Dev:ToolsEnabled and not
   production), so the button is never shown somewhere the POST would 404. *@
@if (ViewData["ClearAllAvailable"] is true)
{
    <h2 class="govuk-heading-l">Reset content</h2>
    <p class="govuk-body">
        Deletes every CMS page and content block in this environment. Use it to get a clean slate
        before replaying a bundle from another environment.
    </p>
    <button type="button" class="govuk-button govuk-button--warning"
            data-module="govuk-button" data-confirm-trigger="clear-all-modal">
        Clear all CMS content
    </button>

    <govuk-confirm-modal id="clear-all-modal"
                         title="Clear all CMS content?"
                         warning-text="This deletes every page and content block from this environment. It cannot be undone."
                         body="Default root nodes (support, help, guidance, wiki) and the /help/not-found page regenerate automatically on the next request. Any custom pages, saved versions, or content-block edits are gone."
                         confirm-label="Yes, clear everything"
                         destructive="true"
                         form-action="/admin/content-staging/clear-all"
                         form-method="post">
        @Html.AntiForgeryToken()
    </govuk-confirm-modal>
}
