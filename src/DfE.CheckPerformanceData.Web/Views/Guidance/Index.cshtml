@{
    ViewData["Title"] = "CYPMD help and support";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" href="/">Home</a>
        </li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">CYPMD help and support</li>
    </ol>
</nav>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full cypmd-landing">
        <span class="govuk-caption-l">Check your performance measures data (CYPMD)</span>
        @await Component.InvokeAsync("EditableTitle", new
        {
            key = "guidance-landing-title",
            defaultText = "CYPMD help and support",
            headingLevel = "h1",
            cssClass = "govuk-heading-xl"
        })
        @await Component.InvokeAsync("EditableContent", new { key = "guidance-landing-intro", defaultHtml = "<p class=\"govuk-body\">Guidance for schools and colleges.</p>" })

        <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">

        <form class="cypmd-search" action="#" method="get" role="search">
            <label class="govuk-label govuk-label--s" for="cypmd-search">Search CYPMD help and support</label>
            <div class="cypmd-search__row">
                <input class="govuk-input cypmd-search__input" id="cypmd-search" name="q" type="search">
                <button type="submit" class="govuk-button cypmd-search__button" data-module="govuk-button">Search</button>
            </div>
        </form>

        <section class="cypmd-landing-section">
            @await Component.InvokeAsync("EditableTitle", new { key = "guidance-landing-signin-heading", defaultText = "How to sign in to the CYPMD service", headingLevel = "h2", cssClass = "govuk-heading-l" })
            <hr class="govuk-section-break govuk-section-break--visible cypmd-landing-section__rule">
            @await Component.InvokeAsync("EditableContent", new { key = "guidance-landing-signin", defaultHtml = "<p class=\"govuk-body\">Sign-in guidance.</p>" })

            @await Component.InvokeAsync("EditableTitle", new { key = "guidance-landing-alerts-heading", defaultText = "Get email alerts", headingLevel = "h3", cssClass = "govuk-heading-m" })
            @await Component.InvokeAsync("EditableContent", new { key = "guidance-landing-alerts", defaultHtml = "<p class=\"govuk-body\">Email alerts.</p>" })
        </section>

        @foreach (var s in new[]
        {
            ("ks4", "Key stage 4 data checks"),
            ("ks2", "Key stage 2 data checks"),
            ("1619", "16 to 19 data checks")
        })
        {
            <section class="cypmd-landing-section">
                @await Component.InvokeAsync("EditableTitle", new { key = $"guidance-landing-{s.Item1}-heading", defaultText = s.Item2, headingLevel = "h2", cssClass = "govuk-heading-l" })
                <hr class="govuk-section-break govuk-section-break--visible cypmd-landing-section__rule">
                @await Component.InvokeAsync("EditableContent", new { key = $"guidance-landing-{s.Item1}-intro", defaultHtml = "<p class=\"govuk-body\">Section introduction.</p>" })
                @await Component.InvokeAsync("EditableContent", new { key = $"guidance-landing-{s.Item1}-cards", defaultHtml = "<p class=\"govuk-body\">Cards.</p>" })
            </section>
        }
    </div>
</div>
