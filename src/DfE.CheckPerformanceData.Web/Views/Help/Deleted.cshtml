@using DfE.CheckPerformanceData.Web.Controllers
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.DeletedWikiPagesViewModel
@{
    ViewData["Title"] = "Deleted pages - Help";
    var r = Model.Results;

    string SearchQs() => string.IsNullOrEmpty(r.Search) ? "" : $"&search={Uri.EscapeDataString(r.Search)}";

    string SortLink(string col)
    {
        var dir = (r.Sort == col && r.Direction == "asc") ? "desc" : "asc";
        return $"/help/deleted?sort={col}&dir={dir}{SearchQs()}";
    }

    string AriaSort(string col) =>
        r.Sort != col ? "none" : (r.Direction == "asc" ? "ascending" : "descending");

    string SortText(string col, string label) =>
        r.Sort != col ? label : (r.Direction == "asc" ? $"{label} ▲" : $"{label} ▼");

    string PageLink(int p) =>
        $"/help/deleted?sort={r.Sort}&dir={r.Direction}&page={p}{SearchQs()}";

    var firstRow = r.TotalCount == 0 ? 0 : ((r.Page - 1) * r.PageSize) + 1;
    var lastRow = Math.Min(r.Page * r.PageSize, r.TotalCount);
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <a href="/help?@WikiConstants.EditQueryKey" class="govuk-back-link">Back to wiki</a>

        <h1 class="govuk-heading-l">Deleted pages</h1>

        @if (TempData["HardDeleteError"] is string err)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title">Could not delete the page</h2>
                <div class="govuk-error-summary__body">
                    <p class="govuk-body">@err</p>
                </div>
            </div>
        }

        <form method="get" action="/help/deleted" class="govuk-!-margin-bottom-6">
            <div class="govuk-form-group govuk-!-margin-bottom-2">
                <label class="govuk-label" for="search">Search by title or path</label>
                <input class="govuk-input govuk-input--width-20" id="search" name="search"
                       type="search" value="@r.Search" />
            </div>
            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                    data-module="govuk-button">Search</button>
            @if (!string.IsNullOrEmpty(r.Search))
            {
                <a class="govuk-link govuk-!-margin-left-2" href="/help/deleted">Clear search</a>
            }
        </form>

        @if (r.TotalCount == 0)
        {
            <p class="govuk-body">
                @(string.IsNullOrEmpty(r.Search)
                    ? "No deleted pages."
                    : $"No deleted pages match “{r.Search}”.")
            </p>
        }
        else
        {
            <p class="govuk-body">
                Showing @firstRow to @lastRow of @r.TotalCount deleted page@(r.TotalCount == 1 ? "" : "s").
                Restoring a page also restores any of its child pages that were deleted at the same time.
            </p>

            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-visually-hidden">Deleted wiki pages</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header" aria-sort="@AriaSort("title")">
                            <a class="govuk-link" href="@SortLink("title")">@SortText("title", "Title")</a>
                        </th>
                        <th scope="col" class="govuk-table__header" aria-sort="@AriaSort("path")">
                            <a class="govuk-link" href="@SortLink("path")">@SortText("path", "Path at deletion")</a>
                        </th>
                        <th scope="col" class="govuk-table__header" aria-sort="@AriaSort("deleted")">
                            <a class="govuk-link" href="@SortLink("deleted")">@SortText("deleted", "Deleted")</a>
                        </th>
                        <th scope="col" class="govuk-table__header" aria-sort="@AriaSort("children")">
                            <a class="govuk-link" href="@SortLink("children")">@SortText("children", "Child pages")</a>
                        </th>
                        <th scope="col" class="govuk-table__header">Actions</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var deleted in Model.DeletedPages)
                    {
                        var modalId = $"confirm-hard-delete-{deleted.Id}";
                        var pluralS = deleted.DescendantCount == 1 ? "" : "s";
                        var descendantPart = deleted.DescendantCount == 0
                            ? string.Empty
                            : $" and {deleted.DescendantCount} descendant page{pluralS}";
                        var modalTitle = $"Are you sure you want to delete '{deleted.Title}'{descendantPart} permanently?";
                        var modalWarning = deleted.DescendantCount == 0
                            ? "This will permanently remove this page and all its version history. This action cannot be undone."
                            : $"This will permanently remove this page, {deleted.DescendantCount} descendant page{pluralS}, and all their version history. This action cannot be undone.";

                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@deleted.Title</td>
                            <td class="govuk-table__cell"><code>/@deleted.OriginalSlugPath</code></td>
                            <td class="govuk-table__cell">
                                @(deleted.DeletedAt.HasValue
                                    ? deleted.DeletedAt.Value.ToString("d MMM yyyy HH:mm")
                                    : "Unknown")
                            </td>
                            <td class="govuk-table__cell">
                                @(deleted.DescendantCount == 0
                                    ? "—"
                                    : deleted.DescendantCount == 1
                                        ? "1 page"
                                        : $"{deleted.DescendantCount} pages")
                            </td>
                            <td class="govuk-table__cell">
                                <div class="govuk-button-group govuk-!-margin-bottom-0">
                                    <form action="/help/restore/@deleted.Id" method="post" class="wiki-restore-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="@WikiConstants.EditModeFormKey" value="true" />
                                        <div class="govuk-form-group govuk-!-margin-bottom-2">
                                            <label class="govuk-label govuk-label--s" for="parent-@deleted.Id">
                                                Restore under
                                            </label>
                                            <select class="govuk-select" id="parent-@deleted.Id" name="newParentId">
                                                <option value="">Top level</option>
                                                @foreach (var option in Model.AvailableParents)
                                                {
                                                    var indent = new string(' ', option.Depth * 2);
                                                    <option value="@option.Id">@indent@option.Title</option>
                                                }
                                            </select>
                                        </div>
                                        <button type="submit"
                                                class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                                data-module="govuk-button">
                                            Restore
                                        </button>
                                    </form>

                                    <button type="button"
                                            class="govuk-button govuk-button--warning"
                                            data-confirm-trigger="@modalId"
                                            aria-haspopup="dialog"
                                            aria-controls="@modalId"
                                            data-module="govuk-button">
                                        Delete permanently
                                    </button>

                                    <govuk-confirm-modal id="@modalId"
                                                         title="@modalTitle"
                                                         warning-text="@modalWarning"
                                                         body=""
                                                         confirm-label="Yes, delete permanently"
                                                         destructive="true"
                                                         form-action="@($"/help/delete-permanently/{deleted.Id}")"
                                                         form-method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="@WikiConstants.EditModeFormKey" value="true" />
                                    </govuk-confirm-modal>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @await Html.PartialAsync("_Pager", new PagerModel
            {
                CurrentPage = r.Page,
                TotalPages = r.TotalPages,
                PageUrl = PageLink,
            })
        }
    </div>
</div>
