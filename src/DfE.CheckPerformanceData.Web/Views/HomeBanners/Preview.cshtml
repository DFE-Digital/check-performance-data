@model DfE.CheckPerformanceData.Application.HomeBanners.HomeBannerDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Preview: {Model.Heading}";
}

@await Html.PartialAsync("Components/HomeBanners/_Banner", Model)

<h1 class="govuk-heading-l">Preview of a home page banner</h1>
<p class="govuk-body">This is how the banner above will look at the top of the start page. Its status now is <strong>@Model.Status</strong>.</p>
<p class="govuk-body"><a class="govuk-link" href="/admin/home-banners">Back to home page banners</a></p>
