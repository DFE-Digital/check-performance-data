@model DfE.CheckPerformanceData.Web.Controllers.ImpersonationViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "View as an establishment"; }
<h1 class="govuk-heading-l">View as an establishment</h1>
<p class="govuk-body">View establishment data in read-only mode. You cannot save or submit changes. Search for an establishment to fill in its details, or enter the identifiers and age range directly.</p>
<govuk-error-summary />
<div class="govuk-form-group" id="establishment-picker" data-search-url="@Url.Action("Search", "Impersonation")">
    <label class="govuk-label" for="establishment-search">Search for an establishment</label>
    <div class="govuk-hint" id="establishment-search-hint">Enter at least 2 characters from the establishment name or URN.</div>
    <div id="establishment-search-container"></div>
</div>
<form asp-action="Start" asp-controller="Impersonation" method="post">
    <govuk-input for="Laestab"><govuk-input-label>LAESTAB</govuk-input-label></govuk-input>
    <govuk-input for="Urn"><govuk-input-label>URN</govuk-input-label></govuk-input>
    <govuk-input for="LowestAge" inputmode="numeric"><govuk-input-label>Lowest age</govuk-input-label></govuk-input>
    <govuk-input for="HighestAge" inputmode="numeric"><govuk-input-label>Highest age</govuk-input-label></govuk-input>
    <button class="govuk-button" type="submit">Start read-only impersonation</button>
</form>

@section Scripts {
    <script src="~/js/accessible-autocomplete.min.js"></script>
    <script src="~/js/impersonation-establishment-picker.js" asp-append-version="true" defer></script>
}
