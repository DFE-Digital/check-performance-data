@using DfE.CheckPerformanceData.Application.CheckYourPupilData
@using DfE.CheckPerformanceData.Web.Controllers.Journey
@using DfE.CheckPerformanceData.Web.Controllers.CheckYourPupilData
@model ConfirmationViewModel

@{
    ViewBag.Title = "Data amendment request submitted";
    Layout = "_Layout";
}

<div class="govuk-panel govuk-panel--confirmation">
    <h1 class="govuk-panel__title">Data amendment request submitted</h1>
    <div class="govuk-panel__body">
        Your reference number<br>
        <strong>@Model.ReferenceNumber</strong>
    </div>
</div>

<p class="govuk-body">We have sent you an email to confirm that you have successfully submitted a request.</p>

@* #713: the deadline is null when the pupil data exercise is not open to the school (the
   controller decides), so the banner goes with it — the bulk confirmation page's pattern. *@
@if (Model.WindowCloseLabel is not null)
{
    <govuk-notification-banner>
        You still have until <strong>@Model.WindowCloseLabel</strong> to request any further amendments if you need to.
    </govuk-notification-banner>
}

@* #713: the onward links follow the exercises open in this window now, not the kind of request
   just submitted. The words are the check-your-pupil-data page's words, so they cannot drift. *@
<ul class="govuk-list govuk-list--bullet">
    @if (Model.NextSteps.Contains(NextSteps.RequestChange))
    {
        <li><a class="govuk-link" asp-action="Index" asp-controller="WhatToChange" asp-route-windowId="@Model.WindowId">@NextStepLabels.For(NextSteps.RequestChange, Model.LearnerNoun)</a></li>
    }
    <li><a class="govuk-link" asp-action="Index" asp-controller="AmendmentRequests" asp-route-windowId="@Model.WindowId">edit an existing request</a></li>
    @if (Model.NextSteps.Contains(NextSteps.ResultsEnquiry))
    {
        <li><a class="govuk-link" asp-action="Index" asp-controller="ResultIssue" asp-route-windowId="@Model.WindowId">@NextStepLabels.For(NextSteps.ResultsEnquiry, Model.LearnerNoun)</a></li>
    }
    <li><a class="govuk-link" asp-action="Index" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId">Return to check your data</a></li>
</ul>

@await Component.InvokeAsync("EditableTitle", new {
    key = "journey_confirmation_next_steps_title",
    defaultText = "What happens next",
    headingLevel = "h2",
    cssClass = "govuk-caption-l"
})

@* #626: _v2 because a block seeds once per key. Environments that already held
   journey_confirmation_next_steps kept its old copy, which the corrected default never replaced. *@
@await Component.InvokeAsync("EditableContent", new
{
    key = "journey_confirmation_next_steps_v2",
    defaultHtml = "<p class=\"govuk-body\">After you submit your amendments:</p>\n<ul class=\"govuk-list govuk-list--bullet\">\n    <li>the DfE will review any evidence you provide</li>\n    <li>you'll be able to track the status of your requests in the service</li>\n    <li>your school's performance data will be updated in the Autumn, if the request is approved</li>\n</ul>"
})
