@model DfE.CheckPerformanceData.Web.Controllers.Journey.PageViewModel

@{
    ViewBag.Title = Model.PageTitle;
    Layout = "_Layout";
    // An upload refused by "Upload file" comes back after a redirect, so ModelState is valid and
    // the error lives only on the view model. This is what gives the title its "Error: " prefix.
    ViewData["HasError"] = Model.HasErrors;
}

@await Html.PartialAsync("_JourneyBackLink", Model)

@if (Model.HasErrors)
{
    @await Html.PartialAsync("_JourneyErrorSummary", Model)
}

@if (Model.Caption is not null)
{
    <span class="govuk-caption-xl">@Model.Caption</span>
}
@if (Model.ResolvedTitle is not null)
{
    <h1 class="govuk-heading-xl">@Model.ResolvedTitle</h1>
}

@if (Model.RequireAtLeastOne)
{
    <div class="govuk-inset-text">
        @DfE.CheckPerformanceData.Application.Journey.RequireAtLeastOneResult.Message
    </div>
}

@* #514: the evidence requirements show by default. They were behind a details component,
   so a school could submit without ever opening it. Do not put them back in one.
   #591: one block for each option the school ticked, under the one heading. Each block must
   read correctly on its own, because any set of options can show. A block for an option seeds
   with a placeholder that names the option, so a guidance writer can tell the blocks apart. The
   page's own content cannot say which option it is for, so it seeds only a block for no option. *@
<h2 class="govuk-heading-m">@(Model.Page.DetailsSummary ?? "What evidence do I need?")</h2>
@foreach (var block in Model.EvidenceContentBlocks)
{
    @await Component.InvokeAsync("EditableContent", new {
        key = block.Key+"-evidence",
        defaultHtml = block.OptionLabel is not null
            ? $@"<p class=""govuk-body"">
                PLACEHOLDER EVIDENCE REQUIREMENTS COPY FOR: {Html.Encode(block.OptionLabel)}
                </p>"
            : Model.Page.Content ?? @"<p class=""govuk-body"">
                PLACEHOLDER EVIDENCE REQUIREMENTS COPY
                </p>"
    })
}

@* One multipart form for the whole page so the file upload/remove buttons carry the text
   fields too — otherwise text typed before an upload/remove is lost. The upload and remove
   controls use `formaction` to post to their own actions. *@
<form method="post" enctype="multipart/form-data"
      action="@Url.Action("PagePost", "Journey", new { windowId = Model.WindowId, pageId = Model.Page.Id })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="fromSummary" value="@Model.FromSummary.ToString().ToLower()" />

    @foreach (var qm in Model.FileUploadModels)
    {
        await Html.RenderPartialAsync("_FileUpload", qm);
    }

    @foreach (var qm in Model.NonFileUploadModels)
    {
        await Html.RenderPartialAsync("_Question", qm);
    }

    <govuk-button type="submit">Continue</govuk-button>
    <govuk-button type="submit"
        formaction="@Url.Action("SaveDraft", "Journey", new { windowId = Model.WindowId, pageId = Model.Page.Id })"
        class="govuk-button--secondary">Save and continue later</govuk-button>
</form>
