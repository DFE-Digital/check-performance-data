@model DfE.CheckPerformanceData.Web.Controllers.Journey.PageViewModel

@{
    ViewBag.Title = Model.PageTitle;
    Layout = "_Layout";
}

@await Html.PartialAsync("_JourneyBackLink", Model)

@if (Model.Page.Type == PageType.Content)
{
    if (Model.Page.Subheading is not null)
    {
        @await Component.InvokeAsync("EditableTitle", new {
            key = Model.ContentKey + "_subheading",
            defaultText = Model.Page.Subheading,
            headingLevel = "span",
            cssClass = "govuk-caption-xl"
        })
    }
    if (Model.ResolvedTitle is not null)
    {
        <h1 class="govuk-heading-xl">@Model.ResolvedTitle</h1>
    }
    if (Model.ContentKey is not null)
    {
        @await Component.InvokeAsync("EditableContent", new
        {
            key = Model.ContentKey,
            defaultHtml = Model.Page.Content ?? string.Empty
        })
    }
    <form method="post" action="@Url.Action("PagePost", "Journey", new { windowId = Model.WindowId, pageId = Model.Page.Id })">
        @Html.AntiForgeryToken()
        <input type="hidden" name="fromSummary" value="@Model.FromSummary.ToString().ToLower()" />
        <govuk-button type="submit">Continue</govuk-button>
    </form>
}
else
{
    @if (Model.HasErrors)
    {
        @await Html.PartialAsync("_JourneyErrorSummary", Model)
    }

    @if (!Model.IsSingleQuestion && Model.ResolvedTitle is not null)
    {
        <h1 class="govuk-heading-xl">@Model.ResolvedTitle</h1>
    }

    @* One multipart form for the whole page so any file upload/remove buttons carry the
       other questions' values too (see EvidenceUpload.cshtml). The upload and remove controls
       use `formaction` to post to their own actions. *@
    <form method="post" enctype="multipart/form-data"
          action="@Url.Action("PagePost", "Journey", new { windowId = Model.WindowId, pageId = Model.Page.Id })">
        @Html.AntiForgeryToken()
        <input type="hidden" name="fromSummary" value="@Model.FromSummary.ToString().ToLower()" />

        @foreach (var qm in Model.FileUploadModels)
        {
            await Html.RenderPartialAsync("_FileUpload", qm);
        }

        @foreach (var qm in Model.NonFileUploadModels)
        {
            await Html.RenderPartialAsync("_Question", qm);
        }

        <govuk-button type="submit">Continue</govuk-button>
    </form>
}
