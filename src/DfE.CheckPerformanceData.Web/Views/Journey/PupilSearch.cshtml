@model DfE.CheckPerformanceData.Web.Controllers.Journey.PupilSearchViewModel

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
    var hasError = !ViewData.ModelState.IsValid;
    var fieldErrorMessage = ViewData.ModelState["selectedPupilId"]?.Errors.FirstOrDefault()?.ErrorMessage
        ?? "Enter the name of the pupil";
}

@if (Model.BackPageId is not null)
{
    <a asp-action="@Model.BackPageAction" asp-controller="Journey"
       asp-route-windowId="@Model.WindowId"
       asp-route-pageId="@Model.BackPageId"
       class="govuk-back-link">Back</a>
}
else
{
    <a asp-action="Index" asp-controller="WhatToChange" asp-route-windowId="@Model.WindowId" class="govuk-back-link">Back</a>
}

@if (Model.ConflictAttentionHtml is not null)
{
    <div role="region" class="moj-alert moj-alert--warning moj-alert--with-heading" aria-label="warning: There is a problem" data-module="moj-alert">
        <div>
            <svg class="moj-alert__icon" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30" height="30" width="30">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M15 2.44922L28.75 26.1992H1.25L15 2.44922ZM13.5107 9.49579H16.4697L16.2431 17.767H13.7373L13.5107 9.49579ZM15 20.2508C14.0795 20.2508 13.3333 21.0028 13.3333 21.9318C13.3333 22.8608 14.0795 23.6128 15 23.6128C15.9205 23.6128 16.6667 22.8608 16.6667 21.9318C16.6667 21.0028 15.9205 20.2508 15 20.2508Z" />
            </svg>
        </div>
        <div class="moj-alert__content">
            <h2 class="moj-alert__heading">Attention</h2>
            <p class="govuk-body">@Html.Raw(Model.ConflictAttentionHtml)</p>
        </div>
    </div>
}

@if (hasError)
{
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    if (!string.IsNullOrEmpty(modelError))
    {
        <govuk-error-summary>
            <govuk-error-summary-title>There is a problem</govuk-error-summary-title>
            <govuk-error-summary-item>@modelError</govuk-error-summary-item>
            <govuk-error-summary-item href="#pupil-search">@fieldErrorMessage</govuk-error-summary-item>
        </govuk-error-summary>
    }
    else
    {
        <govuk-error-summary>
            <govuk-error-summary-title>There is a problem</govuk-error-summary-title>
            <govuk-error-summary-item href="#pupil-search">@fieldErrorMessage</govuk-error-summary-item>
        </govuk-error-summary>
    }
}

@* The page title is the autocomplete's <label>, not a free-standing <h1>. accessible-autocomplete
   builds the input in JS, so nothing in the server markup can carry the accessible name unless a
   label points at the id the script assigns ("pupil-search" below). This mirrors _Autocomplete.cshtml. *@
<form method="post" action="@Url.Action("PupilSearchPost", "Journey", new { windowId = Model.WindowId, pageId = Model.PageId })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="selectedPupilId" id="selectedPupilId" value="@Model.SelectedPupilId" />

    <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="pupil-search">@Model.Title</label>
        </h1>
        <div class="govuk-hint" id="pupil-search-hint">@(Model.Hint ?? "Start typing to see a list of names")</div>
        @if (hasError)
        {
            <p id="pupil-search-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>
                @fieldErrorMessage
            </p>
        }
        <div id="pupil-search-container"></div>
    </div>

    <govuk-button type="submit">Continue</govuk-button>
</form>

@section Scripts {
    <script>
        (function () {
            var windowId = '@Model.WindowId';
            var filter = '@Model.Filter.ToString().ToLower()';
            var requireResults = @(Model.RequireResults ? "true" : "false");
            var excludePupilId = '@(Model.ExcludePupilId?.ToString() ?? "")';
            var hasError = @(hasError ? "true" : "false");
            var initialLabel = @Json.Serialize(Model.SelectedPupilLabel ?? "");
            var hintText = @Json.Serialize(Model.Hint ?? "Start typing to see a list of names");
            var errorText = @Json.Serialize(fieldErrorMessage);
            var currentSuggestions = [];

            // accessible-autocomplete owns the input's aria-describedby: it points at its own
            // generated "#{id}__assistiveHint" element and is rewritten on every re-render, so
            // setting aria-describedby ourselves (whether via an option or post-init) is silently
            // discarded. tAssistiveHint is the supported way in — it sets the text of the element
            // describedby already references. Prepending the error and hint means both are
            // announced on load and on focus, which is when they matter; the component drops the
            // description once the user starts typing, by design.
            var assistiveHint = (hasError ? 'Error: ' + errorText + '. ' : '')
                + hintText + '. '
                + 'When autocomplete results are available use up and down arrows to review and '
                + 'enter to select. Touch device users, explore by touch or with swipe gestures.';

            accessibleAutocomplete({
                element: document.querySelector('#pupil-search-container'),
                id: 'pupil-search',
                name: 'selectedPupilLabel',
                displayMenu: 'overlay',
                minLength: 2,
                inputClasses: 'govuk-input' + (hasError ? ' govuk-input--error' : ''),
                // Restore a previously selected pupil through the component, not the DOM
                // (AB#295434) — see _Autocomplete.cshtml for the full rationale.
                defaultValue: initialLabel,
                tAssistiveHint: function () { return assistiveHint; },
                // On a restricted search the component's default "No results found" reads as "you
                // typed it wrong", when the student may simply hold no results. Saying which it is
                // here is the only place the user sees it — the hint above is gone once they type.
                // FLAGGED: copy needs content sign-off.
                tNoResults: function () {
                    return requireResults ? 'No students found with results' : 'No results found';
                },
                source: function (query, populateResults) {
                    var url = '/pupils/suggestions?windowId=' + windowId
                        + '&query=' + encodeURIComponent(query)
                        + '&filter=' + filter;
                    if (excludePupilId) url += '&excludePupilId=' + excludePupilId;
                    if (requireResults) url += '&requireResults=true';

                    fetch(url)
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            currentSuggestions = data;
                            populateResults(data.map(function (d) { return d.label; }));
                        })
                        .catch(function () { populateResults([]); });
                },
                onConfirm: function (value) {
                    var hiddenField = document.getElementById('selectedPupilId');
                    if (!value) { hiddenField.value = ''; return; }
                    var match = currentSuggestions.find(function (s) { return s.label === value; });
                    hiddenField.value = match ? match.id : '';
                },
                confirmOnBlur: false
            });

            // AB#295434 follow-up: seeds validChoiceMade via a synthetic Escape keydown
            // so the restored field's first focus doesn't reopen the suggestion menu —
            // see _Autocomplete.cshtml for the full rationale. Safe only because
            // confirmOnBlur is false above.
            if (initialLabel) {
                document.getElementById('pupil-search').dispatchEvent(
                    new KeyboardEvent('keydown', { keyCode: 27, which: 27, key: 'Escape', bubbles: true }));
            }
        })();
    </script>
}
