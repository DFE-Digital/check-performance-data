@using DfE.CheckPerformanceData.Web.Controllers.Journey
@using DfE.CheckPerformanceData.Web.QuestionFlow
@model QuestionViewModel

@{
    ViewBag.Title = Model.Question.Title;
    Layout = "_Layout";
}

@if (Model.FromSummary)
{
    <a asp-action="Summary" asp-controller="Journey" asp-route-windowId="@Model.WindowId" class="govuk-back-link">Back</a>
}
else if (Model.BackQuestionId is not null)
{
    <a asp-action="Question" asp-controller="Journey" asp-route-windowId="@Model.WindowId"
       asp-route-questionId="@Model.BackQuestionId" class="govuk-back-link">Back</a>
}
else
{
    <a asp-action="Index" asp-controller="PupilSearch" asp-route-windowId="@Model.WindowId" class="govuk-back-link">Back</a>
}

@if (!ViewData.ModelState.IsValid)
{
    <govuk-error-summary>
        <govuk-error-summary-title>There is a problem</govuk-error-summary-title>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <govuk-error-summary-item>@error.ErrorMessage</govuk-error-summary-item>
        }
    </govuk-error-summary>
}

<form method="post" action="@Url.Action("QuestionPost", "Journey", new { windowId = Model.WindowId, questionId = Model.Question.Id })"
      enctype="@(Model.Question.Type == QuestionType.FileUpload ? "multipart/form-data" : "application/x-www-form-urlencoded")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="fromSummary" value="@Model.FromSummary.ToString().ToLower()" />

    @switch (Model.Question.Type)
    {
        case QuestionType.Radio:
            await Html.RenderPartialAsync("_Radio", Model);
            break;
        case QuestionType.FreeText:
            await Html.RenderPartialAsync("_FreeText", Model);
            break;
        case QuestionType.Date:
            await Html.RenderPartialAsync("_Date", Model);
            break;
        case QuestionType.FileUpload:
            await Html.RenderPartialAsync("_FileUpload", Model);
            break;
    }

    <govuk-button type="submit">Continue</govuk-button>
</form>
