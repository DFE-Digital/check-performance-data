@using DfE.CheckPerformanceData.Web.Controllers.Journey
@model QuestionPartialModel

@{
    var hintId = $"{Model.FieldName}-hint";
    var errorId = $"{Model.FieldName}-error";
    var containerId = $"{Model.FieldName}-container";
    var inputId = $"{Model.FieldName}-input";
    var suggestionsUrl = $"/{Model.Question.DataSource}/suggestions";
    var existingLabel = Model.ExistingAnswer?.TextValue ?? "";
}

<div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
    @if (Model.IsPageHeading)
    {
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="@inputId">@Model.ResolvedTitle</label>
        </h1>
    }
    else
    {
        <label class="govuk-label govuk-label--m" for="@inputId">@Model.ResolvedTitle</label>
    }
    @if (Model.Question.Hint is not null)
    {
        <div class="govuk-hint" id="@hintId">@Model.Question.Hint</div>
    }
    @if (Model.HasError)
    {
        <p class="govuk-error-message" id="@errorId">
            <span class="govuk-visually-hidden">Error:</span> @Model.Error
        </p>
    }

    @* Label hidden field — submitted as TextValue by ReadFormAnswer default case *@
    <input type="hidden" name="@Model.FieldName" id="@(Model.FieldName)-label-value" value="@existingLabel" />
    @* Code hidden field — available for downstream use. Re-rendered with the stored code
       (AB#295434): a hard-coded "" dropped the ISO code on every validation-error
       resubmit, leaving OriginCountryLanguageCapture's exact-name lookup to recover it. *@
    <input type="hidden" name="@(Model.FieldName)_code" id="@(Model.FieldName)-code-value" value="@(Model.ExistingAnswer?.CodeValue)" />

    <div id="@containerId"></div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var fieldName = '@Model.FieldName';
        var suggestionsUrl = @Json.Serialize(suggestionsUrl);
        var hasError = @(Model.HasError ? "true" : "false");
        var initialLabel = @Json.Serialize(existingLabel);
        var hintText = @Json.Serialize(Model.Question.Hint ?? "");
        var errorText = @Json.Serialize(Model.Error ?? "");
        var currentSuggestions = [];

        // accessible-autocomplete owns the input's aria-describedby (it points at its own
        // "#{id}__assistiveHint" element and rewrites it on every re-render), so passing
        // aria-describedby as an option is silently discarded. tAssistiveHint sets the text of
        // the element describedby already references, so the hint and error reach the same place.
        var assistiveHint = (errorText ? 'Error: ' + errorText + '. ' : '')
            + (hintText ? hintText + '. ' : '')
            + 'When autocomplete results are available use up and down arrows to review and '
            + 'enter to select. Touch device users, explore by touch or with swipe gestures.';

        var autocompleteConfig = {
            element: document.querySelector('#' + fieldName + '-container'),
            id: fieldName + '-input',
            name: fieldName + '-display',
            displayMenu: 'overlay',
            minLength: 2,
            inputClasses: 'govuk-input' + (hasError ? ' govuk-input--error' : ''),
            // Restore a previously selected value through the component, not the DOM
            // (AB#295434). defaultValue seeds accessible-autocomplete's internal state,
            // so its re-renders (focus, hover) keep the value and the menu stays closed.
            // A post-init DOM poke left that state empty and the next re-render wiped
            // the input, forcing the user to reselect.
            defaultValue: initialLabel,
            tAssistiveHint: function () { return assistiveHint; },
            source: function (query, populateResults) {
                fetch(suggestionsUrl + '?query=' + encodeURIComponent(query))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        currentSuggestions = data;
                        populateResults(data.map(function (d) { return d.label; }));
                    })
                    .catch(function () { populateResults([]); });
            },
            onConfirm: function (value) {
                var labelField = document.getElementById(fieldName + '-label-value');
                var codeField = document.getElementById(fieldName + '-code-value');
                if (!value) {
                    labelField.value = '';
                    codeField.value = '';
                    return;
                }
                var match = currentSuggestions.find(function (s) { return s.label === value; });
                labelField.value = value;
                codeField.value = match ? match.id : '';
            },
            confirmOnBlur: false
        };

        accessibleAutocomplete(autocompleteConfig);

        // AB#295434 follow-up: defaultValue restores the value and stops re-renders
        // from wiping it, but accessible-autocomplete hardcodes validChoiceMade: false
        // regardless of defaultValue, so its handleInputFocus still reopens the
        // suggestion menu the first time a restored field is focused. There is no
        // supported option to seed validChoiceMade. focus doesn't bubble but does
        // propagate during the capturing phase, so a document-level capturing listener
        // runs before the library's own focus handler (attached directly to the input,
        // at the AT_TARGET phase) and can stop that handler from ever seeing the event —
        // without touching the vendored library or blocking the actual browser focus.
        // The suppression lifts permanently, for this page load, the first time the
        // user edits the field.
        if (initialLabel) {
            var input = document.getElementById(fieldName + '-input');
            var restoredUnedited = true;
            input.addEventListener('input', function () { restoredUnedited = false; });
            document.addEventListener('focus', function (e) {
                if (restoredUnedited && e.target === input) {
                    e.stopImmediatePropagation();
                }
            }, true);
        }
    });
</script>
