@using DfE.CheckPerformanceData.Web.Controllers.Journey
@model QuestionPartialModel
@{
    var selected = Model.ExistingAnswer?.SelectedValues ?? [];
    // Only name ids this view actually emits: a dangling aria-describedby resolves to nothing
    // and silently drops the whole description, so a question with no hint would announce none.
    var describedBy = string.Join(" ", new[]
    {
        Model.Question.Hint is not null ? $"{Model.FieldName}-hint" : null,
        Model.HasError ? $"{Model.FieldName}-error" : null
    }.Where(id => id is not null));
}

<div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
    @* Razor drops an attribute whose value expression is null, which is exactly the rule
       needed here — no hint and no error means no aria-describedby at all. *@
    <fieldset class="govuk-fieldset" id="@Model.FieldName"
              aria-describedby="@(describedBy.Length > 0 ? describedBy : null)">
        @* The legend is the page heading when this is the page's only question — a separate
           <h1> would give the page two. *@
        <legend class="govuk-fieldset__legend @(Model.IsPageHeading ? "govuk-fieldset__legend--l" : "govuk-fieldset__legend--m")">
            @if (Model.IsPageHeading)
            {
                <h1 class="govuk-fieldset__heading">@Model.ResolvedTitle</h1>
            }
            else
            {
                @Model.ResolvedTitle
            }
        </legend>
        @if (Model.Question.Hint is not null)
        {
            <div class="govuk-hint" id="@(Model.FieldName)-hint">@Model.Question.Hint</div>
        }
        @if (Model.HasError)
        {
            <p class="govuk-error-message" id="@(Model.FieldName)-error">
                <span class="govuk-visually-hidden">Error:</span> @Model.Error
            </p>
        }
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            @* Options are filtered by visibleWhen; the server also rejects posted values for
               hidden options, and rejects the whole page if any one of them is hidden. *@
            @foreach (var option in Model.VisibleOptions)
            {
                var optionId = $"{Model.FieldName}-{option.Value}";
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input"
                           id="@optionId" name="@Model.FieldName" type="checkbox"
                           value="@option.Value" @(selected.Contains(option.Value) ? "checked" : "")>
                    <label class="govuk-label govuk-checkboxes__label" for="@optionId">@option.Label</label>
                    @if (option.SubLabel is not null)
                    {
                        <div id="@(optionId + "-item-hint")" class="govuk-hint govuk-checkboxes__hint">
                            @option.SubLabel
                        </div>
                    }
                </div>
            }
        </div>
    </fieldset>
</div>
