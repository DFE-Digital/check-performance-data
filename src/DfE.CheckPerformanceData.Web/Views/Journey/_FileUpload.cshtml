@using DfE.CheckPerformanceData.Web.Controllers.Journey
@using System.Text.Json
@model QuestionPartialModel

@if (Model.IsPageHeading)
{
    <h1 class="govuk-heading-xl">@Model.ResolvedTitle</h1>
}
else
{
    <h2 class="govuk-heading-m">@Model.ResolvedTitle</h2>
}

@* Visible to everyone, and deliberately NOT the file input's description (#389). Chrome
   exposes a native file input as a button, and JAWS directs the user to press a key to hear
   a button's description rather than reading it — which, when this paragraph was named by
   aria-describedby, was a detour to the sentence already on screen. Do not give it an id
   that QuestionPartialModel.DescribedBy could name. *@
@if (Model.Question.Hint is not null)
{
    <p class="govuk-body">@Model.Question.Hint</p>
}

@* ── Uploaded files table ────────────────────────────────────────────── *@

<table class="govuk-table govuk-!-margin-bottom-6">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Filename</th>
            <th scope="col" class="govuk-table__header">File size</th>
            <th scope="col" class="govuk-table__header">Pages</th>
            <th scope="col" class="govuk-table__header">Type</th>
            <th scope="col" class="govuk-table__header">Action</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var row in Model.UploadedFileRows)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    <a class="govuk-link"
                       asp-action="DownloadEvidence" asp-controller="Journey"
                       asp-route-windowId="@Model.WindowId"
                       asp-route-storedFileName="@row.File.StoredFileName">
                        @row.File.OriginalFileName
                    </a>
                </td>
                <td class="govuk-table__cell">@row.FormattedSize</td>
                <td class="govuk-table__cell">@row.File.PageCount</td>
                <td class="govuk-table__cell">PDF</td>
                <td class="govuk-table__cell">
                    @* Submits the surrounding page form; carries its file via the button value. *@
                    <button type="submit" name="storedFileName" value="@row.File.StoredFileName"
                            formaction="@Url.Action("RemoveFile", "Journey", new { windowId = Model.WindowId, pageId = Model.PageId, questionId = Model.Question.Id, fromSummary = Model.FromSummary })"
                            class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                        Remove<span class="govuk-visually-hidden"> @row.File.OriginalFileName</span>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* ── Upload form ─────────────────────────────────────────────────────── *@

@if (!Model.AtLimit)
{
    @* The file input and Upload button are part of the surrounding page form (which is
       multipart). The button posts to UploadFile via formaction so the page's text fields
       are submitted alongside the file. *@
    var fileError = Model.UploadError ?? Model.Error;
    <div class="govuk-form-group @(fileError is not null ? "govuk-form-group--error" : "")">
        @* The question title is the page heading, and the uploaded-files table sits between it
           and this input, so the input gets its own label rather than the heading doubling as
           one — a `for` reaching back over the table would name the field oddly and read out of
           order. Without this the input had no accessible name at all. *@
        <label class="govuk-label" for="fileUpload">Upload a file</label>
        @if (fileError is not null)
        {
            <p class="govuk-error-message" id="fileUpload-error">
                <span class="govuk-visually-hidden">Error:</span> @fileError
            </p>
        }
        <input class="govuk-file-upload @(fileError is not null ? "govuk-file-upload--error" : "")"
               id="fileUpload" name="fileUpload" type="file"
               accept=".pdf,application/pdf"
               aria-describedby="@Model.DescribedBy"
               data-existing-file-names="@JsonSerializer.Serialize(Model.ExistingFileNames)">
    </div>

    <govuk-button type="submit" class="govuk-button--secondary"
        formaction="@Url.Action("UploadFile", "Journey", new { windowId = Model.WindowId, pageId = Model.PageId, questionId = Model.Question.Id, fromSummary = Model.FromSummary })"
        formnovalidate="formnovalidate">Upload file</govuk-button>

    @* AB#304900: says the limit before the school reaches it. The upload control stays at the
       limit on purpose: a seventh file is refused by the server with a message, not prevented
       by taking the control away. FLAGGED copy (AB#304900). The id is named by
       QuestionPartialModel.DescribedBy, so the two must stay in step. *@
    <p class="govuk-body govuk-!-margin-top-2" id="fileUpload-count">
        @Model.UploadedFiles.Count of @Model.MaxEvidenceFiles files added.
    </p>
}
else
{
    <p class="govuk-body">
        <strong>Page limit reached.</strong> Remove a file to upload a different one.
    </p>
}

@* Decorative rule only — hidden from assistive technology so VoiceOver and TalkBack
   do not announce a separator that carries no meaning (audit #386). *@
<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" aria-hidden="true"/>
