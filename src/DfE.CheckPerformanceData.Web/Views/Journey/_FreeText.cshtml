@using DfE.CheckPerformanceData.Web.Controllers.Journey
@model QuestionPartialModel

@{
    var hintId = $"{Model.FieldName}-hint";
    var errorId = $"{Model.FieldName}-error";
    var describedBy = string.Join(" ",
        new[] { Model.Question.Hint is not null ? hintId : null, Model.HasError ? errorId : null }
        .Where(s => s is not null));

    // The GOV.UK character count component supports textareas only, so a single-line input gets
    // the plain maxlength attribute instead. GDS caution about maxlength — it truncates with no
    // feedback — does not bite for the questions that declare a limit today: a UPN, whose hint
    // already states the 13 characters, and a name capped at 150, which no real name reaches.
    // The server-side rule stays the enforcement; this only stops the overlong value being typed.
    var maxLength = Model.Question.CharacterLimit;
}

<div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
    @if (Model.IsPageHeading)
    {
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="@Model.FieldName">@Model.ResolvedTitle</label>
        </h1>
    }
    else
    {
        <label class="govuk-label govuk-label--m" for="@Model.FieldName">@Model.ResolvedTitle</label>
    }
    @if (Model.Question.Hint is not null)
    {
        <div class="govuk-hint" id="@hintId">@Model.Question.Hint</div>
    }
    @if (Model.HasError)
    {
        <p class="govuk-error-message" id="@errorId">
            <span class="govuk-visually-hidden">Error:</span> @Model.Error
        </p>
    }
    <input class="govuk-input govuk-input--width-20 @(Model.HasError ? "govuk-input--error" : "")"
           id="@Model.FieldName" name="@Model.FieldName" type="text"
           value="@Model.ExistingAnswer?.TextValue"
           @(maxLength.HasValue ? Html.Raw($"maxlength=\"{maxLength}\"") : Html.Raw(""))
           @(describedBy.Length > 0 ? $"aria-describedby=\"{describedBy}\"" : "")>
</div>
