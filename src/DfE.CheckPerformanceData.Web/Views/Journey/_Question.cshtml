@model DfE.CheckPerformanceData.Web.Controllers.Journey.QuestionPartialModel

@switch (Model.Question.Type)
{
    case QuestionType.Radio:
        await Html.RenderPartialAsync("_Radio", Model);
        break;
    case QuestionType.FreeText:
        await Html.RenderPartialAsync("_FreeText", Model);
        break;
    case QuestionType.Date:
        await Html.RenderPartialAsync("_Date", Model);
        break;
    case QuestionType.TextArea:
        await Html.RenderPartialAsync("_TextArea", Model);
        break;
    case QuestionType.Autocomplete:
        await Html.RenderPartialAsync("_Autocomplete", Model);
        break;
    case QuestionType.GradeSelect:
        await Html.RenderPartialAsync("_GradeSelect", Model);
        break;
    case QuestionType.SyllabusSelect:
        await Html.RenderPartialAsync("_SyllabusSelect", Model);
        break;
}

@if (Model.Question.QuestionHelpTitle is not null)
{
    <details class="govuk-details govuk-!-margin-top-6">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">@Model.Question.QuestionHelpTitle</span>
        </summary>
        <div class="govuk-details__text">
            @Html.Raw(@Model.Question.QuestionHelpText)
        </div>
    </details>
}



