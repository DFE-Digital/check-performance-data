@using DfE.CheckPerformanceData.Web.Controllers.Journey
@model QuestionPartialModel

@*
    The missing-qualification syllabus-code picker (AB#297848). A plain GOV.UK <select> with no
    JavaScript enhancement — no qualification in the reference data holds more than 7 syllabus
    codes, so there is nothing to search. Clone of _GradeSelect.cshtml with grade -> syllabus code
    substitutions; keep the two in step.

    Options come from the resolved qualification's QualList reference entry, each paired with its
    title (sibling codes often differ only by specialism). Nothing is preselected — the user must
    choose.
*@

@{
    var hintId = $"{Model.FieldName}-hint";
    var errorId = $"{Model.FieldName}-error";
    var unavailableId = $"{Model.FieldName}-unavailable";
    var describedBy = string.Join(" ", new[]
        {
            Model.Question.Hint is not null ? hintId : null,
            Model.SyllabusOptionsUnavailable ? unavailableId : null,
            Model.HasError ? errorId : null
        }.Where(s => s is not null));
}

<div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
    @if (Model.IsPageHeading)
    {
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="@Model.FieldName">@Model.ResolvedTitle</label>
        </h1>
    }
    else
    {
        <label class="govuk-label govuk-label--m" for="@Model.FieldName">@Model.ResolvedTitle</label>
    }

    @if (Model.Question.Hint is not null)
    {
        <div class="govuk-hint" id="@hintId">@Model.Question.Hint</div>
    }

    @if (Model.SyllabusOptionsUnavailable)
    {
        @* A reference-data gap, not a user error — so it is stated plainly rather than as a
           validation failure. Validation still holds the enquiry back, because a syllabus code
           nobody can confirm is valid is worse than no enquiry. FLAGGED: copy needs content sign-off. *@
        <div class="govuk-inset-text" id="@unavailableId">We cannot list syllabus codes for this qualification yet</div>
    }

    @if (Model.HasError)
    {
        <p class="govuk-error-message" id="@errorId">
            <span class="govuk-visually-hidden">Error:</span> @Model.Error
        </p>
    }

    <select class="govuk-select @(Model.HasError ? "govuk-select--error" : "")"
            id="@Model.FieldName" name="@Model.FieldName"
            aria-describedby="@(describedBy.Length > 0 ? describedBy : null)">
        <option value="">@(Model.Question.SelectPlaceholder ?? "Select")</option>
        @foreach (var option in Model.VisibleOptions)
        {
            <option value="@option.Value" selected="@(option.Value == Model.ExistingAnswer?.TextValue)">@option.Label</option>
        }
    </select>
</div>
