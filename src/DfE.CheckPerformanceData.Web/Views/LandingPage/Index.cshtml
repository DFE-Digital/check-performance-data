@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.LandingPageViewModel

@{
    ViewBag.Title = "Check Performance Data - Check Data";
    Layout = "_Layout";
}

@if (Model.NoDataWindowsText != null)
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Important</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading" style="max-width: none;">Your school has no @Model.NoDataWindowsText pupil data to check in this window</p>
        <p>If you think this is wrong, you can <a href="#">send us a message</a> or call us on 0300 131 2768</p>
    </govuk-notification-banner>
}

@if (Model.NotValidWindowsText != null)
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Important</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading" style="max-width: none;">Your school does not need to take part in the @Model.NotValidWindowsText checking exercise.</p>
        <p class="govuk-body">If you think this is wrong, you can <a href="#" class="govuk-notification-banner__link">send us a message</a> or call us on 0300 131 2768</p>
    </govuk-notification-banner>
}

<h1 class="govuk-heading-xl">@Model.OrganisationName</h1>

<div class="school-details">
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationAddress</dd>
        </div>

        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Establishment LAESTAB</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationLaestab</dd>
        </div>

        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Establishment URN</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationUrn</dd>
        </div>
    </dl>
</div>

@if (Model.OpenWindows.Any())
{
    <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">
    <h2 class="govuk-heading-m">Check data</h2>
    <div class="dfe-grid-container">
        @foreach (var openWindow in Model.OpenWindows)
        {
            <div class="dfe-card">
                <div class="dfe-card-container">
                    <h3 class="govuk-heading-m">@openWindow.Title</h3>

                    <p><strong>You have until @openWindow.EndTime on @openWindow.EndDate to review your data.</strong></p>

                    <div>
                        <a asp-action="Index" asp-controller="CheckYourPupilData" asp-route-windowId="@openWindow.Id"
                           role="button" class="govuk-button">
                            Continue
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
