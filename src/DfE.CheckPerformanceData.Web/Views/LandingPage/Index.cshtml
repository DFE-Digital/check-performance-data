@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.LandingPageViewModel

@{
    // Matches the <h1>, which is the school name.
    ViewBag.Title = Model.OrganisationName;
    Layout = "_Layout";
}

@* One banner per window, not one sentence listing several: the noun below is the window's own,
   and a school with both a KS4 and a 16-19 window would otherwise need two words in one sentence. *@
@foreach (var window in Model.NoDataWindows)
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Important</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading" style="max-width: none;">Your school has no @window.Title @window.LearnerNoun.Singular data to check in this window</p>
        <p>If you think this is wrong, you can <a href="/contact">send us a message</a> or call us on 0300 131 2768</p>
    </govuk-notification-banner>
}

@foreach (var window in Model.NotValidWindows)
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Important</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading" style="max-width: none;">Your school does not need to take part in the @window.Title checking exercise.</p>
        <p class="govuk-body">If you think this is wrong, you can <a href="/contact" class="govuk-notification-banner__link">send us a message</a> or call us on 0300 131 2768</p>
    </govuk-notification-banner>
}

<h1 class="govuk-heading-xl">@Model.OrganisationName</h1>

<div class="school-details">
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationAddress</dd>
        </div>

        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Establishment LAESTAB</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationLaestab</dd>
        </div>

        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Establishment URN</dt>
            <dd class="govuk-summary-list__value">@Model.OrganisationUrn</dd>
        </div>
    </dl>
</div>

@if (Model.OpenWindows.Any())
{
    @* Decorative rule: the <h2> below already marks the section boundary, so the separator
       role only adds noise for VoiceOver and TalkBack (audit #386). *@
    <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible" aria-hidden="true">
    <h2 class="govuk-heading-m">Check data</h2>
    <div class="dfe-grid-container">
        @foreach (var openWindow in Model.OpenWindows)
        {
            <div class="dfe-card">
                <div class="dfe-card-container">
                    <h3 class="govuk-heading-m">@openWindow.Title</h3>

                    <p><strong>You have until @openWindow.EndTime on @openWindow.EndDate to review your data.</strong></p>

                    <div>
                        @* One card per open window, each with a button reading only "Continue".
                           Tabbing or listing buttons gives no way to tell them apart, so the
                           window title goes in as hidden text (audit #379). *@
                        <a draggable="false" data-module="govuk-button" asp-action="Index" asp-controller="CheckYourPupilData" asp-route-windowId="@openWindow.Id"
                           role="button" class="govuk-button">
                            Continue<span class="govuk-visually-hidden"> to @openWindow.Title</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
