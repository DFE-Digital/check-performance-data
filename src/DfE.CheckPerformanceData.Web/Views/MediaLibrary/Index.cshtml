@using DfE.CheckPerformanceData.Application.Media.Upload
@using DfE.CheckPerformanceData.Web.Common
@using DfE.CheckPerformanceData.Web.Controllers
@using DfE.CheckPerformanceData.Web.Controllers.ViewModels.Media
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.Media.MediaLibraryIndexViewModel
@{
    @* The full-width admin layout, so the grid shows more images in each row. The flag, not the
       _AdminWideLayout wrapper, because the wrapper does not pass on the Scripts section. *@
    ViewData["AdminWide"] = true;
    ViewData["Title"] = Model.Heading;
    var library = Model.Page;
    // One message per problem: no file chosen, or a refused file with its name.
    var uploadErrors = Model.UploadResults
        .Where(r => r.Outcome == MediaUploadOutcome.Rejected)
        .Select(r => $"{r.FileName}: {r.Rejection}")
        .Prepend(Model.UploadError)
        .OfType<string>()
        .ToList();
    var hasUploadErrors = uploadErrors.Count > 0;
    var hasErrors = hasUploadErrors || Model.NewFolderError is not null || Model.MoveError is not null;
    if (hasErrors) ViewData["HasError"] = true;
    var maxFile = MediaFileSize.Format(MediaUploadLimits.MaxFileBytes);
    var maxRequest = MediaFileSize.Format(MediaLibraryController.MaxUploadRequestBytes);
    // Zero-based for PaginationWindow; the list and its links are 1-based.
    var currentIndex = library.Page - 1;
    var path = Model.FolderPath;
    var currentPath = Model.Folders.PathText(Model.Folder?.Id);
    // "‘Photos / Schools’", or "the top of the library".
    var here = Model.Folder is null ? "the top of the library" : $"‘{currentPath}’";
    var emptyMessage = Model.IsFiltered && (!string.IsNullOrEmpty(Model.Search) || Model.MissingAlt || Model.Unused)
        ? "No images match your search and filters."
        : Model.Folder is not null ? "This folder has no images."
        : !Model.IncludeSubfolders ? "No images are at the top of the library. The images are in folders."
        : "The media library is empty.";
}

@section Breadcrumbs {
    @* The folder path. Rendered before <main> by the admin layout, as the GOV.UK pattern asks. *@
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb" data-media-breadcrumbs>
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/admin">Administration</a></li>
            @if (Model.Folder is null)
            {
                <li class="govuk-breadcrumbs__list-item" aria-current="page">Media library</li>
            }
            else
            {
                <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Model.FolderUrl(null)">Media library</a></li>
                @foreach (var step in path)
                {
                    if (step.Id == Model.Folder.Id)
                    {
                        <li class="govuk-breadcrumbs__list-item" aria-current="page">@step.Name</li>
                    }
                    else
                    {
                        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Model.FolderUrl(step.Id)">@step.Name</a></li>
                    }
                }
            }
        </ol>
    </nav>
}

@if (TempData[MediaLibraryController.SuccessKey] is string done)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="media-banner-title" data-module="govuk-notification-banner" data-media-success>
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="media-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@done</p>
        </div>
    </div>
}

@* The script fills this summary for files refused during a script upload; after a plain form
   post the server renders it. Each error links to its own control. *@
<div class="govuk-error-summary" data-module="govuk-error-summary" data-media-upload-errors @(hasErrors ? "" : "hidden")>
    <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list" data-media-upload-error-list>
                @foreach (var error in uploadErrors)
                {
                    <li><a href="#files">@error</a></li>
                }
                @if (Model.NewFolderError is not null)
                {
                    <li data-media-new-folder-error-link><a href="#new-folder-name">@Model.NewFolderError</a></li>
                }
                @if (Model.MoveError is not null)
                {
                    <li data-media-move-error-link><a href="#move-target">@Model.MoveError</a></li>
                }
            </ul>
        </div>
    </div>
</div>

@if (Model.Folder is null)
{
    <h1 class="govuk-heading-xl">Media library</h1>
}
else
{
    <span class="govuk-caption-xl">Media library folder</span>
    <h1 class="govuk-heading-xl" data-media-folder-heading>@Model.Folder.Name</h1>
}

@if (Model.Folder is null)
{
    <p class="govuk-body">Upload images once and reuse them on any page.</p>

    <p class="govuk-body">
        Older pages can hold images saved inside their text.
        <a class="govuk-link" href="/admin/media/move-embedded" data-media-move-embedded-link>Move embedded images into the library</a>.
    </p>

    <h2 class="govuk-heading-m">Reports</h2>
    <ul class="govuk-list" data-media-reports>
        <li><a class="govuk-link" href="/admin/media/reports/alt-text" data-media-alt-text-report-link>Alt text report</a> – images with missing or weak alt text</li>
        <li><a class="govuk-link" href="/admin/media/reports/size" data-media-size-report-link>Size report</a> – the largest images and the storage the library uses</li>
    </ul>
}

@* The folders directly inside this one, and a form to add one. Each folder link keeps the view. *@
<h2 class="govuk-heading-m">Folders</h2>
@if (Model.Subfolders.Count == 0)
{
    <p class="govuk-body" data-media-no-folders>@(Model.Folder is null ? "The library has no folders yet." : "This folder has no folders inside it.")</p>
}
else
{
    <ul class="govuk-list app-media-folders" data-media-folders>
        @foreach (var sub in Model.Subfolders)
        {
            <li data-media-folder="@sub.Id"><a class="govuk-link" href="@Model.FolderUrl(sub.Id)">@sub.Name</a></li>
        }
    </ul>
}
@if (Model.Folder is not null)
{
    <p class="govuk-body">
        <a class="govuk-link" href="@MediaFolderViewModel.FolderSettingsUrl(Model.Folder.Id)" data-media-folder-settings-link>Rename, move or delete this folder</a>
    </p>
}
<form method="post" action="/admin/media/folders" data-media-new-folder-form novalidate>
    @Html.AntiForgeryToken()
    @if (Model.Folder is not null)
    {
        <input type="hidden" name="parent" value="@Model.Folder.Id" />
    }
    <div class="govuk-form-group @(Model.NewFolderError is null ? "" : "govuk-form-group--error")">
        <label class="govuk-label govuk-label--s" for="new-folder-name">Create a folder @(Model.Folder is null ? "in the library" : $"in ‘{Model.Folder.Name}’")</label>
        @if (Model.NewFolderError is not null)
        {
            <p id="new-folder-name-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.NewFolderError</p>
        }
        <div class="app-media-folder-create">
            <input class="govuk-input govuk-input--width-20 @(Model.NewFolderError is null ? "" : "govuk-input--error")" id="new-folder-name" name="name" type="text"
                   value="@Model.NewFolderName" maxlength="100" spellcheck="false"
                   @(Model.NewFolderError is null ? "" : "aria-describedby=new-folder-name-error") />
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true" data-media-new-folder-submit>Create folder</button>
        </div>
    </div>
</form>

<form id="media-upload-form" method="post" enctype="multipart/form-data" action="@Model.UploadUrl"
      data-max-bytes="@MediaUploadLimits.MaxFileBytes" data-too-large-message="@MediaRejections.TooLarge">
    @Html.AntiForgeryToken()
    <h2 class="govuk-heading-m">Upload images</h2>
    <div class="govuk-form-group @(hasUploadErrors ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="files">Images</label>
        <div id="files-hint" class="govuk-hint">
            PNG, JPEG, GIF, WebP or SVG. Each file must be smaller than @maxFile.
            You can choose more than one file. Together they must be smaller than @maxRequest.
            New images go into @here.
        </div>
        @if (hasUploadErrors)
        {
            <p id="files-error" class="govuk-error-message">
                @foreach (var error in uploadErrors)
                {
                    <span class="govuk-visually-hidden">Error:</span> @error<br />
                }
            </p>
        }
        @* GOV.UK's JavaScript-enhanced File upload adds the drop zone. It moves id="files" to its
           button (the error summary's link target) and hides this input, so the upload script
           reaches the input by its name. *@
        <div class="govuk-file-upload-wrapper" data-module="govuk-file-upload">
            <input class="govuk-file-upload" id="files" name="files" type="file" multiple
                   accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml,.svg"
                   aria-describedby="files-hint@(hasUploadErrors ? " files-error" : "")" />
        </div>
    </div>
    <button type="submit" class="govuk-button" data-prevent-double-click="true" data-media-upload-submit>Upload</button>
</form>

@* Progress and results. role="status" announces each file's start and end; the list keeps a
   row per file with its own progress bar while the script uploads. *@
<div class="govuk-body" role="status" aria-live="polite" data-media-upload-status></div>
<ul class="govuk-list app-media-upload-results" data-media-upload-results>
    @foreach (var result in Model.UploadResults)
    {
        <li class="app-media-upload-result" data-media-upload-result="@result.OutcomeName">
            @switch (result.Outcome)
            {
                case MediaUploadOutcome.Created:
                    <strong class="govuk-tag govuk-tag--green">Uploaded</strong>
                    <a class="govuk-link" href="@result.DetailUrl">@result.FileName</a>
                    break;
                case MediaUploadOutcome.Duplicate:
                    <strong class="govuk-tag govuk-tag--yellow">Already in the library</strong>
                    <span>This image is already in the library as @result.ExistingFileName.</span>
                    <a class="govuk-link" href="@result.DetailUrl">Use the existing image<span class="govuk-visually-hidden"> for @result.FileName</span></a>
                    break;
                default:
                    <strong class="govuk-tag govuk-tag--red">Not uploaded</strong>
                    <span>@result.FileName: @result.Rejection</span>
                    break;
            }
        </li>
    }
</ul>

<h2 class="govuk-heading-m">Find images</h2>
<form method="get" action="/admin/media" class="app-media-filters" data-media-library-filters>
    @if (Model.Folder is not null)
    {
        <input type="hidden" name="folder" value="@Model.Folder.Id" />
    }
    <div class="govuk-form-group">
        <label class="govuk-label" for="search">Search by file name, alt text or tag</label>
        <input class="govuk-input govuk-!-width-two-thirds" id="search" name="search" type="search" value="@Model.Search" />
    </div>
    @* Ticked by default. A ticked box sends true before the hidden false, and the first value
       wins; an unticked box sends only the false. *@
    <div class="govuk-form-group">
        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="subfolders" name="subfolders" type="checkbox" value="true"
                       aria-describedby="subfolders-hint" @(Model.IncludeSubfolders ? "checked" : "") data-media-include-subfolders />
                <label class="govuk-label govuk-checkboxes__label" for="subfolders">Include subfolders</label>
                <div id="subfolders-hint" class="govuk-hint govuk-checkboxes__hint">
                    @(Model.Folder is null
                        ? "Untick to find only the images that are in no folder."
                        : $"Untick to find only the images in ‘{Model.Folder.Name}’ itself.")
                </div>
            </div>
        </div>
        <input type="hidden" name="subfolders" value="false" />
    </div>
    <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Show only</legend>
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" id="missingAlt" name="missingAlt" type="checkbox" value="true" @(Model.MissingAlt ? "checked" : "") />
                    <label class="govuk-label govuk-checkboxes__label" for="missingAlt">Missing alt text</label>
                </div>
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" id="unused" name="unused" type="checkbox" value="true" @(Model.Unused ? "checked" : "") />
                    <label class="govuk-label govuk-checkboxes__label" for="unused">Not used on any page</label>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="sort">Sort by</label>
        <select class="govuk-select" id="sort" name="sort">
            <option value="newest" selected="@(Model.Sort == "newest")">Newest first</option>
            <option value="name" selected="@(Model.Sort == "name")">File name (A to Z)</option>
        </select>
    </div>
    <input type="hidden" name="view" value="@Model.View" />
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button govuk-button--secondary">Apply</button>
        @if (Model.IsFiltered)
        {
            <a class="govuk-link" href="@Model.ClearFiltersUrl">Clear search and filters</a>
        }
    </div>
</form>

@* The view keeps the folder, search, filters and sort, and goes back to the first page. site.js
   submits the form when the select changes (data-auto-submit); without JavaScript the button does. *@
<form method="get" action="/admin/media" data-media-library-view-form>
    @if (Model.Folder is not null)
    {
        <input type="hidden" name="folder" value="@Model.Folder.Id" />
    }
    @if (!Model.IncludeSubfolders)
    {
        <input type="hidden" name="subfolders" value="false" />
    }
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <input type="hidden" name="search" value="@Model.Search" />
    }
    @if (Model.MissingAlt)
    {
        <input type="hidden" name="missingAlt" value="true" />
    }
    @if (Model.Unused)
    {
        <input type="hidden" name="unused" value="true" />
    }
    <input type="hidden" name="sort" value="@Model.Sort" />
    <div class="govuk-form-group">
        <label class="govuk-label" for="view">View</label>
        <select class="govuk-select" id="view" name="view" data-auto-submit="true">
            @foreach (var option in MediaLibraryView.All)
            {
                <option value="@option.Value" selected="@(option.Value == Model.View)">@option.Label</option>
            }
        </select>
        <noscript><button type="submit" class="govuk-button govuk-button--secondary">Show</button></noscript>
    </div>
</form>

@* The upload script reloads this region after its uploads finish, so new images appear. The
   region is one form: each image has a check box, and "Move selected images" moves the ticked ones. *@
<div data-media-library-region>
    @if (library.TotalCount == 0)
    {
        <p class="govuk-body" data-media-library-empty>@emptyMessage</p>
    }
    else
    {
        <p class="govuk-body" data-media-library-count>
            Showing @((library.Page - 1) * library.PageSize + 1) to @((library.Page - 1) * library.PageSize + library.Items.Count) of @library.TotalCount images.
        </p>
        @* Nothing deletes unused images by itself. With the "Not used on any page" filter on, the
           editor can delete the ones that match the search in this folder, after a confirmation page. *@
        @if (Model.Unused)
        {
            <a href="@Model.DeleteUnusedUrl" role="button" draggable="false" class="govuk-button govuk-button--warning"
               data-module="govuk-button" data-media-delete-unused-link>Delete unused images</a>
        }
        <form method="post" action="/admin/media/move" data-media-move-form novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.PageUrl(library.Page)" />
            <div class="govuk-form-group app-media-move @(Model.MoveError is null ? "" : "govuk-form-group--error")">
                <label class="govuk-label" for="move-target">Move selected images to</label>
                <div id="move-target-hint" class="govuk-hint">Tick the images to move, then choose a folder.</div>
                @if (Model.MoveError is not null)
                {
                    <p id="move-target-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.MoveError</p>
                }
                <div class="app-media-folder-create">
                    <select class="govuk-select @(Model.MoveError is null ? "" : "govuk-select--error")" id="move-target" name="target"
                            aria-describedby="move-target-hint@(Model.MoveError is null ? "" : " move-target-error")">
                        <option value="">Choose a folder</option>
                        <option value="@MediaLibraryController.TopLevel">Media library (top level)</option>
                        @foreach (var option in Model.FolderOptions)
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true" data-media-move-submit>Move selected images</button>
                </div>
            </div>
        @switch (Model.View)
        {
            case MediaLibraryView.Details:
                <table class="govuk-table app-media-details" data-media-library-table>
                    <caption class="govuk-table__caption govuk-table__caption--m">Images</caption>
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Select</span></th>
                            <th scope="col" class="govuk-table__header">Image</th>
                            <th scope="col" class="govuk-table__header">Name</th>
                            <th scope="col" class="govuk-table__header">Details</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="govuk-table__row" data-media-item="@item.Id">
                                <td class="govuk-table__cell">
                                    <partial name="_MediaLibrarySelect" model="item" />
                                </td>
                                <td class="govuk-table__cell app-media-details__thumb">
                                    @* The file name is the link text, so the thumbnail adds nothing for a screen reader. *@
                                    <img src="@item.ThumbnailUrl" alt="" loading="lazy" decoding="async" class="app-media-details__img" />
                                </td>
                                <td class="govuk-table__cell app-media-details__name">
                                    <a class="govuk-link" href="@item.DetailUrl">@item.FileName</a>
                                </td>
                                <td class="govuk-table__cell">
                                    <partial name="_MediaLibraryItemFacts" model="item" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;
            case MediaLibraryView.Large:
                <ul class="govuk-list app-media-large" data-media-library-large>
                    @foreach (var item in Model.Items)
                    {
                        <li class="app-media-large__item" data-media-item="@item.Id">
                            <h3 class="govuk-heading-s app-media-large__name">
                                <a class="govuk-link" href="@item.DetailUrl">@item.FileName</a>
                            </h3>
                            <partial name="_MediaLibrarySelect" model="item" />
                            @* The file name is the link text, and the facts below give the alt text. *@
                            <img src="@item.LargeUrl" alt="" loading="lazy" decoding="async"
                                 class="@(item.IsShownAsStored ? "app-media-large__img app-media-large__img--fixed" : "app-media-large__img")" />
                            <partial name="_MediaLibraryItemFacts" model="item" />
                        </li>
                    }
                </ul>
                break;
            default:
            <ul class="govuk-list app-media-grid" data-media-library-list>
                @foreach (var item in Model.Items)
                {
                    <li class="app-media-grid__item" data-media-item="@item.Id">
                        <a class="govuk-link app-media-grid__link" href="@item.DetailUrl">
                            <span class="app-media-grid__thumb">
                                @* The file name is the link text, so the thumbnail adds nothing for a screen reader. *@
                                <img src="@item.ThumbnailUrl" alt="" loading="lazy" decoding="async"
                                     class="@(item.IsShownAsStored ? "app-media-grid__img app-media-grid__img--fixed" : "app-media-grid__img")" />
                            </span>
                            <span class="app-media-grid__name">@item.FileName</span>
                        </a>
                        <span class="govuk-body-s app-media-grid__meta">
                            @if (item.Dimensions is not null)
                            {
                                @item.Dimensions<br />
                            }
                            @item.Size
                            @if (item.Folder != currentPath)
                            {
                                <br /><span data-media-item-folder>In @(item.Folder.Length == 0 ? "the top of the library" : item.Folder)</span>
                            }
                        </span>
                        @if (item.MissingAltText)
                        {
                            <strong class="govuk-tag govuk-tag--yellow" data-media-missing-alt>No alt text</strong>
                        }
                        @if (item.HasVariants)
                        {
                            <a class="govuk-link govuk-body-s app-media-variant-badge" href="@item.VariantsUrl" data-media-variant-count="@item.Variants">Used in @item.Variants ways<span class="govuk-visually-hidden">: crops and sizes of @item.FileName</span></a>
                        }
                        <partial name="_MediaLibrarySelect" model="item" />
                    </li>
                }
            </ul>
                break;
        }
        </form>

        @if (library.TotalPages > 1)
        {
            <govuk-pagination>
                @if (currentIndex > 0)
                {
                    <govuk-pagination-previous href="@Model.PageUrl(library.Page - 1)" />
                }
                @foreach (var index in PaginationWindow.Build(currentIndex, library.TotalPages))
                {
                    if (index is null)
                    {
                        <govuk-pagination-ellipsis />
                    }
                    else
                    {
                        <govuk-pagination-item href="@Model.PageUrl(index.Value + 1)" current="@(index.Value == currentIndex)">@(index.Value + 1)</govuk-pagination-item>
                    }
                }
                @if (currentIndex < library.TotalPages - 1)
                {
                    <govuk-pagination-next href="@Model.PageUrl(library.Page + 1)" />
                }
            </govuk-pagination>
        }
    }
</div>

@section Scripts {
    <script src="~/js/media-library-upload.js" defer asp-append-version="true"></script>
}
