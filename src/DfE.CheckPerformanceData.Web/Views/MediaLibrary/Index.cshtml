@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.Media.MediaLibraryIndexViewModel
@{
    ViewData["Title"] = "Media library";
    var library = Model.Page;
}

<a href="/admin" class="govuk-back-link">Back to administration</a>

<h1 class="govuk-heading-xl">Media library</h1>

<p class="govuk-body">Upload images once and reuse them on any page.</p>

@if (library.TotalCount == 0)
{
    <p class="govuk-body" data-media-library-empty>The media library is empty.</p>
}
else
{
    <p class="govuk-body">Showing @library.Items.Count of @library.TotalCount images, most recently changed first.</p>
    <table class="govuk-table" data-media-library-list>
        <caption class="govuk-table__caption govuk-visually-hidden">Images in the media library</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">File name</th>
                <th scope="col" class="govuk-table__header">Alt text</th>
                <th scope="col" class="govuk-table__header">Version</th>
                <th scope="col" class="govuk-table__header">Last updated (UTC)</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var item in library.Items)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@item.FileName</td>
                    <td class="govuk-table__cell">@(item.DefaultAltText ?? "None")</td>
                    <td class="govuk-table__cell">@item.CurrentVersion</td>
                    <td class="govuk-table__cell">@item.UpdatedAtUtc.ToString("d MMM yyyy, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
