@using DfE.CheckPerformanceData.Application.Media.Embedded
@model EmbeddedImageMoveResult
@{
    ViewData["Title"] = "Embedded images moved";
}
@functions {
    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";
}

<a href="/admin/media" class="govuk-back-link">Back to the media library</a>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Embedded images moved</h1>

        <p class="govuk-body" data-move-embedded-result
           data-pages-changed="@Model.PagesChanged" data-images-moved="@Model.ImagesMoved"
           data-images-created="@Model.ImagesCreated" data-duplicates-reused="@Model.DuplicatesReused">
            Moved @Plural(Model.ImagesMoved, "image", "images") on @Plural(Model.PagesChanged, "page", "pages").
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Plural(Model.ImagesCreated, "new image was", "new images were") added to the media library.</li>
            <li>@Plural(Model.DuplicatesReused, "image was", "images were") already in the library, so the pages use the existing image.</li>
        </ul>

        @if (Model.Failures.Count > 0)
        {
            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <strong class="govuk-warning-text__text">
                    <span class="govuk-visually-hidden">Warning</span>
                    @Plural(Model.Failures.Count, "page was", "pages were") left as they were.
                </strong>
            </div>
        }
    </div>
</div>

@if (Model.Failures.Count > 0)
{
    <table class="govuk-table" data-move-embedded-failures>
        <caption class="govuk-table__caption govuk-table__caption--m">Pages left as they were</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Page</th>
                <th scope="col" class="govuk-table__header">Why</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var failure in Model.Failures)
            {
                <tr class="govuk-table__row" data-move-embedded-failure="@failure.Page.NodeId">
                    <td class="govuk-table__cell">
                        <a class="govuk-link" href="/admin/pages/@failure.Page.NodeId/edit">@failure.Page.Title</a>
                    </td>
                    <td class="govuk-table__cell">
                        <ul class="govuk-list">
                            @foreach (var reason in failure.Reasons)
                            {
                                <li>@reason.Image: @reason.Reason</li>
                            }
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="govuk-body">
    <a class="govuk-link" href="/admin/media/move-embedded">Check for embedded images again</a>
</p>
