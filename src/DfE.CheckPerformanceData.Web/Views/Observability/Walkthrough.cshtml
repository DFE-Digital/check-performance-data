@using System.Text.Json
@model DfE.CheckPerformanceData.Web.Models.Observability.WalkthroughViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Replay walkthrough";

    var stages = DfE.CheckPerformanceData.Web.Models.Observability.PipelineStages.Ordered;

    // The cohort data the JS drives: each selected reference's ordered board-stage keys. The engine
    // tracks a step index per item and re-renders the items under their current stage on each step.
    var cohort = Model.Items.Select(i => new
    {
        reference = i.ReferenceNumber,
        stageKeys = i.StageKeys,
        decision = i.LatestDecision,
    });
    var cohortJson = JsonSerializer.Serialize(cohort);
}

<link rel="stylesheet" href="~/css/observability.css" asp-append-version="true" />

<a class="govuk-back-link" href="/admin/observability/submissions">Back to submissions</a>

<h1 class="govuk-heading-xl">Replay walkthrough</h1>

@if (Model.Items.Count == 0)
{
    <p class="govuk-body">
        No submissions were selected, or the selected references have no recorded events.
        <a class="govuk-link" href="/admin/observability/submissions">Choose submissions to replay</a>.
    </p>
}
else
{
    <p class="govuk-body-l">
        Following @Model.Items.Count submission@(Model.Items.Count == 1 ? "" : "s") through the pipeline.
        Use <strong>Single step</strong> to advance the cohort one stage at a time, or <strong>Play</strong>
        to step automatically. The active items are highlighted at their current stage.
    </p>

    <div class="obs-walkthrough" data-replay-walkthrough data-cohort="@cohortJson">
        <div class="govuk-button-group obs-walkthrough__controls">
            <button type="button" class="govuk-button" data-module="govuk-button" data-replay-step>
                Single step
            </button>
            <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                    data-replay-autoplay aria-pressed="false">
                Play
            </button>
            <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-replay-reset>
                Reset
            </button>
        </div>

        <p class="govuk-body-s" data-replay-progress aria-live="polite">Step 0.</p>

        @* Five stage columns. The JS drops each cohort item into its current stage column and marks
           the column active when it holds an item; with JS off the server-rendered start positions
           (every item at its first stage) still read sensibly. *@
        <ol class="obs-walkthrough__stages" role="list">
            @foreach (var (key, label) in stages)
            {
                <li class="obs-walkthrough__stage" data-stage="@key">
                    <h2 class="govuk-heading-s obs-walkthrough__stage-label">@label</h2>
                    <ul class="govuk-list obs-walkthrough__items" data-stage-items="@key"></ul>
                </li>
            }
        </ol>
    </div>

    <script src="~/js/observability-replay-walkthrough.js" asp-append-version="true"></script>
}
