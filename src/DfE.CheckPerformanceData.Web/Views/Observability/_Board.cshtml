@model DfE.CheckPerformanceData.Web.Models.Observability.DashboardViewModel
@{
    // The five pipeline stages, left to right. Each stage carries a token so its state is
    // conveyed by position + colour + shape + text — never colour alone — so a reduced-motion or
    // paused render stays fully legible. Depth-bearing stages map to the two working queues.
    var rulesDepth = Model.Depths.FirstOrDefault(d => d.QueueName == "rules-engine")?.Depth ?? 0;
    var zendeskDepth = Model.Depths.FirstOrDefault(d => d.QueueName == "zendesk")?.Depth ?? 0;

    // The board is now pure board: the replay scrubber and the dev-only demo controls (slow-mo /
    // single-step / demo trickle / inject) moved into the dashboard's collapsible Demo panel
    // (_DemoPanel.cshtml). The board JS finds those control hooks at the document level, so they
    // drive this same renderer from wherever they are rendered.

    var stages = new[]
    {
        new { Key = "submit", Label = "Submit", Count = (int?)null },
        new { Key = "rules-queue", Label = "Rules-queue", Count = (int?)rulesDepth },
        new { Key = "rules-engine", Label = "Rules engine", Count = (int?)null },
        new { Key = "zendesk-queue", Label = "Zendesk-queue", Count = (int?)zendeskDepth },
        new { Key = "ticket", Label = "Zendesk ticket", Count = (int?)null },
    };

    // The destination row that sits below the lane after the Rules engine: the three decision
    // outcomes a message can reach, plus the dead-letter queue for failed/injected messages. An
    // envelope routes into the box matching its decisionStatus; the value is also the engine's key
    // (data-obs-decision) so it can anchor to and activate the box as envelopes land.
    var decisions = new[]
    {
        new { Key = "AutoApproved", Label = "Auto-approved" },
        new { Key = "AutoRejected", Label = "Auto-rejected" },
        new { Key = "Scrutiny", Label = "Scrutiny" },
    };
}

<section class="obs-board" aria-label="Live workflow board" data-obs-board
         data-stream-url="/admin/observability/stream"
         data-inspect-url="/admin/observability/inspect"
         data-replay-url="/admin/observability/replay">

    @* The server-rendered skeleton: labelled stage nodes connected left to right. The JS engine
       animates envelope tokens between these nodes from the live feed; with JS off or motion
       reduced the skeleton and the textual parallel below convey the same information. A
       dead-letter marker sits below the lane for failed messages to park at. *@
    <ol class="obs-board__lanes" role="list">
        @for (var i = 0; i < stages.Length; i++)
        {
            var stage = stages[i];
            <li class="obs-board__lane" data-stage="@stage.Key">
                <span class="obs-board__node" aria-hidden="true"></span>
                <span class="obs-board__label">@stage.Label</span>
                @if (stage.Count.HasValue)
                {
                    <span class="obs-board__count" data-stage-count="@stage.Key">@stage.Count waiting</span>
                }
                @if (i < stages.Length - 1)
                {
                    <span class="obs-board__connector" aria-hidden="true">→</span>
                }
            </li>
        }
    </ol>

    @* The decision-destination row, sitting after the Rules engine: the three decision outcomes a
       decided message routes into, plus the dead-letter queue a failed/injected message parks at.
       Each box reuses the dead-letter marker's structure and lights up as envelopes land in it. A
       decided (non-failed) envelope passes through its decision box and continues to the Zendesk
       ticket; a failed one is terminal at the dead-letter queue. *@
    <div class="obs-board__destinations" data-obs-destinations>
        @foreach (var decision in decisions)
        {
            <div class="obs-board__dlq obs-board__decision" data-obs-decision="@decision.Key" aria-hidden="true">
                <span class="obs-board__dlq-node"></span>
                <span class="obs-board__dlq-label">@decision.Label</span>
            </div>
        }
        <div class="obs-board__dlq" data-obs-dlq aria-hidden="true">
            <span class="obs-board__dlq-node"></span>
            <span class="obs-board__dlq-label">Dead-letter queue</span>
        </div>
    </div>

    @* Pipeline-state MATRIX: one row per recent message, newest at the top and pushed down as new
       ones arrive; one column per pipeline stage. Each cell says what happened to that message at
       that stage — the time it was submitted, how long it waited in each queue, the rules-engine
       decision, and when its Zendesk ticket was created. This is both the visual record (it scrolls,
       showing the latest ~10) and the accessible parallel to the animation: a real govuk-table with
       stage column headers, so screen-reader and reduced-motion users get the same picture. The
       queue column headers link (new tab) to that queue's admin page. The board engine fills the
       body live from the SSE snapshot; the full, paged history is on the transactions page. *@
    <div class="obs-board__parallel">
        <h3 class="govuk-heading-s">Recent messages</h3>
        <p class="govuk-body-s govuk-hint govuk-!-margin-bottom-2">
            The latest messages and what happened at each stage — newest at the top.
        </p>
        <div class="obs-board__grid-scroll">
            <table class="govuk-table obs-board__grid">
                <caption class="govuk-table__caption govuk-visually-hidden">Recent messages by pipeline stage</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Reference</th>
                        <th scope="col" class="govuk-table__header">Submit</th>
                        <th scope="col" class="govuk-table__header">
                            <a class="govuk-link" href="/admin/queues/list/rules-engine" target="_blank" rel="noopener">Rules queue</a>
                        </th>
                        <th scope="col" class="govuk-table__header">Rules engine</th>
                        <th scope="col" class="govuk-table__header">Status</th>
                        <th scope="col" class="govuk-table__header">
                            <a class="govuk-link" href="/admin/queues/list/zendesk" target="_blank" rel="noopener">Zendesk queue</a>
                        </th>
                        <th scope="col" class="govuk-table__header">Zendesk ticket</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body" data-obs-grid>
                    <tr class="govuk-table__row obs-board__grid-empty">
                        <td class="govuk-table__cell" colspan="7">No messages yet. Drive some traffic to see them flow.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="govuk-body-s govuk-!-margin-top-2">
            <a class="govuk-link" href="/admin/observability/transactions" target="_blank" rel="noopener">View all transactions →</a>
        </p>
        <p class="govuk-body-s">
            <a class="govuk-link" href="/admin/observability/submissions">Replay submissions through the stages →</a>
        </p>
    </div>

    @* The reconnect notice the engine reveals on a dropped stream; EventSource reconnects on its
       own, so the copy reassures rather than asks the user to act. *@
    <p class="obs-board__reconnect govuk-body" data-obs-reconnect hidden>
        The live view is temporarily unavailable. The pipeline is unaffected; this page will
        reconnect automatically.
    </p>
</section>
