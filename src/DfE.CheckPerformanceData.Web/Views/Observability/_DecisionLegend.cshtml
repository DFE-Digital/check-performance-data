@using DfE.CheckPerformanceData.Web.Models.Observability
@*
    The ONE shared decision-colour legend, rendered once beneath the charts rather than duplicated
    per chart. It states the colour→label meaning a single time for every chart that colours by
    decision (the decision-mix pie and the decision-mix-over-time lines), reading its colours from
    the canonical DecisionColours map so the legend can never drift from the charts. The per-chart
    aria-labels and paired data tables remain, so colour is never the only signal; this swatch list
    is decorative (aria-hidden) — the meaning is already carried in text by those tables.
*@
<div class="obs-legend-shared">
    <h3 class="govuk-heading-s">What the decision colours mean</h3>
    <ul class="obs-legend govuk-body-s" aria-hidden="true">
        @foreach (var item in DecisionColours.LegendItems)
        {
            <li class="obs-legend__item">
                <span class="obs-legend__swatch" style="background-color: @item.Colour"></span>
                @item.Label
            </li>
        }
    </ul>
</div>
