@model DfE.CheckPerformanceData.Web.Models.Observability.DashboardViewModel
@using DfE.CheckPerformanceData.Web.Models.Observability
@*
    The dashboard's collapsible Demo panel: every demo control in one place, folded in from the
    retired /dev/uat Debug Pipeline page. Hidden by default behind a GDS <details> "Demo" toggle so
    the always-on dashboard stays uncluttered; the whole panel only renders when the controller
    resolved DemoToolsEnabled (Dev:ToolsEnabled AND not production). Nothing here touches pupil
    data — it is a dev and test aid only.

    The drive / inject / seed buttons post to the retained /dev/uat POST endpoints; uat-console.js
    upgrades them to fetch() so a drive refreshes the board in place rather than reloading. The
    replay scrubber and the slow-mo / single-step / demo-trickle checkboxes carry the same hooks the
    board engine binds (it now finds them at the document level), so they drive the same renderer.
*@
@*
    The panel keeps its position above the board (controls and the board the envelopes move through
    visible together), but its TOGGLE is decoupled: a subtle "Demo tools" link rendered below the
    Recent submissions table (in _Board) shows/hides this region via aria-controls. The region
    renders visible with no JS (progressive enhancement); uat-console.js collapses it on first load
    and wires the trigger, so the toggle and panel stay in sync.
*@
@if (Model.DemoToolsEnabled)
{
    <section class="obs-demo-panel" id="obs-demo-panel" data-obs-demo-panel
             aria-label="Demo tools (development and test only)">
        <div class="obs-demo-panel__body">
            <p class="govuk-body govuk-!-margin-bottom-2">
                Drive synthetic traffic and watch the board react. Nothing here touches pupil data —
                it is a dev and test tool only.
            </p>

            @* ── Drive bar: batch size, the three drive buttons, inject/seed and Pause all on one
               wrapping row so the panel stays short and the board below stays in view. ── *@
            <div class="obs-demo-panel__bar">
                <div class="obs-demo-panel__batch">
                    <label class="govuk-label govuk-!-margin-bottom-0" for="uat-batch">Batch</label>
                    <input class="govuk-input govuk-input--width-2" id="uat-batch" name="count"
                           type="number" min="1" max="20" value="1" data-uat-batch inputmode="numeric"
                           title="How many requests each drive button sends in one click (1–20)." />
                </div>

                <form method="post" action="/dev/uat/drive?outcome=approved" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request the rules engine will approve; watch it route through Auto-approved to a Zendesk ticket.">Approved</button>
                </form>
                <form method="post" action="/dev/uat/drive?outcome=rejected" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request the rules engine will reject; it routes through Auto-rejected and still produces a ticket.">Rejected</button>
                </form>
                <form method="post" action="/dev/uat/drive?outcome=scrutiny" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request that falls to manual scrutiny; exercises the scrutiny path.">Scrutiny</button>
                </form>

                @* Drives over AJAX like the other buttons (data-uat-drive-form), so its success bumps
                   the live dead-letter counter and animates exactly one failed envelope via the
                   board's optimistic present — rather than a full-page reload. The board's
                   present (a failed-outcome drive) is the single source of the animation, so the
                   button carries no separate board-only inject hook (which would double the envelope). *@
                <form method="post" action="/dev/uat/inject-failure" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Add one synthetic failing message so it diverts to the dead-letter queue on the board.">Failure</button>
                </form>
                @* Random: rolls one of the four outcomes (approved / rejected / scrutiny / failure) per
                   message, so a batch is a realistic mix. Drives through the same path; the server
                   returns the chosen outcome so the board shows the correctly-routed envelope. *@
                <form method="post" action="/dev/uat/drive?outcome=random" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request whose outcome is a random one of approved, rejected, scrutiny or failure.">Random</button>
                </form>
                @* Pause/Resume freezes all envelope motion so the board can be read. It lives in the
                   Demo panel (only shown while Demo is expanded) and is styled as a clear primary
                   button rather than the old grey-on-grey, per UAT. The board engine resolves it at
                   document level. *@
                <button type="button" class="govuk-button obs-demo-panel__pause govuk-!-margin-bottom-0"
                        data-module="govuk-button" data-obs-pause aria-pressed="false"
                        title="Freeze every envelope on the board so you can read it; press again to resume.">
                    Pause
                </button>
            </div>

            @* Seeding/cleanup controls are tucked behind a "Seed" disclosure so the always-visible
               drive bar stays short: Seed messages (synthetic history for the charts), Seed DLQ (one
               straight onto the dead-letter queue) and Purge demo traffic (remove all synthetic rows,
               keeping real submissions). *@
            @{
                var seedNow = DateTime.UtcNow;
                var seedFrom = seedNow.AddDays(-60).ToString("yyyy-MM-ddTHH:mm");
                var seedTo = seedNow.ToString("yyyy-MM-ddTHH:mm");
            }
            <details class="govuk-details obs-demo-panel__seed" data-module="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">Seed</span>
                </summary>
                <div class="govuk-details__text obs-demo-panel__seed-body">
                    <form method="post" action="/dev/uat/seed-messages" class="obs-seed-form">
                        @Html.AntiForgeryToken()
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-label--s" for="seed-range">Seed time frame</label>
                            <select class="govuk-select" id="seed-range" name="range" data-obs-range-select>
                                @foreach (var option in DashboardRanges.All)
                                {
                                    <option value="@option.Value" selected="@(option.Value == DashboardRanges.DefaultValue)">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-0" data-obs-custom-range hidden>
                            <label class="govuk-label govuk-label--s" for="seed-from">From (UTC, custom)</label>
                            <input class="govuk-input govuk-input--width-20" type="datetime-local" id="seed-from" name="from" value="@seedFrom" />
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-0" data-obs-custom-range hidden>
                            <label class="govuk-label govuk-label--s" for="seed-to">To (UTC, custom)</label>
                            <input class="govuk-input govuk-input--width-20" type="datetime-local" id="seed-to" name="to" value="@seedTo" />
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-label--s" for="seed-per-day">Messages per day</label>
                            <input class="govuk-input govuk-input--width-5" type="number" id="seed-per-day" name="perDay"
                                   min="1" max="500" value="50" inputmode="numeric" />
                        </div>
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                                data-uat-tip title="Seed synthetic submissions across the chosen time frame at the chosen per-day rate so the charts below look full. A named range uses its calendar window; Custom uses the from/to. Submit again to add more.">Seed messages</button>
                    </form>
                    <form method="post" action="/dev/uat/seed-dlq" class="uat-inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                                data-uat-tip title="Place a message straight onto the dead-letter queue so you can practise a redrive.">Seed DLQ</button>
                    </form>
                    <form method="post" action="/dev/uat/purge-demo" data-uat-confirm="Remove all demo-created traffic (drive, seed and inject)? Real submissions are kept.">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button"
                                data-uat-tip title="Delete all synthetic demo traffic (DEV-/SEED-/demo-fail-/uat-dlq-/e2e-dlq- references) from the pipeline tables. Real submissions are kept.">Purge demo traffic</button>
                    </form>
                </div>
            </details>

            @* A live region the AJAX drives write the last reference into, in place of a reload. *@
            <p class="govuk-body govuk-!-margin-bottom-2" data-uat-last-reference aria-live="polite"></p>

            @* ── Replay + board demo controls (laid out horizontally to keep the panel short) ── *@
            <div class="obs-demo-panel__row">
                @* Replay recent traffic: window select + play + scrubber all on one line so the box
                   stays compact rather than taking half-page width. *@
                <div class="obs-board__replay" role="group" aria-label="Replay recorded traffic">
                    <h3 class="govuk-heading-s">Replay recent traffic</h3>
                    <div class="obs-board__replay-controls">
                        <label class="govuk-label govuk-!-margin-bottom-0" for="obs-replay-window">Time frame</label>
                        @* The same range vocabulary the chart and seed dropdowns use, defaulting to
                           Today; the window is resolved server-side by the replay endpoint. Custom
                           reveals the from/to inputs (the shared range-custom script). *@
                        <select class="govuk-select govuk-!-margin-bottom-0" id="obs-replay-window" data-obs-replay-window data-obs-range-select
                                title="How far back the replay reaches; defaults to today.">
                            @foreach (var option in DashboardRanges.All)
                            {
                                <option value="@option.Value" selected="@(option.Value == DashboardRanges.DefaultValue)">@option.Label</option>
                            }
                        </select>
                        <div class="govuk-form-group govuk-!-margin-bottom-0" data-obs-custom-range hidden>
                            <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="obs-replay-from">From (UTC, custom)</label>
                            <input class="govuk-input govuk-input--width-15 govuk-!-margin-bottom-0" type="datetime-local" id="obs-replay-from" />
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-0" data-obs-custom-range hidden>
                            <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="obs-replay-to">To (UTC, custom)</label>
                            <input class="govuk-input govuk-input--width-15 govuk-!-margin-bottom-0" type="datetime-local" id="obs-replay-to" />
                        </div>
                        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                data-module="govuk-button" data-obs-replay-play aria-pressed="false"
                                title="Play or pause the recorded traffic through the board.">
                            Play
                        </button>
                        <label class="govuk-label govuk-visually-hidden" for="obs-replay-scrubber">
                            Replay position
                        </label>
                        <input type="range" id="obs-replay-scrubber" class="obs-board__scrubber"
                               min="0" max="0" value="0" step="1"
                               data-obs-scrubber aria-valuetext="No recorded events in this window"
                               title="Drag to scrub through recorded events; each step animates an envelope through the stages." />
                        @* Replay speed: how fast auto-play steps through the recorded events. *@
                        <label class="govuk-label govuk-!-margin-bottom-0" for="obs-replay-speed">Speed</label>
                        <input type="range" id="obs-replay-speed" class="obs-board__speed"
                               min="0" max="100" value="50" step="1" data-obs-replay-speed
                               title="Slide left to slow the replay down, right to speed it up." />
                    </div>
                    <p class="govuk-body-s govuk-!-margin-bottom-0" data-obs-replay-status aria-live="polite">
                        No recorded events in this window
                    </p>
                </div>

                @* Board demo controls sit beside the replay box on the same row. The old slow-motion
                   and single-step checkboxes are gone: Demo trickle now has two sliders — Messages
                   (how many per burst) and Speed. Speed's far left is a slow single step, its far
                   right races envelopes through the system. *@
                <div class="obs-board__dev-controls" role="group" aria-label="Demo controls (development and test only)">
                    <h3 class="govuk-heading-s">Demo trickle</h3>
                    <div class="obs-board__dev-controls-list">
                        <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-2">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="obs-demo" type="checkbox" data-obs-demo
                                       title="Trickle a steady flow of synthetic envelopes so the board stays alive during a demo." />
                                <label class="govuk-label govuk-checkboxes__label" for="obs-demo">Run demo trickle</label>
                            </div>
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-1">
                            <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="obs-demo-count">Messages</label>
                            <input type="range" id="obs-demo-count" class="obs-board__speed"
                                   min="1" max="10" value="1" step="1" data-obs-demo-count
                                   title="How many synthetic envelopes each trickle burst sends." />
                        </div>
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="obs-demo-speed">Speed</label>
                            <input type="range" id="obs-demo-speed" class="obs-board__speed"
                                   min="0" max="100" value="50" step="1" data-obs-demo-speed
                                   title="Far left: a slow single step you can follow. Far right: envelopes race through the system." />
                        </div>
                    </div>
                </div>
            </div>

            @* The per-submission replay picker moved onto the always-visible Recent submissions
               matrix (tick rows + Play selected), so the duplicate Demo-panel picker was removed. *@
        </div>
    </section>
}
