@model DfE.CheckPerformanceData.Web.Models.Observability.DashboardViewModel
@*
    The dashboard's collapsible Demo panel: every demo control in one place, folded in from the
    retired /dev/uat Debug Pipeline page. Hidden by default behind a GDS <details> "Demo" toggle so
    the always-on dashboard stays uncluttered; the whole panel only renders when the controller
    resolved DemoToolsEnabled (Dev:ToolsEnabled AND not production). Nothing here touches pupil
    data — it is a dev and test aid only.

    The drive / inject / seed buttons post to the retained /dev/uat POST endpoints; uat-console.js
    upgrades them to fetch() so a drive refreshes the board in place rather than reloading. The
    replay scrubber and the slow-mo / single-step / demo-trickle checkboxes carry the same hooks the
    board engine binds (it now finds them at the document level), so they drive the same renderer.
*@
@if (Model.DemoToolsEnabled)
{
    <details class="govuk-details obs-demo-panel" data-module="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">Demo</span>
        </summary>
        <div class="govuk-details__text obs-demo-panel__body">
            <p class="govuk-body govuk-!-margin-bottom-2">
                Drive synthetic traffic and watch the board react. Nothing here touches pupil data —
                it is a dev and test tool only.
            </p>

            @* ── Drive bar: batch size, the three drive buttons, inject/seed and Pause all on one
               wrapping row so the panel stays short and the board below stays in view. ── *@
            <div class="obs-demo-panel__bar">
                <div class="obs-demo-panel__batch">
                    <label class="govuk-label govuk-!-margin-bottom-0" for="uat-batch">Batch</label>
                    <input class="govuk-input govuk-input--width-2" id="uat-batch" name="count"
                           type="number" min="1" max="20" value="1" data-uat-batch inputmode="numeric"
                           title="How many requests each drive button sends in one click (1–20)." />
                </div>

                <form method="post" action="/dev/uat/drive?outcome=approved" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request the rules engine will approve; watch it route through Auto-approved to a Zendesk ticket.">Drive approved</button>
                </form>
                <form method="post" action="/dev/uat/drive?outcome=rejected" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request the rules engine will reject; it routes through Auto-rejected and still produces a ticket.">Drive rejected</button>
                </form>
                <form method="post" action="/dev/uat/drive?outcome=scrutiny" class="uat-inline-form" data-uat-drive-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="count" value="1" data-uat-batch-mirror />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Send a request that falls to manual scrutiny; exercises the scrutiny path.">Drive scrutiny</button>
                </form>

                <form method="post" action="/dev/uat/inject-failure" class="uat-inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-obs-inject
                            data-uat-tip title="Add one synthetic failing message so it diverts to the dead-letter queue on the board.">Inject failure</button>
                </form>
                <form method="post" action="/dev/uat/seed-dlq" class="uat-inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button"
                            data-uat-tip title="Place a message straight onto the dead-letter queue so you can practise a redrive.">Seed DLQ</button>
                </form>

                @* Pause/Resume freezes all envelope motion so the board can be read. It lives in the
                   Demo panel (only shown while Demo is expanded) and is styled as a clear primary
                   button rather than the old grey-on-grey, per UAT. The board engine resolves it at
                   document level. *@
                <button type="button" class="govuk-button obs-demo-panel__pause govuk-!-margin-bottom-0"
                        data-module="govuk-button" data-obs-pause aria-pressed="false"
                        title="Freeze every envelope on the board so you can read it; press again to resume.">
                    Pause
                </button>
            </div>

            @* A live region the AJAX drives write the last reference into, in place of a reload. *@
            <p class="govuk-body govuk-!-margin-bottom-2" data-uat-last-reference aria-live="polite"></p>

            @* ── Replay + board demo controls (laid out horizontally to keep the panel short) ── *@
            <div class="obs-demo-panel__row">
                @* Replay recent traffic: window select + play + scrubber all on one line so the box
                   stays compact rather than taking half-page width. *@
                <div class="obs-board__replay" role="group" aria-label="Replay recorded traffic">
                    <h3 class="govuk-heading-s">Replay recent traffic</h3>
                    <div class="obs-board__replay-controls">
                        <label class="govuk-label govuk-!-margin-bottom-0" for="obs-replay-window">Span</label>
                        <select class="govuk-select govuk-!-margin-bottom-0" id="obs-replay-window" data-obs-replay-window
                                title="How far back the replay reaches; defaults to the last day.">
                            <option value="60">Last hour</option>
                            <option value="360">Last 6 hours</option>
                            <option value="1440" selected>Last 24 hours</option>
                            <option value="10080">Last 7 days</option>
                        </select>
                        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                data-module="govuk-button" data-obs-replay-play aria-pressed="false"
                                title="Play or pause the recorded traffic through the board.">
                            Play
                        </button>
                        <label class="govuk-label govuk-visually-hidden" for="obs-replay-scrubber">
                            Replay position
                        </label>
                        <input type="range" id="obs-replay-scrubber" class="obs-board__scrubber"
                               min="0" max="0" value="0" step="1"
                               data-obs-scrubber aria-valuetext="No recorded events in this window"
                               title="Drag to scrub through recorded events; each step animates an envelope through the stages." />
                    </div>
                    <p class="govuk-body-s govuk-!-margin-bottom-0" data-obs-replay-status aria-live="polite">
                        No recorded events in this window
                    </p>
                </div>

                @* Board demo controls sit beside the replay box on the same row. *@
                <div class="obs-board__dev-controls" role="group" aria-label="Demo controls (development and test only)">
                    <h3 class="govuk-heading-s">Board demo controls</h3>
                    <div class="govuk-checkboxes govuk-checkboxes--small obs-board__dev-controls-list">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="obs-slowmo" type="checkbox" data-obs-slowmo
                                   title="Slow every envelope's motion right down so an audience can follow it." />
                            <label class="govuk-label govuk-checkboxes__label" for="obs-slowmo">Slow motion</label>
                        </div>
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="obs-step" type="checkbox" data-obs-step
                                   title="Tick to send one envelope from Submit through to the Zendesk ticket, one step at a time." />
                            <label class="govuk-label govuk-checkboxes__label" for="obs-step">Single step</label>
                        </div>
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="obs-demo" type="checkbox" data-obs-demo
                                   title="Trickle a steady flow of synthetic envelopes so the board stays alive during a demo." />
                            <label class="govuk-label govuk-checkboxes__label" for="obs-demo">Demo trickle</label>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Replay selected submissions: search recent submissions, tick a few and Play them
               through the board, obeying the demo slow-mo / single-step. Folded in from the retired
               standalone submissions + walkthrough pages — the board itself is the walkthrough now. ── *@
            <div class="obs-replay-picker" data-obs-replay-picker>
                <h3 class="govuk-heading-s">Replay submissions through the stages</h3>
                <div class="obs-replay-picker__controls">
                    <label class="govuk-label govuk-!-margin-bottom-0" for="obs-picker-search">Search</label>
                    <input class="govuk-input govuk-input--width-10 govuk-!-margin-bottom-0" id="obs-picker-search"
                           type="search" autocomplete="off" data-obs-picker-search placeholder="reference"
                           title="Filter the recent submissions by reference." />
                    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                            data-module="govuk-button" data-obs-picker-load
                            title="Load recent submissions to choose from.">Find submissions</button>
                    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                            data-module="govuk-button" data-obs-picker-play
                            title="Animate the ticked submissions through the board, obeying the demo controls.">Play selected</button>
                </div>
                <div class="obs-replay-picker__list" data-obs-picker-list aria-live="polite">
                    <p class="govuk-body-s govuk-hint govuk-!-margin-bottom-0">
                        Press “Find submissions”, tick the ones to follow, then Play to watch them move through the board.
                    </p>
                </div>
            </div>
        </div>
    </details>
}
