@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Web.Controllers
@model DfE.CheckPerformanceData.Web.Models.PageTree.RenderedPageViewModel
@{
    ViewData["Title"] = Model.Title;
    IReadOnlyList<ContentNode> content = Model.Content ?? [];

    // Ambient nav lists for the PageNav widget. It receives only its own WidgetNode props,
    // so any page-context data it needs (auto heading nav, direct-children nav) is stashed
    // on ViewData here — the widget partial reads whichever key its mode dictates.
    ViewData["PageHeadingNav"]  = Model.Nav         ?? Array.Empty<ContentNavItem>();
    ViewData["PageChildrenNav"] = Model.ChildrenNav ?? Array.Empty<ContentNavItem>();

    // If the author has placed their own H1 widget inside the content tree, suppress the
    // template-emitted title + subtitle — otherwise we'd render two H1s and the title would
    // float full-width above whatever multi-column layout they set up. This lets pages that
    // use a 1/3-2/3 region put "Guidance / Title / Subtitle" inside the right column
    // (matching the GDS pattern-library design) while still auto-titling pages that don't
    // opt in.
    var hasAuthoredH1 = ContentTreeWalker.AllWidgets(content)
        .Any(w => w.Type == "heading" && w.GetInt("level") == 1);
}

@if (Model.IsPreview)
{
    <div class="govuk-notification-banner govuk-notification-banner--important" role="region" aria-labelledby="preview-notice-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="preview-notice-title">Preview</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">This page is not published. Only editors can see this preview.</p>
        </div>
    </div>
}

@* GDS breadcrumb — Home → ancestors → current page (plain text). Rendered even for
   top-level pages so the "Home" anchor is always available. *@
<nav class="govuk-breadcrumbs cpb-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" href="/">Home</a>
        </li>
        @foreach (var crumb in Model.Breadcrumb)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@crumb.Href">@crumb.Title</a>
            </li>
        }
        <li class="govuk-breadcrumbs__list-item" aria-current="page">@Model.Title</li>
    </ol>
</nav>

@* In-page edit shortcut for CMS editors: small pencil icon pinned to the top-right of
   the page area so signed-in editors can jump into the admin editor for the current
   page without going through the admin nav. Guests never see it. *@
@if (Model.NodeId != Guid.Empty && (User.IsInRole(WikiConstants.EditorRole) || User.IsInRole(WikiConstants.AdminRole)))
{
    <a class="cpb-inpage-edit"
       href="/admin/pages/@Model.NodeId/edit"
       title="Edit this page in the CMS admin"
       aria-label="Edit this page in the CMS admin">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"
             width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
        </svg>
        <span>Edit</span>
    </a>
}

@* Full-width — no fixed one-third/two-thirds grid. The author uses Region widgets to
   split into columns wherever they want a side-nav (they place a PageNav widget in the
   narrower column and the body content in the wider one). *@
@if (!hasAuthoredH1)
{
    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
    {
        <p class="govuk-caption-l cpb-subtitle">@Model.Subtitle</p>
    }
    <h1 class="govuk-heading-xl cpb-page-h1">@Model.Title</h1>
}
@await Html.PartialAsync("ContentPages/_ContentNodes", content)

@* Equalise the height of dfe-cards that live as direct grandchildren of a govuk-grid-row.
   Flex-wrap keeps cards in the same VISUAL row equal, but cards that wrap to a new row are
   naturally sized. This script picks the tallest card in the whole row and sets every card
   to that height, so a 3+1 wrapped layout still reads as four equal-sized cards. *@
<script src="~/js/content-cards-equalize.js" asp-append-version="true"></script>
