@using DfE.CheckPerformanceData.Application.ContentPages
@model DfE.CheckPerformanceData.Web.Models.PageTree.RenderedPageViewModel
@{
    ViewData["Title"] = Model.Title;
    IReadOnlyList<ContentNode> content = Model.Content ?? [];

    // Ambient nav lists for the PageNav widget. It receives only its own WidgetNode props,
    // so any page-context data it needs (auto heading nav, direct-children nav) is stashed
    // on ViewData here — the widget partial reads whichever key its mode dictates.
    ViewData["PageHeadingNav"]  = Model.Nav         ?? Array.Empty<ContentNavItem>();
    ViewData["PageChildrenNav"] = Model.ChildrenNav ?? Array.Empty<ContentNavItem>();
}

@if (Model.IsPreview)
{
    <div class="govuk-notification-banner govuk-notification-banner--important" role="region" aria-labelledby="preview-notice-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="preview-notice-title">Preview</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">This page is not published. Only editors can see this preview.</p>
        </div>
    </div>
}

@* GDS breadcrumb — Home → ancestors → current page (plain text). Rendered even for
   top-level pages so the "Home" anchor is always available. *@
<nav class="govuk-breadcrumbs cpb-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" href="/">Home</a>
        </li>
        @foreach (var crumb in Model.Breadcrumb)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@crumb.Href">@crumb.Title</a>
            </li>
        }
        <li class="govuk-breadcrumbs__list-item" aria-current="page">@Model.Title</li>
    </ol>
</nav>

@* Full-width — no fixed one-third/two-thirds grid. The author uses Region widgets to
   split into columns wherever they want a side-nav (they place a PageNav widget in the
   narrower column and the body content in the wider one). *@
@if (!string.IsNullOrWhiteSpace(Model.Subtitle))
{
    <p class="govuk-caption-l cpb-subtitle">@Model.Subtitle</p>
}
<h1 class="govuk-heading-xl cpb-page-h1">@Model.Title</h1>
@await Html.PartialAsync("ContentPages/_ContentNodes", content)
