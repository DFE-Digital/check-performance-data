@using DfE.CheckPerformanceData.Application.Common
@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Application.Media.RichText
@using DfE.CheckPerformanceData.Application.Media.Serving
@using DfE.CheckPerformanceData.Application.Media.Widget
@inject IHtmlRenderingService Renderer
@inject IMediaVersionResolver MediaResolver
@inject IMediaUrlBuilder MediaUrls
@model DfE.CheckPerformanceData.Web.Models.PageTree.RenderedPageViewModel
@{
    ViewData["Title"] = Model.Title;
    IReadOnlyList<ContentNavItem> nav = Model.Nav ?? [];
    // The body is rich text: sanitise it, then point each media library image at the version the
    // page shows, as the rich-text widget does. A version-history preview shows the image versions
    // recorded for that page version. Previews warn about a missing image; a public page drops it.
    var body = Renderer.RenderHtml(Model.WikiHtml) ?? string.Empty;
    body = await MediaResolver.RenderRichTextImagesAsync(body, MediaUrls, Model.MediaPageVersionId, Model.IsPreview);
}

@if (Model.IsPreview)
{
    <div class="govuk-notification-banner govuk-notification-banner--important" role="region" aria-labelledby="preview-notice-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="preview-notice-title">Preview</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">This page is not published. Only editors can see this preview.</p>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
        @await Html.PartialAsync("ContentPages/_SideNav", nav)
    </div>
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">@Model.Title</h1>
        @Html.Raw(body)
    </div>
</div>

@* Placed OUTSIDE the govuk-grid-row so its natural position is below all page content —
   position:sticky needs the natural position to sit below the viewport for the pin to
   engage. Rendering it here (rather than inside the one-third column) makes the wiki
   layout behave identically to the full-width Content.cshtml pages. *@
@await Html.PartialAsync("ContentPages/_BackToTop")
