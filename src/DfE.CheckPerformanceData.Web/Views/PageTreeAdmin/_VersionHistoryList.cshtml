@using DfE.CheckPerformanceData.Application.PageTree
@using DfE.CheckPerformanceData.Web.Extensions
@using DfE.CheckPerformanceData.Web.Models.PageTree
@using DfE.CheckPerformanceData.Web.PageTree
@model PageTreeAdminVersionHistoryModel

<hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">
<h2 class="govuk-heading-m" id="version-history">Version history</h2>

@if (Model.Versions.Count == 0)
{
    <p class="govuk-body">No versions yet.</p>
}
else
{
    var rejected = PublishWindowError.Read(TempData);
    <p class="govuk-hint" id="publish-window-hint">
        Publish from and publish to are UK time: the time shown on UK clocks on that date,
        whether British Summer Time or Greenwich Mean Time applies.
    </p>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Version</th>
                <th scope="col" class="govuk-table__header">Modified</th>
                <th scope="col" class="govuk-table__header">Modified by</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Publish from (UK time)</th>
                <th scope="col" class="govuk-table__header">Publish to (UK time)</th>
                <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @{ var now = DateTime.UtcNow; }
            @foreach (var v in Model.Versions)
            {
                var st = PageVersionStatus.Of(v.IsCurrent, v.PublishFrom, now);
                // A <form> cannot be a direct child of <tr>, so the per-row form lives in the
                // Actions cell and the date inputs in the other cells associate with it via form=.
                var formId = $"version-form-{v.VersionId}";
                var rowError = rejected?.VersionId == v.VersionId ? rejected : null;
                var fromValue = rowError is not null ? rowError.From : PublishWindowTime.ToInputValue(v.PublishFrom);
                var toValue = rowError is not null ? rowError.To : PublishWindowTime.ToInputValue(v.PublishTo);
                var fromError = rowError?.FromError;
                var toError = rowError?.ToError;
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@PageVersionNumbering.Label(Model.Versions, v)</td>
                    <td class="govuk-table__cell">@v.UpdatedDate.ToLondonString("dd MMM yyyy HH:mm")</td>
                    <td class="govuk-table__cell">@(v.UpdatedBy ?? "—")</td>
                    <td class="govuk-table__cell">
                        <strong class="govuk-tag @st.TagClass">@st.Label</strong>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(fromError is null ? "" : "govuk-form-group--error")">
                            @if (fromError is not null)
                            {
                                <p class="govuk-error-message" id="from-@(v.VersionId)-error">
                                    <span class="govuk-visually-hidden">Error:</span> @fromError
                                </p>
                            }
                            <input class="govuk-input govuk-input--width-20 @(fromError is null ? "" : "govuk-input--error")"
                                   type="datetime-local"
                                   id="from-@v.VersionId"
                                   form="@formId"
                                   name="from"
                                   aria-label="Publish from (UK time)"
                                   aria-describedby="publish-window-hint@(fromError is null ? "" : $" from-{v.VersionId}-error")"
                                   value="@fromValue" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(toError is null ? "" : "govuk-form-group--error")">
                            @if (toError is not null)
                            {
                                <p class="govuk-error-message" id="to-@(v.VersionId)-error">
                                    <span class="govuk-visually-hidden">Error:</span> @toError
                                </p>
                            }
                            <input class="govuk-input govuk-input--width-20 @(toError is null ? "" : "govuk-input--error")"
                                   type="datetime-local"
                                   id="to-@v.VersionId"
                                   form="@formId"
                                   name="to"
                                   aria-label="Publish to (UK time)"
                                   aria-describedby="publish-window-hint@(toError is null ? "" : $" to-{v.VersionId}-error")"
                                   value="@toValue" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <form id="@formId" method="post" action="/admin/pages/@Model.NodeId/publish">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="versionId" value="@v.VersionId" />
                            <div class="govuk-button-group">
                                <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Save</button>
                                @if (!v.IsCurrent)
                                {
                                    <button type="submit" class="govuk-button govuk-!-margin-bottom-0"
                                            formaction="/admin/pages/@Model.NodeId/versions/publish-now">Publish</button>
                                }
                                @if (v.IsCurrent)
                                {
                                    <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                            formaction="/admin/pages/@Model.NodeId/versions/unpublish">Unpublish</button>
                                }
                                <a class="govuk-link" target="_blank" rel="noopener"
                                   href="/admin/pages/@Model.NodeId/versions/@v.VersionId/preview">View</a>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
