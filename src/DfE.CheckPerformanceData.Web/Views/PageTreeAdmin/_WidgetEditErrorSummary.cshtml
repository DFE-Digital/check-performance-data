@using DfE.CheckPerformanceData.Web.PageTree
@*
    A widget save that was refused. Each error links to its field in the widget's edit form, which
    opens to show it (see ContentPages/_EditWidget).
*@
@{
    var rejected = WidgetEditError.Read(TempData);
}
@if (rejected is not null && rejected.Errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in rejected.Errors)
                    {
                        <li><a href="#wf-@error.Field-@rejected.Path">@error.Message</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
