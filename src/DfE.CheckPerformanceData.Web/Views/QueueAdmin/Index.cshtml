@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.QueueIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Queues";
}

<h1 class="govuk-heading-xl">Queues</h1>
<p class="govuk-body-l">
    Queue depth and the age of the oldest waiting message. Figures are taken on each
    page load.
</p>

<form action="/admin/queues" method="get" class="govuk-!-margin-bottom-6">
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
        Refresh
    </button>
    <p class="govuk-body-s govuk-hint">
        Last refreshed @Model.RefreshedAtUtc.ToString("u")
    </p>
</form>

<table class="govuk-table">
    <caption class="govuk-table__caption govuk-table__caption--m">Queue depth and latency</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Queue</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Depth</th>
            <th scope="col" class="govuk-table__header">Oldest message age</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @if (Model.Queues.Count == 0)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell" colspan="3">No queues found.</td>
            </tr>
        }
        @foreach (var queue in Model.Queues)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@queue.QueueName</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@queue.Depth</td>
                <td class="govuk-table__cell">
                    @(queue.OldestMessageAge is { } age
                        ? $"{(int)age.TotalMinutes} min"
                        : "—")
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="govuk-summary-card govuk-!-margin-top-6">
    <div class="govuk-summary-card__title-wrapper">
        <h2 class="govuk-summary-card__title">Dead-letter queue</h2>
        <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
                <a class="govuk-link" href="/admin/queues/dlq">View dead-letter queue</a>
            </li>
        </ul>
    </div>
    <div class="govuk-summary-card__content">
        <p class="govuk-body">
            <strong class="govuk-tag @(Model.DeadLetterCount > 0 ? "govuk-tag--red" : "govuk-tag--green")">
                @Model.DeadLetterCount
            </strong>
            message(s) in the dead-letter queue.
        </p>
    </div>
</div>
