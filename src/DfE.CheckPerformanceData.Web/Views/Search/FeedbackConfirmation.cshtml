@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SearchFeedbackViewModel
@{
    ViewData["Title"] = "Thanks — we have received your note";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Thanks — we have received your note</h1>

        <p class="govuk-body">
            Your session ID is <strong>@Model.SessionId</strong>. If you contact us again,
            quote this ID so we can find your search history.
        </p>

        <p class="govuk-body">
            <a class="govuk-link" href="/search">Return to search</a>
        </p>
    </div>
</div>
