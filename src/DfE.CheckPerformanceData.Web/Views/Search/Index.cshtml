@using DfE.CheckPerformanceData.Application.Search
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.SiteSearchViewModel
@inject DfE.CheckPerformanceData.Application.Search.ISearchDebugOptions SearchDebugOptions
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Query)
        ? "Search"
        : $"Search results for “{Model.Query}”";
    var scopeSuffix = string.IsNullOrEmpty(Model.Scope) ? string.Empty : $" in /{Model.Scope}";
    var formAction = "/search";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Search@(scopeSuffix)</h1>

        <form class="cypmd-search" role="search" method="get" action="@formAction">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-label--s" for="search-q">Search</label>
                <div class="cypmd-search__row">
                    <input class="govuk-input cypmd-search__input" id="search-q" name="q" type="search"
                           value="@Model.Query" autocomplete="off" />
                    <button class="govuk-button cypmd-search__button" data-module="govuk-button" type="submit">Search</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Scope))
            {
                <input type="hidden" name="scope" value="@Model.Scope" />
            }
        </form>

        @if (Model.InvalidReason == SearchInvalidReason.EmptyQuery)
        {
            <p class="govuk-body">Enter a search term to begin.</p>
        }
        else if (Model.InvalidReason == SearchInvalidReason.BelowMinimumLength)
        {
            <p class="govuk-body">Enter at least 2 characters.</p>
        }
        else if (Model.TotalHits == 0)
        {
            <p class="govuk-body">No results found for <strong>@Model.Query</strong>@(scopeSuffix).</p>
        }
        else
        {
            <p class="govuk-body">
                @Model.TotalHits result@(Model.TotalHits == 1 ? "" : "s") for
                <strong>@Model.Query</strong>@(scopeSuffix).
            </p>

            @* Debug: ts_rank score. Each row's AggregateRank is MAX(page_ts_rank,
               max block_ts_rank) across all contributors resolving to that URL. Per-field
               weight semantics (Keywords A + Title B + Subtitle C + BodyPlainText D on
               pages; Keywords A + ValuePlainText B on blocks) live in
               Application/Search/SearchWeights.cs.                                        *@
            <ul class="govuk-list govuk-list--spaced cypmd-search-results">
                @foreach (var hit in Model.Hits)
                {
                    @if (SearchDebugOptions.ShowSearchDebug)
                    {
                        @:<!-- rank: @hit.AggregateRank.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) -->
                    }
                    <li>
                        <h3 class="govuk-heading-s govuk-!-margin-bottom-1">
                            <a class="govuk-link" href="@hit.Url">@hit.Title</a>
                        </h3>
                        <p class="govuk-body-s govuk-!-margin-bottom-0">@Html.Raw(hit.SnippetHtml)</p>
                    </li>
                }
            </ul>
        }
    </div>
</div>
