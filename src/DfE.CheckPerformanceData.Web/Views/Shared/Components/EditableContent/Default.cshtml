@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.EditableContentViewModel

@if (Model.IsEditing)
{
    <form action="/content-block/save" method="post" id="block-@Model.Key">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Key" value="@Model.Key" />
        <input type="hidden" name="BlockType" value="Content" />
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" name="Anchor" value="block-@Model.Key" />
        @if (!Model.HasSavedContent)
        {
            <input type="hidden" name="OriginalValue" value="@Model.Value" />
        }

        <div class="govuk-form-group">
            <label class="govuk-label govuk-label--m" for="cb-@Model.Key">Content</label>
            <div class="govuk-hint">You can type directly, use Markdown, or paste formatted text from Word.</div>
            <textarea class="govuk-textarea" id="cb-@Model.Key" name="Value" rows="15">@Model.Value</textarea>
        </div>

        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
            <a href="@(Context.Request.Path)" class="govuk-link">Cancel</a>
        </div>

        @if (Model.HasSavedContent)
        {
            <p class="govuk-body-s">
                <a href="/content-block/versions/@Model.Key" class="govuk-link">Version history</a>
            </p>
        }
    </form>

    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script>
        (function () {
            'use strict';
            if (typeof tinymce === 'undefined') return;

            tinymce.init({
                selector: '#cb-@Model.Key',
                height: 400,
                menubar: true,
                plugins: 'lists link table code wordcount searchreplace fullscreen',
                toolbar: 'undo redo | styles | bold italic underline strikethrough | alignleft aligncenter alignright | bullist numlist outdent indent | link table | code fullscreen',
                style_formats: [
                    { title: 'Heading 2 (section)', block: 'h2', classes: 'govuk-heading-l' },
                    { title: 'Heading 3 (sub-section)', block: 'h3', classes: 'govuk-heading-m' },
                    { title: 'Heading 4 (minor)', block: 'h4', classes: 'govuk-heading-s' },
                    { title: 'Paragraph', block: 'p', classes: 'govuk-body' },
                    { title: 'Lead paragraph', block: 'p', classes: 'govuk-body-l' },
                    { title: 'Bulleted list', selector: 'ul', classes: 'govuk-list govuk-list--bullet' },
                    { title: 'Numbered list', selector: 'ol', classes: 'govuk-list govuk-list--number' },
                    { title: 'Link', inline: 'a', classes: 'govuk-link' },
                    { title: 'Inset text (grey)', block: 'div', classes: 'govuk-inset-text', wrapper: true },
                    { title: 'Published / review callout (blue)', block: 'div', classes: 'cypmd-published', wrapper: true },
                    { title: 'Information callout (blue)', block: 'div', classes: 'cypmd-notice', wrapper: true },
                    { title: 'Warning text', block: 'div', classes: 'govuk-warning-text', wrapper: true },
                    { title: 'Last updated tag', inline: 'strong', classes: 'govuk-tag govuk-tag--blue' }
                ],
                style_formats_merge: false,
                paste_as_text: false,
                paste_merge_formats: true,
                paste_tab_spaces: 4,
                content_css: ['/css/dfefrontend-2.0.0.min.css', '/css/site.css'],
                branding: false,
                promotion: false,
                license_key: 'gpl',
                setup: function (editor) {
                    editor.on('change', function () {
                        editor.save();
                    });
                }
            });
        })();
    </script>
}
else
{
    <div class="content-block content-block--content" id="block-@Model.Key">
        <div class="govuk-body">
            @Html.Raw(Model.ValueHtml)
        </div>
        @if (User.IsInRole(DfE.CheckPerformanceData.Web.Controllers.WikiConstants.EditorRole))
        {
            <a href="?edit=@Model.Key#block-@Model.Key" class="content-block__edit-link govuk-link">
                <svg class="content-block__edit-icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M11.5 1.5l3 3L5 14l-3.5.5L2 11l9.5-9.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
                    <path d="M9.5 3.5l3 3" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                </svg>
                <span class="govuk-visually-hidden">Edit @Model.Key</span>
            </a>
        }
    </div>
}
