@model DfE.CheckPerformanceData.Web.ViewComponents.SummaryListRowViewModel

<div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">
        @Model.Title
    </dt>
    <dd class="govuk-summary-list__value">
        @Html.Raw(Model.Value)
    </dd>
    <dd class="govuk-summary-list__actions">
        @if (Model.Link is not null)
        {
            <a class="govuk-link" href="@Model.Link">
                Change<span class="govuk-visually-hidden"> @(Model.VisuallyHiddenText ?? Model.Title.ToLowerInvariant())</span>
            </a>
        }
    </dd>
</div>