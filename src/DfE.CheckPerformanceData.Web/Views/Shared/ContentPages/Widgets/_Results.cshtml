@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Application.Search
@using DfE.CheckPerformanceData.Application.Settings
@model WidgetNode
@inject ISiteSearchService SearchService
@inject ISettingService SettingService
@{
    // --- Editor-configured props ---
    var widgetScope = (Model.GetString("scope") ?? string.Empty).Trim().Trim('/');
    var emptyText   = Model.GetString("emptyText") ?? "No results found.";

    // --- URL params ---
    // page is one-indexed at the URL boundary (?page=1 = first) to match the other paged
    // admin views; converted to zero-indexed for the service call.
    var query = ViewContext.HttpContext.Request.Query;
    var q         = query.TryGetValue("q", out var qv)      ? qv.ToString().Trim() : string.Empty;
    var urlScope  = query.TryGetValue("scope", out var sv)  ? sv.ToString().Trim().Trim('/') : string.Empty;
    var pageOneIx = query.TryGetValue("page", out var pv) && int.TryParse(pv, out var pp) && pp >= 1
        ? pp : 1;

    // URL scope wins over widget-configured scope so a site-wide entry point can override
    // a section widget; the widget's own scope is authoritative for direct visits.
    var effectiveScope = !string.IsNullOrEmpty(urlScope) ? urlScope : widgetScope;

    // --- Page size from settings ---
    var pageSize = await SettingService.GetIntAsync(SettingKeys.WikiPageLength);
    if (pageSize < 1) pageSize = 20;

    // --- Search ---
    SiteSearchPagedResult? result = null;
    if (!string.IsNullOrEmpty(q))
    {
        result = await SearchService.SearchMergedPagedAsync(
            new SiteSearchQuery(
                q,
                ScopePath: string.IsNullOrEmpty(effectiveScope) ? null : effectiveScope),
            page: pageOneIx - 1,
            pageSize: pageSize);
    }

    // --- Pagination URL builder: preserves q + urlScope, sets ?page=N. ---
    string PageUrl(int oneIndexed)
    {
        var path = ViewContext.HttpContext.Request.Path.Value ?? "/";
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(q))         parts.Add($"q={Uri.EscapeDataString(q)}");
        if (!string.IsNullOrEmpty(urlScope))  parts.Add($"scope={Uri.EscapeDataString(urlScope)}");
        if (oneIndexed > 1)                    parts.Add($"page={oneIndexed}");
        return parts.Count == 0 ? path : $"{path}?{string.Join("&", parts)}";
    }
}
<div class="cypmd-search-results">
    @if (string.IsNullOrEmpty(q))
    {
        <p class="govuk-body">Enter a search term to begin.</p>
    }
    else if (result?.InvalidReason == SearchInvalidReason.BelowMinimumLength)
    {
        <p class="govuk-body">Enter at least 2 characters.</p>
    }
    else if (result is null || result.TotalCount == 0)
    {
        <p class="govuk-body">@emptyText</p>
    }
    else
    {
        <p class="govuk-body">
            @result.TotalCount result@(result.TotalCount == 1 ? "" : "s") for <strong>@q</strong>.
        </p>

        <ul class="govuk-list govuk-list--spaced">
            @foreach (var hit in result.Items)
            {
                <li>
                    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">
                        <a class="govuk-link" href="@hit.Url">@hit.Title</a>
                    </h3>
                    @if (!string.IsNullOrEmpty(hit.Subtitle))
                    {
                        <p class="govuk-body-s govuk-!-margin-bottom-1"><em>@hit.Subtitle</em></p>
                    }
                    <p class="govuk-body-s govuk-!-margin-bottom-0">@Html.Raw(hit.SnippetHtml)</p>
                </li>
            }
        </ul>

        @if (result.TotalPages > 1)
        {
            <govuk-pagination>
                @if (pageOneIx > 1)
                {
                    <govuk-pagination-previous href="@PageUrl(pageOneIx - 1)" />
                }
                @for (var i = 1; i <= result.TotalPages; i++)
                {
                    <govuk-pagination-item href="@PageUrl(i)" current="@(i == pageOneIx)">@i</govuk-pagination-item>
                }
                @if (pageOneIx < result.TotalPages)
                {
                    <govuk-pagination-next href="@PageUrl(pageOneIx + 1)" />
                }
            </govuk-pagination>
        }
    }
</div>
