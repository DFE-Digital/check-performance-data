@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Web.Models.Guidance
@model EditColumnModel
@{
    var addPath = TreePath.Format(Model.AppendPath());
}
<div data-column-path="@addPath">
@for (var i = 0; i < Model.Nodes.Count; i++)
{
    var node = Model.Nodes[i];
    var path = TreePath.Format(Model.PathOf(i));
    <div class="cpb-node" data-node-path="@path">
        <div class="cpb-toolbar">
            <form method="post" action="@Model.ActionBase/move" class="cpb-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@path" />
                <button class="app-action-icon-btn" name="direction" value="up" title="Move up">
                    @await Html.PartialAsync("PageTree/_ActionIcon", "arrow_upward")
                    <span class="govuk-visually-hidden">Move up</span>
                </button>
                <button class="app-action-icon-btn" name="direction" value="down" title="Move down">
                    @await Html.PartialAsync("PageTree/_ActionIcon", "arrow_downward")
                    <span class="govuk-visually-hidden">Move down</span>
                </button>
            </form>
            <form method="post" action="@Model.ActionBase/delete" class="cpb-inline cpb-toolbar__delete"
                  onsubmit="return confirm('Delete this content?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@path" />
                <button class="app-action-icon-btn" title="Delete">
                    @await Html.PartialAsync("PageTree/_ActionIcon", "delete")
                    <span class="govuk-visually-hidden">Delete</span>
                </button>
            </form>
        </div>

        @if (node is RegionNode region)
        {
            var classes = RegionLayoutGrid.ColumnClasses(region.Layout);
            <div class="cpb-region">
                <span class="govuk-caption-m cpb-drag-handle" draggable="true" title="Drag to reorder">Region — @region.Layout</span>
                <div class="govuk-grid-row">
                    @for (var c = 0; c < region.Columns.Count; c++)
                    {
                        <div class="@(c < classes.Count ? classes[c] : "govuk-grid-column-full")">
                            @await Html.PartialAsync("ContentPages/_EditColumn",
                                new EditColumnModel(Model.ActionBase, region.Columns[c], Model.PathOf(i), c))
                        </div>
                    }
                </div>
            </div>
        }
        else if (node is WidgetNode widget)
        {
            @await Html.PartialAsync("ContentPages/_EditWidget", new EditWidgetModel(Model.ActionBase, path, widget))
        }
    </div>
}

<details class="govuk-details cpb-add">
    <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">
            @await Html.PartialAsync("PageTree/_ActionIcon", "add")
            Add content here
        </span>
    </summary>
    <div class="govuk-details__text">
        <form method="post" action="@Model.ActionBase/add" class="cpb-inline govuk-!-margin-right-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="path" value="@addPath" />
            <select class="govuk-select" name="regionLayout" aria-label="Region layout">
                @foreach (var layout in Enum.GetValues<RegionLayout>())
                {
                    <option value="@layout">@layout</option>
                }
            </select>
            <button class="govuk-button govuk-button--secondary cpb-btn" type="submit">Add region</button>
        </form>
        <form method="post" action="@Model.ActionBase/add" class="cpb-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="path" value="@addPath" />
            <select class="govuk-select" name="widgetType" aria-label="Widget type">
                @foreach (var w in WidgetRegistry.All)
                {
                    <option value="@w.Type">@w.PaletteLabel</option>
                }
            </select>
            <button class="govuk-button cpb-btn" type="submit">Add widget</button>
        </form>
    </div>
</details>
</div>
