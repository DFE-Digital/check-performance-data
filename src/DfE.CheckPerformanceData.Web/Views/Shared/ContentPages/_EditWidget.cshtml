@using System.Text.Json.Nodes
@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Web.Models.Guidance
@model EditWidgetModel
@{
    var w = Model.Widget;
    var label = WidgetRegistry.Get(w.Type)?.PaletteLabel ?? w.Type;

    string RowsText()
    {
        var rows = w.GetArray("rows");
        if (rows is null) return string.Empty;
        return string.Join("\n", rows.OfType<JsonObject>()
            .Select(r => $"{(string?)r["key"]}|{(string?)r["value"]}"));
    }
}
<div class="cpb-widget">
    <span class="govuk-caption-m cpb-drag-handle" draggable="true" title="Drag to reorder">@label</span>
    <div class="cpb-preview">
        @await Html.PartialAsync("ContentPages/_Widget", w)
    </div>

    @if (w.Type != "divider")
    {
        <details class="govuk-details">
            <summary class="govuk-details__summary" title="Edit @label.ToLowerInvariant()">
                <span class="govuk-details__summary-text">
                    @await Html.PartialAsync("PageTree/_ActionIcon", "edit")
                    Edit @label.ToLowerInvariant()
                </span>
            </summary>
            <div class="govuk-details__text">
                <form method="post" action="@Model.ActionBase/widget">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="path" value="@Model.Path" />
                    <input type="hidden" name="type" value="@w.Type" />

                    @switch (w.Type)
                    {
                        case "heading":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="lvl-@Model.Path">Level</label>
                                <select class="govuk-select" id="lvl-@Model.Path" name="props[level]">
                                    @foreach (var lvl in new[] { 1, 2, 3, 4, 5, 6 })
                                    {
                                        <option value="@lvl" selected="@(w.GetInt("level") == lvl ? "selected" : null)">Heading @lvl</option>
                                    }
                                </select>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="txt-@Model.Path">Text</label>
                                <input class="govuk-input" id="txt-@Model.Path" name="props[text]" value="@w.GetString("text")" />
                            </div>
                            break;

                        case "richtext":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="html-@Model.Path">Content</label>
                                <textarea class="govuk-textarea cpb-richtext" id="html-@Model.Path" name="props[html]" rows="8">@w.GetString("html")</textarea>
                            </div>
                            break;

                        case "card":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="ct-@Model.Path">Title</label>
                                <input class="govuk-input" id="ct-@Model.Path" name="props[title]" value="@w.GetString("title")" />
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="cb-@Model.Path">Body</label>
                                <input class="govuk-input" id="cb-@Model.Path" name="props[body]" value="@w.GetString("body")" />
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="ch-@Model.Path">Link (optional)</label>
                                <input class="govuk-input" id="ch-@Model.Path" name="props[href]" value="@w.GetString("href")" />
                            </div>
                            break;

                        case "summarylist":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="rows-@Model.Path">Rows</label>
                                <div class="govuk-hint">One per line, as <code>Label|Value</code>.</div>
                                <textarea class="govuk-textarea" id="rows-@Model.Path" name="props[rows]" rows="5">@RowsText()</textarea>
                            </div>
                            break;

                        case "published":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="pt-@Model.Path">Message</label>
                                <input class="govuk-input" id="pt-@Model.Path" name="props[text]" value="@w.GetString("text")" />
                            </div>
                            break;

                        case "pagenav":
                            {
                                var pnMode = w.GetString("mode") ?? "headings";
                                var pnShowSearch = w.GetBool("showSearch") ?? false;
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="pn-@Model.Path">Show</label>
                                    <select class="govuk-select cpb-pagenav__mode" id="pn-@Model.Path" name="props[mode]"
                                            data-cpb-pagenav-mode>
                                        <option value="headings" selected="@(pnMode == "headings" ? "selected" : null)">Page headings</option>
                                        <option value="children" selected="@(pnMode == "children" ? "selected" : null)">Child pages</option>
                                    </select>
                                </div>
                                @* Heading-levels: which levels the contents list covers. Shown when
                                   mode=headings. The chosen levels nest in the order they are
                                   chosen, so ticking H2 and H4 on a page that skips H3 puts the
                                   H4s directly under the H2s. *@
                                <div class="govuk-form-group cpb-pagenav__headings-fields" data-cpb-pagenav-headings @(pnMode == "headings" ? null : Html.Raw("hidden"))>
                                    <fieldset class="govuk-fieldset">
                                        <legend class="govuk-fieldset__legend">Heading levels to show</legend>
                                        <div class="govuk-hint">
                                            They nest in the order ticked. If this page skips a level —
                                            H2s and H4s but no H3s — tick just the ones it uses.
                                        </div>
                                        <div class="govuk-checkboxes govuk-checkboxes--small govuk-checkboxes--inline" data-module="govuk-checkboxes">
                                            @for (var lvl = 1; lvl <= 6; lvl++)
                                            {
                                                var lvlKey = $"h{lvl}";
                                                // A widget placed before these existed declares none of them, and
                                                // means the default pair rather than nothing.
                                                var declared = w.Props?.ContainsKey(lvlKey) == true;
                                                var ticked = declared ? (w.GetBool(lvlKey) ?? false) : lvl is 2 or 3;
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="pnh@(lvl)-@Model.Path"
                                                           name="props[@lvlKey]" type="checkbox" value="true"
                                                           @(ticked ? "checked" : null) />
                                                    <label class="govuk-label govuk-checkboxes__label" for="pnh@(lvl)-@Model.Path">H@(lvl)</label>
                                                    @* An unticked box posts nothing, and the props builder keeps the
                                                       registry default for a field it never sees — so without this,
                                                       unticking a level that defaults to on would not turn it off.
                                                       It goes AFTER the label, not between input and label: the
                                                       browser posts in DOM order and the first value wins, so the
                                                       checkbox's "true" must come first, and the GDS tick and focus
                                                       ring are drawn by an adjacent-sibling rule on input + label
                                                       that anything in between would break. *@
                                                    <input type="hidden" name="props[@lvlKey]" value="false" />
                                                </div>
                                            }
                                        </div>
                                    </fieldset>
                                </div>
                                @* Children-only fields — shown when mode=children. The script at the bottom
                                   of Edit.cshtml toggles visibility live as the select changes. *@
                                <div class="cpb-pagenav__children-fields" data-cpb-pagenav-children @(pnMode == "children" ? null : Html.Raw("hidden"))>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="pnpp-@Model.Path">Parent path for children</label>
                                        <div class="govuk-hint">
                                            Path whose direct children are listed (e.g. <code>help</code>).
                                            Leave blank to list children of the current page.
                                        </div>
                                        <input class="govuk-input" id="pnpp-@Model.Path" name="props[childrenParentPath]" value="@w.GetString("childrenParentPath")" />
                                    </div>
                                    <div class="govuk-form-group">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" id="pnss-@Model.Path" name="props[showSearch]"
                                                   type="checkbox" value="true" data-cpb-pagenav-showsearch
                                                   @(pnShowSearch ? "checked" : null) />
                                            <label class="govuk-label govuk-checkboxes__label" for="pnss-@Model.Path">
                                                Show a search box above the list
                                            </label>
                                        </div>
                                    </div>
                                    @* Search-only fields — shown when Show search is ticked. *@
                                    <div class="cpb-pagenav__search-fields" data-cpb-pagenav-searchfields @(pnShowSearch ? null : Html.Raw("hidden"))>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label" for="pnsl-@Model.Path">Search label</label>
                                            <input class="govuk-input" id="pnsl-@Model.Path" name="props[searchLabel]" value="@w.GetString("searchLabel")" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label" for="pnsp-@Model.Path">Search scope path</label>
                                            <div class="govuk-hint">
                                                Restrict search to descendants of this path (e.g. <code>help</code>).
                                                Leave blank to search all documents.
                                            </div>
                                            <input class="govuk-input" id="pnsp-@Model.Path" name="props[searchPath]" value="@w.GetString("searchPath")" />
                                        </div>
                                    </div>
                                </div>
                            }
                            break;

                        case "search":
                            {
                                // Widgets placed before searchIn existed carry only a scope, so a set
                                // scope still selects "a section of the site" in the editor.
                                var sIn = (w.GetString("searchIn") ?? string.Empty).Trim();
                                if (sIn.Length == 0) sIn = string.IsNullOrWhiteSpace(w.GetString("scope")) ? "site" : "path";
                                var sInstant = w.GetBool("instant") ?? false;
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="si-@Model.Path">Search in</label>
                                    <select class="govuk-select" id="si-@Model.Path" name="props[searchIn]"
                                            data-cpb-search-in>
                                        <option value="site" selected="@(sIn == "site" ? "selected" : null)">The whole site</option>
                                        <option value="path" selected="@(sIn == "path" ? "selected" : null)">A section of the site</option>
                                        <option value="page" selected="@(sIn == "page" ? "selected" : null)">This page</option>
                                    </select>
                                </div>
                                @* Section-only field — shown when Search in = a section of the site. *@
                                <div class="govuk-form-group cpb-search__path-field" data-cpb-search-pathfield @(sIn == "path" ? null : Html.Raw("hidden"))>
                                    <label class="govuk-label" for="ss-@Model.Path">Scope path</label>
                                    <div class="govuk-hint">
                                        Restrict results to this path and everything under it (e.g. <code>help</code>).
                                    </div>
                                    <input class="govuk-input" id="ss-@Model.Path" name="props[scope]" value="@w.GetString("scope")" />
                                </div>
                                <div class="govuk-form-group">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input" id="sis-@Model.Path" name="props[instant]"
                                               type="checkbox" value="true" data-cpb-search-instant
                                               @(sInstant ? "checked" : null) />
                                        <label class="govuk-label govuk-checkboxes__label" for="sis-@Model.Path">
                                            Instant search
                                        </label>
                                    </div>
                                    <div class="govuk-hint">
                                        Show matches as the visitor types, without them pressing the button.
                                        On this page, choosing a match jumps to that section; otherwise it opens
                                        the page found.
                                    </div>
                                </div>
                                @* Instant-only copy. *@
                                <div class="govuk-form-group cpb-search__instant-fields" data-cpb-search-instantfields @(sInstant ? null : Html.Raw("hidden"))>
                                    <label class="govuk-label" for="sn-@Model.Path">No-results text</label>
                                    <input class="govuk-input" id="sn-@Model.Path" name="props[noResultsText]" value="@w.GetString("noResultsText")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sl-@Model.Path">Label</label>
                                    <input class="govuk-input" id="sl-@Model.Path" name="props[label]" value="@w.GetString("label")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sp-@Model.Path">Placeholder (optional)</label>
                                    <input class="govuk-input" id="sp-@Model.Path" name="props[placeholder]" value="@w.GetString("placeholder")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sb-@Model.Path">Button text</label>
                                    <input class="govuk-input" id="sb-@Model.Path" name="props[buttonText]" value="@w.GetString("buttonText")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sa-@Model.Path">Form action URL</label>
                                    <div class="govuk-hint">
                                        Where the button submits to. Also the fallback for visitors without
                                        JavaScript when instant search is on.
                                    </div>
                                    <input class="govuk-input" id="sa-@Model.Path" name="props[action]" value="@w.GetString("action")" />
                                </div>
                            }
                            break;

                        case "results":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="rs-@Model.Path">Scope path (optional)</label>
                                <div class="govuk-hint">
                                    Restrict results to descendants of this path (e.g. <code>help</code>).
                                    Overridden by <code>?scope=</code> on the URL if present.
                                </div>
                                <input class="govuk-input" id="rs-@Model.Path" name="props[scope]" value="@w.GetString("scope")" />
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="re-@Model.Path">Empty-state text</label>
                                <input class="govuk-input" id="re-@Model.Path" name="props[emptyText]" value="@w.GetString("emptyText")" />
                            </div>
                            <p class="govuk-body govuk-body-s">
                                Results per page is controlled by the <strong>CMS:PageLength</strong>
                                setting on the admin Settings page (default 20).
                            </p>
                            break;
                    }

                    <button class="govuk-button cpb-btn" type="submit">Save</button>
                </form>
            </div>
        </details>
    }
</div>
