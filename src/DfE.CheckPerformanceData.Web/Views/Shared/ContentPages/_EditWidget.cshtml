@using System.Text.Json.Nodes
@using DfE.CheckPerformanceData.Application.ContentPages
@using DfE.CheckPerformanceData.Application.Media.Widget
@using DfE.CheckPerformanceData.Web.PageTree
@using DfE.CheckPerformanceData.Web.Models.Guidance
@using DfE.CheckPerformanceData.Application.Media.Serving
@using DfE.CheckPerformanceData.Web.Controllers.ViewModels.Media
@inject IMediaVersionResolver MediaResolver
@inject IMediaUrlBuilder MediaUrls
@model EditWidgetModel
@{
    var w = Model.Widget;
    var label = WidgetRegistry.Get(w.Type)?.PaletteLabel ?? w.Type;

    string RowsText()
    {
        var rows = w.GetArray("rows");
        if (rows is null) return string.Empty;
        return string.Join("\n", rows.OfType<JsonObject>()
            .Select(r => $"{(string?)r["key"]}|{(string?)r["value"]}"));
    }

    // A save of this widget that was refused: its errors, and the values the editor posted.
    var rejected = WidgetEditError.Read(TempData) is { } refused && refused.Path == Model.Path ? refused : null;
    string FieldId(string field) => $"wf-{field}-{Model.Path}";
    string? ErrorFor(string field) => rejected?.MessageFor(field);
    string GroupClass(string field) => ErrorFor(field) is null ? "govuk-form-group" : "govuk-form-group govuk-form-group--error";
    string? DescribedBy(string field) => ErrorFor(field) is null ? null : $"{FieldId(field)}-error";
    // What a field shows: the posted value after a refused save, else the stored value.
    string FieldValue(string field) => rejected is not null
        ? rejected.Props.GetValueOrDefault(field) ?? string.Empty
        : ImageWidgetProps.Text(w.Props, field);

    // The library image an Image widget names, as the image editor script needs it. Null when
    // the id is empty, not valid or not in the library. The editor page primes the resolver.
    async Task<MediaPickerItem?> ChosenImageAsync(string mediaId)
    {
        if (!Guid.TryParse(mediaId.Trim(), out var id) || id == Guid.Empty) return null;
        return (await MediaResolver.ResolveAsync([id], null)).TryGetValue(id, out var media)
            ? MediaPickerItem.From(media.Asset, MediaUrls)
            : null;
    }

    void ErrorMessage(string field)
    {
        if (ErrorFor(field) is { } message)
        {
            <p id="@FieldId(field)-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @message</p>
        }
    }
}
<div class="cpb-widget" id="widget-@Model.Path">
    <span class="govuk-caption-m cpb-drag-handle" draggable="true" title="Drag to reorder">@label</span>
    <div class="cpb-preview">
        @await Html.PartialAsync("ContentPages/_Widget", w)
    </div>

    @if (w.Type != "divider")
    {
        <details class="govuk-details" open="@(rejected is not null ? "open" : null)">
            <summary class="govuk-details__summary" title="Edit @label.ToLowerInvariant()">
                <span class="govuk-details__summary-text">
                    @await Html.PartialAsync("PageTree/_ActionIcon", "edit")
                    Edit @label.ToLowerInvariant()
                </span>
            </summary>
            <div class="govuk-details__text">
                <form method="post" action="@Model.ActionBase/widget">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="path" value="@Model.Path" />
                    <input type="hidden" name="type" value="@w.Type" />

                    @switch (w.Type)
                    {
                        case "heading":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="lvl-@Model.Path">Level</label>
                                <select class="govuk-select" id="lvl-@Model.Path" name="props[level]">
                                    @foreach (var lvl in new[] { 1, 2, 3, 4, 5, 6 })
                                    {
                                        <option value="@lvl" selected="@(w.GetInt("level") == lvl ? "selected" : null)">Heading @lvl</option>
                                    }
                                </select>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="txt-@Model.Path">Text</label>
                                <input class="govuk-input" id="txt-@Model.Path" name="props[text]" value="@w.GetString("text")" />
                            </div>
                            break;

                        case "richtext":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="html-@Model.Path">Content</label>
                                <textarea class="govuk-textarea cpb-richtext" id="html-@Model.Path" name="props[html]" rows="8">@w.GetString("html")</textarea>
                            </div>
                            break;

                        case "card":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="ct-@Model.Path">Title</label>
                                <input class="govuk-input" id="ct-@Model.Path" name="props[title]" value="@w.GetString("title")" />
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="cb-@Model.Path">Body</label>
                                <input class="govuk-input" id="cb-@Model.Path" name="props[body]" value="@w.GetString("body")" />
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="ch-@Model.Path">Link (optional)</label>
                                <input class="govuk-input" id="ch-@Model.Path" name="props[href]" value="@w.GetString("href")" />
                            </div>
                            break;

                        case "summarylist":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="rows-@Model.Path">Rows</label>
                                <div class="govuk-hint">One per line, as <code>Label|Value</code>.</div>
                                <textarea class="govuk-textarea" id="rows-@Model.Path" name="props[rows]" rows="5">@RowsText()</textarea>
                            </div>
                            break;

                        case "published":
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="pt-@Model.Path">Message</label>
                                <input class="govuk-input" id="pt-@Model.Path" name="props[text]" value="@w.GetString("text")" />
                            </div>
                            break;

                        case "pagenav":
                            {
                                var pnMode = w.GetString("mode") ?? "headings";
                                var pnShowSearch = w.GetBool("showSearch") ?? false;
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="pn-@Model.Path">Show</label>
                                    <select class="govuk-select cpb-pagenav__mode" id="pn-@Model.Path" name="props[mode]"
                                            data-cpb-pagenav-mode>
                                        <option value="headings" selected="@(pnMode == "headings" ? "selected" : null)">Page headings</option>
                                        <option value="children" selected="@(pnMode == "children" ? "selected" : null)">Child pages</option>
                                    </select>
                                </div>
                                @* Heading-levels: which levels the contents list covers. Shown when
                                   mode=headings. The chosen levels nest in the order they are
                                   chosen, so ticking H2 and H4 on a page that skips H3 puts the
                                   H4s directly under the H2s. *@
                                <div class="govuk-form-group cpb-pagenav__headings-fields" data-cpb-pagenav-headings @(pnMode == "headings" ? null : Html.Raw("hidden"))>
                                    <fieldset class="govuk-fieldset">
                                        <legend class="govuk-fieldset__legend">Heading levels to show</legend>
                                        <div class="govuk-hint">
                                            They nest in the order ticked. If this page skips a level —
                                            H2s and H4s but no H3s — tick just the ones it uses.
                                        </div>
                                        <div class="govuk-checkboxes govuk-checkboxes--small govuk-checkboxes--inline" data-module="govuk-checkboxes">
                                            @for (var lvl = 1; lvl <= 6; lvl++)
                                            {
                                                var lvlKey = $"h{lvl}";
                                                // A widget placed before these existed declares none of them, and
                                                // means the default pair rather than nothing.
                                                var declared = w.Props?.ContainsKey(lvlKey) == true;
                                                var ticked = declared ? (w.GetBool(lvlKey) ?? false) : lvl is 2 or 3;
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="pnh@(lvl)-@Model.Path"
                                                           name="props[@lvlKey]" type="checkbox" value="true"
                                                           @(ticked ? "checked" : null) />
                                                    <label class="govuk-label govuk-checkboxes__label" for="pnh@(lvl)-@Model.Path">H@(lvl)</label>
                                                    @* An unticked box posts nothing, and the props builder keeps the
                                                       registry default for a field it never sees — so without this,
                                                       unticking a level that defaults to on would not turn it off.
                                                       It goes AFTER the label, not between input and label: the
                                                       browser posts in DOM order and the first value wins, so the
                                                       checkbox's "true" must come first, and the GDS tick and focus
                                                       ring are drawn by an adjacent-sibling rule on input + label
                                                       that anything in between would break. *@
                                                    <input type="hidden" name="props[@lvlKey]" value="false" />
                                                </div>
                                            }
                                        </div>
                                    </fieldset>
                                </div>
                                @* Children-only fields — shown when mode=children. The script at the bottom
                                   of Edit.cshtml toggles visibility live as the select changes. *@
                                <div class="cpb-pagenav__children-fields" data-cpb-pagenav-children @(pnMode == "children" ? null : Html.Raw("hidden"))>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="pnpp-@Model.Path">Parent path for children</label>
                                        <div class="govuk-hint">
                                            Path whose direct children are listed (e.g. <code>help</code>).
                                            Leave blank to list children of the current page.
                                        </div>
                                        <input class="govuk-input" id="pnpp-@Model.Path" name="props[childrenParentPath]" value="@w.GetString("childrenParentPath")" />
                                    </div>
                                    <div class="govuk-form-group">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" id="pnss-@Model.Path" name="props[showSearch]"
                                                   type="checkbox" value="true" data-cpb-pagenav-showsearch
                                                   @(pnShowSearch ? "checked" : null) />
                                            <label class="govuk-label govuk-checkboxes__label" for="pnss-@Model.Path">
                                                Show a search box above the list
                                            </label>
                                        </div>
                                    </div>
                                    @* Search-only fields — shown when Show search is ticked. *@
                                    <div class="cpb-pagenav__search-fields" data-cpb-pagenav-searchfields @(pnShowSearch ? null : Html.Raw("hidden"))>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label" for="pnsl-@Model.Path">Search label</label>
                                            <input class="govuk-input" id="pnsl-@Model.Path" name="props[searchLabel]" value="@w.GetString("searchLabel")" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label" for="pnsp-@Model.Path">Search scope path</label>
                                            <div class="govuk-hint">
                                                Restrict search to descendants of this path (e.g. <code>help</code>).
                                                Leave blank to search all documents.
                                            </div>
                                            <input class="govuk-input" id="pnsp-@Model.Path" name="props[searchPath]" value="@w.GetString("searchPath")" />
                                        </div>
                                    </div>
                                </div>
                            }
                            break;

                        case "search":
                            {
                                // Widgets placed before searchIn existed carry only a scope, so a set
                                // scope still selects "a section of the site" in the editor.
                                var sIn = (w.GetString("searchIn") ?? string.Empty).Trim();
                                if (sIn.Length == 0)
                                    sIn = string.IsNullOrWhiteSpace(w.GetString("scope")) && string.IsNullOrWhiteSpace(w.GetString("scopePageIds"))
                                        ? "site" : "path";
                                var sInstant = w.GetBool("instant") ?? false;
                                // No stored value means a widget saved before the option existed,
                                // which shows the button, so the box starts ticked.
                                var sShowButton = w.GetBool("showButton") ?? true;
                                // No stored value means a widget saved before the option existed,
                                // which has the button beside the box, so the box starts unticked.
                                var sButtonBelow = w.GetBool("buttonBelow") ?? false;
                                // No stored value means a widget saved before the option existed,
                                // which has no clear button, so the box starts unticked.
                                var sClearButton = w.GetBool("clearButton") ?? false;
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="si-@Model.Path">Search in</label>
                                    <select class="govuk-select" id="si-@Model.Path" name="props[searchIn]"
                                            data-cpb-search-in>
                                        <option value="site" selected="@(sIn == "site" ? "selected" : null)">The whole site</option>
                                        <option value="path" selected="@(sIn == "path" ? "selected" : null)">Chosen pages</option>
                                        <option value="page" selected="@(sIn == "page" ? "selected" : null)">This page</option>
                                    </select>
                                </div>
                                @* Section-only field — shown when Search in = a section of the site. *@
                                <div class="cpb-search__path-field" data-cpb-search-pathfield @(sIn == "path" ? null : Html.Raw("hidden"))>
                                    @await Html.PartialAsync("ContentPages/_PageScopePicker", new PageScopePickerField(
                                        $"ss-{Model.Path}", w.GetString("scope"), w.GetString("scopePageIds"), "Pages to search",
                                        "Tick the pages to limit the search to. Each ticked page includes every page beneath it, so tick several to search a group of sections together."))
                                </div>
                                <div class="govuk-form-group">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input" id="sis-@Model.Path" name="props[instant]"
                                               type="checkbox" value="true" data-cpb-search-instant
                                               @(sInstant ? "checked" : null) />
                                        <label class="govuk-label govuk-checkboxes__label" for="sis-@Model.Path">
                                            Instant search
                                        </label>
                                    </div>
                                    <div class="govuk-hint">
                                        Show matches as the visitor types, without them pressing the button.
                                        On this page, choosing a match jumps to that section; otherwise it opens
                                        the page found.
                                    </div>
                                </div>
                                @* Instant-only fields, revealed while the instant tick box is ticked. *@
                                <div class="govuk-checkboxes__conditional cpb-search__instant-fields" data-cpb-search-instantfields @(sInstant ? null : Html.Raw("hidden"))>
                                    <div class="govuk-form-group">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" id="ssb-@Model.Path" name="props[showButton]" type="checkbox"
                                                   value="true" aria-describedby="ssb-@Model.Path-hint"
                                                   @(sShowButton ? "checked" : null) />
                                            <label class="govuk-label govuk-checkboxes__label" for="ssb-@Model.Path">
                                                Show search button
                                            </label>
                                            @* An unticked box posts nothing and the props builder would keep the
                                               default of "true", so this hidden "false" is what makes unticking
                                               stick. It follows the label: the browser posts in DOM order and the
                                               first value wins. *@
                                            <input type="hidden" name="props[showButton]" value="false" />
                                        </div>
                                        <div class="govuk-hint" id="ssb-@Model.Path-hint">
                                            Without the button, visitors press Enter to see all results.
                                        </div>
                                    </div>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="sn-@Model.Path">No-results text</label>
                                        <input class="govuk-input" id="sn-@Model.Path" name="props[noResultsText]" value="@w.GetString("noResultsText")" />
                                    </div>
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sl-@Model.Path">Label</label>
                                    <input class="govuk-input" id="sl-@Model.Path" name="props[label]" value="@w.GetString("label")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sp-@Model.Path">Placeholder (optional)</label>
                                    <input class="govuk-input" id="sp-@Model.Path" name="props[placeholder]" value="@w.GetString("placeholder")" />
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sb-@Model.Path">Button text</label>
                                    <input class="govuk-input" id="sb-@Model.Path" name="props[buttonText]" value="@w.GetString("buttonText")" />
                                </div>
                                <div class="govuk-form-group">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input" id="sbb-@Model.Path" name="props[buttonBelow]" type="checkbox"
                                               value="true" aria-describedby="sbb-@Model.Path-hint"
                                               @(sButtonBelow ? "checked" : null) />
                                        <label class="govuk-label govuk-checkboxes__label" for="sbb-@Model.Path">
                                            Put the button below the search box
                                        </label>
                                        @* An unticked box posts nothing, so this hidden "false" is what makes
                                           unticking stick. It follows the label: the browser posts in DOM
                                           order and the first value wins. *@
                                        <input type="hidden" name="props[buttonBelow]" value="false" />
                                    </div>
                                    <div class="govuk-hint" id="sbb-@Model.Path-hint">
                                        Use this in a narrow column, where a button beside the box leaves little room to type.
                                    </div>
                                </div>
                                <div class="govuk-form-group">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input" id="scb-@Model.Path" name="props[clearButton]" type="checkbox"
                                               value="true" aria-describedby="scb-@Model.Path-hint"
                                               @(sClearButton ? "checked" : null) />
                                        <label class="govuk-label govuk-checkboxes__label" for="scb-@Model.Path">
                                            Show a clear button in the search box
                                        </label>
                                        @* An unticked box posts nothing, so this hidden "false" is what makes
                                           unticking stick. It follows the label: the browser posts in DOM
                                           order and the first value wins. *@
                                        <input type="hidden" name="props[clearButton]" value="false" />
                                    </div>
                                    <div class="govuk-hint" id="scb-@Model.Path-hint">
                                        A cross at the end of the box empties it, so visitors can start again.
                                    </div>
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="sa-@Model.Path">Form action URL</label>
                                    <div class="govuk-hint">
                                        Where the button submits to. Also the fallback for visitors without
                                        JavaScript when instant search is on.
                                    </div>
                                    <input class="govuk-input" id="sa-@Model.Path" name="props[action]" value="@w.GetString("action")" />
                                </div>
                            }
                            break;

                        case "results":
                            @await Html.PartialAsync("ContentPages/_PageScopePicker", new PageScopePickerField(
                                $"rs-{Model.Path}", w.GetString("scope"), w.GetString("scopePageIds"), "Pages to show results from (optional)",
                                "Tick the pages to limit results to, each including every page beneath it. Leave all unticked to show results from the whole site. Overridden by ?pages= or ?scope= on the URL if present."))
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="re-@Model.Path">Empty-state text</label>
                                <input class="govuk-input" id="re-@Model.Path" name="props[emptyText]" value="@w.GetString("emptyText")" />
                            </div>
                            <p class="govuk-body govuk-body-s">
                                Results per page is controlled by the <strong>CMS:PageLength</strong>
                                setting on the admin Settings page (default 20).
                            </p>
                            break;

                        case "image":
                            {
                                // Every prop is a plain named field, so the form works without
                                // JavaScript and posts all of them: the props builder resets a prop
                                // it does not see. image-widget-editor.js adds the media picker, the
                                // crop and focal point tools and a live preview, and writes their
                                // results into these same fields.
                                var imgDecorative = string.Equals(FieldValue("decorative"), "true", StringComparison.OrdinalIgnoreCase);
                                var imgWidth = FieldValue("width");
                                if (!ImageWidgetProps.Widths.Contains(imgWidth)) imgWidth = ImageWidgetProps.FullWidth;
                                var imgAlign = FieldValue("align");
                                var imgAspect = FieldValue("aspect");
                                var imgChosen = await ChosenImageAsync(FieldValue("mediaId"));
                                var imgManualError = ErrorFor("crop") is not null || ErrorFor("aspect") is not null || ErrorFor("focal") is not null;
                                var imgWidths = new[] { ("full", "Full width"), ("two-thirds", "Two-thirds"), ("one-half", "One-half"), ("one-third", "One-third") };
                                var imgAligns = new[] { ("", "None"), ("left", "Left"), ("centre", "Centre"), ("right", "Right") };
                                var imgPresets = new[] { ("", "Free"), ("16:9", "16:9"), ("4:3", "4:3"), ("1:1", "1:1"), ("3:2", "3:2") };
                                <div class="app-image-editor" data-image-editor
                                     data-preview-url="/admin/media/picker/preview"
                                     data-media-file-name="@imgChosen?.FileName"
                                     data-media-alt="@imgChosen?.Alt"
                                     data-media-thumb-url="@imgChosen?.ThumbUrl"
                                     data-media-edit-url="@imgChosen?.EditUrl"
                                     data-media-can-crop="@(imgChosen is null ? null : imgChosen.CanCrop ? "true" : "false")">
                                    <div class="@GroupClass("mediaId")">
                                        <h3 class="govuk-heading-s">Image</h3>
                                        <div class="app-image-editor__chosen" data-image-editor-chosen hidden>
                                            <img class="app-image-editor__thumb" alt="" data-image-editor-thumb />
                                            <p class="govuk-body govuk-!-margin-bottom-2" data-image-editor-name></p>
                                        </div>
                                        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-4" data-module="govuk-button"
                                                data-image-editor-choose hidden>Choose image</button>
                                        <div data-image-editor-fallback>
                                            <label class="govuk-label" for="@FieldId("mediaId")">Image ID</label>
                                            <div class="govuk-hint" id="@FieldId("mediaId")-hint">The ID of an image in the media library. Copy it from the address of the image's page.</div>
                                            @{ ErrorMessage("mediaId"); }
                                            <input class="govuk-input@(ErrorFor("mediaId") is null ? "" : " govuk-input--error")" id="@FieldId("mediaId")" name="props[mediaId]"
                                                   value="@FieldValue("mediaId")" aria-describedby="@FieldId("mediaId")-hint @DescribedBy("mediaId")" spellcheck="false" data-image-editor-media-id />
                                            <p class="govuk-body govuk-!-margin-top-2"><a class="govuk-link" href="/admin/media" target="_blank" rel="noopener noreferrer">Open the media library in a new tab</a></p>
                                        </div>
                                    </div>
                                    <div class="@GroupClass("alt")">
                                        <label class="govuk-label" for="@FieldId("alt")">Alt text</label>
                                        <div class="govuk-hint" id="@FieldId("alt")-hint">
                                            Describe what the image shows and why it is there, for people who cannot see it.
                                            Do not start with "Image of". When you choose an image, its alt text from the library is filled in if this is empty.
                                        </div>
                                        @{ ErrorMessage("alt"); }
                                        <input class="govuk-input@(ErrorFor("alt") is null ? "" : " govuk-input--error")" id="@FieldId("alt")" name="props[alt]"
                                               value="@FieldValue("alt")" aria-describedby="@FieldId("alt")-hint @DescribedBy("alt")" data-image-editor-alt />
                                    </div>
                                    <div class="govuk-form-group">
                                        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                            <div class="govuk-checkboxes__item">
                                                <input class="govuk-checkboxes__input" id="@FieldId("decorative")" name="props[decorative]"
                                                       type="checkbox" value="true" @(imgDecorative ? "checked" : null) data-image-editor-decorative />
                                                <label class="govuk-label govuk-checkboxes__label" for="@FieldId("decorative")">
                                                    This image is decorative (screen readers skip it)
                                                </label>
                                                @* An unticked box posts nothing, so this hidden "false" makes unticking
                                                   stick. It follows the label: the first posted value wins. *@
                                                <input type="hidden" name="props[decorative]" value="false" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="@FieldId("caption")">Caption (optional)</label>
                                        <input class="govuk-input" id="@FieldId("caption")" name="props[caption]" value="@FieldValue("caption")" />
                                    </div>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="@FieldId("credit")">Credit (optional)</label>
                                        <input class="govuk-input" id="@FieldId("credit")" name="props[credit]" value="@FieldValue("credit")" />
                                    </div>
                                    <div class="@GroupClass("width")">
                                        <fieldset class="govuk-fieldset" aria-describedby="@DescribedBy("width")">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Width</legend>
                                            @{ ErrorMessage("width"); }
                                            <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
                                                @foreach (var (value, text) in imgWidths)
                                                {
                                                    var id = value == ImageWidgetProps.FullWidth ? FieldId("width") : $"{FieldId("width")}-{value}";
                                                    <div class="govuk-radios__item">
                                                        <input class="govuk-radios__input" id="@id" name="props[width]" type="radio" value="@value"
                                                               checked="@(imgWidth == value ? "checked" : null)" />
                                                        <label class="govuk-label govuk-radios__label" for="@id">@text</label>
                                                    </div>
                                                }
                                            </div>
                                        </fieldset>
                                    </div>
                                    <div class="@GroupClass("align")">
                                        <fieldset class="govuk-fieldset" aria-describedby="@FieldId("align")-hint @DescribedBy("align")">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Alignment</legend>
                                            <div class="govuk-hint" id="@FieldId("align")-hint">Left and right put the text beside the image on larger screens.</div>
                                            @{ ErrorMessage("align"); }
                                            <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
                                                @foreach (var (value, text) in imgAligns)
                                                {
                                                    var id = value == "" ? FieldId("align") : $"{FieldId("align")}-{value}";
                                                    <div class="govuk-radios__item">
                                                        <input class="govuk-radios__input" id="@id" name="props[align]" type="radio" value="@value"
                                                               checked="@(imgAlign == value ? "checked" : null)" />
                                                        <label class="govuk-label govuk-radios__label" for="@id">@text</label>
                                                    </div>
                                                }
                                            </div>
                                        </fieldset>
                                    </div>
                                    <div class="@GroupClass("href")">
                                        <label class="govuk-label" for="@FieldId("href")">Link (optional)</label>
                                        <div class="govuk-hint" id="@FieldId("href")-hint">A web address, or a page on this site that starts with /.</div>
                                        @{ ErrorMessage("href"); }
                                        <input class="govuk-input@(ErrorFor("href") is null ? "" : " govuk-input--error")" id="@FieldId("href")" name="props[href]"
                                               value="@FieldValue("href")" aria-describedby="@FieldId("href")-hint @DescribedBy("href")" spellcheck="false" />
                                    </div>

                                    @* The crop and focal point tools. The script shows them once an image is chosen. *@
                                    <div class="app-image-editor__tools" data-image-editor-tools hidden>
                                        <div class="govuk-inset-text" data-image-editor-nocrop hidden>
                                            Crop and focal point are not available for this image. SVG, GIF and animated images are always shown as they were uploaded.
                                        </div>
                                        <div data-image-editor-croptools>
                                            <div class="govuk-button-group">
                                                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                                                        aria-expanded="false" aria-controls="ie-crop-@Model.Path" data-image-editor-crop-toggle>Crop image</button>
                                                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                                                        aria-expanded="false" aria-controls="ie-focal-@Model.Path" data-image-editor-focal-toggle>Set focal point</button>
                                            </div>
                                            <div class="app-image-editor__panel" id="ie-crop-@Model.Path" data-image-editor-crop-panel hidden>
                                                <div class="govuk-form-group">
                                                    <fieldset class="govuk-fieldset" aria-describedby="ie-shape-@Model.Path-hint">
                                                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Crop shape</legend>
                                                        <div class="govuk-hint" id="ie-shape-@Model.Path-hint">Drag the box or its corners to choose the part of the image to show.</div>
                                                        <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
                                                            @foreach (var (value, text) in imgPresets)
                                                            {
                                                                var id = $"ie-shape-{Model.Path}-{(value == "" ? "free" : value.Replace(':', '-'))}";
                                                                <div class="govuk-radios__item">
                                                                    <input class="govuk-radios__input" id="@id" name="ie-shape-@Model.Path" type="radio" value="@value"
                                                                           checked="@(imgAspect == value ? "checked" : null)" data-image-editor-shape />
                                                                    <label class="govuk-label govuk-radios__label" for="@id">@text</label>
                                                                </div>
                                                            }
                                                        </div>
                                                    </fieldset>
                                                </div>
                                                <div class="app-image-editor__crop">
                                                    <img alt="The image to crop" data-image-editor-crop-img />
                                                </div>
                                                <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-top-4" data-module="govuk-button"
                                                        data-image-editor-crop-reset>Reset crop</button>
                                            </div>
                                            <div class="app-image-editor__panel" id="ie-focal-@Model.Path" data-image-editor-focal-panel hidden>
                                                <div class="govuk-hint" id="ie-focal-@Model.Path-hint">
                                                    Select the part of the image to keep in view, or use the arrow keys. Hold Shift to move further.
                                                    The focal point is used only when an aspect ratio cuts the image or a crop of another shape.
                                                </div>
                                                <div class="app-image-editor__focal" tabindex="0" role="group" aria-label="Focal point"
                                                     aria-describedby="ie-focal-@Model.Path-hint" data-image-editor-focal-area>
                                                    <img alt="" data-image-editor-focal-img />
                                                    <span class="app-image-editor__marker" aria-hidden="true" data-image-editor-focal-marker></span>
                                                </div>
                                                <p class="govuk-body-s govuk-!-margin-top-2" role="status" data-image-editor-focal-status></p>
                                            </div>
                                        </div>
                                    </div>

                                    @* The values the tools write. They can always be typed here too, so the crop and
                                       focal point do not need a mouse. The section opens when one of them has an error. *@
                                    <details class="govuk-details" data-image-editor-manual open="@(imgManualError ? "open" : null)">
                                        <summary class="govuk-details__summary">
                                            <span class="govuk-details__summary-text">Enter the crop and focal point as numbers</span>
                                        </summary>
                                        <div class="govuk-details__text">
                                            <div class="@GroupClass("aspect")">
                                                <label class="govuk-label" for="@FieldId("aspect")">Aspect ratio</label>
                                                @{ ErrorMessage("aspect"); }
                                                <select class="govuk-select" id="@FieldId("aspect")" name="props[aspect]" aria-describedby="@DescribedBy("aspect")" data-image-editor-aspect>
                                                    <option value="" selected="@(imgAspect == "" ? "selected" : null)">The image's own shape</option>
                                                    <option value="16:9" selected="@(imgAspect == "16:9" ? "selected" : null)">16:9</option>
                                                    <option value="4:3" selected="@(imgAspect == "4:3" ? "selected" : null)">4:3</option>
                                                    <option value="1:1" selected="@(imgAspect == "1:1" ? "selected" : null)">1:1 (square)</option>
                                                    <option value="3:2" selected="@(imgAspect == "3:2" ? "selected" : null)">3:2</option>
                                                </select>
                                            </div>
                                            <div class="@GroupClass("crop")">
                                                <label class="govuk-label" for="@FieldId("crop")">Crop (optional)</label>
                                                <div class="govuk-hint" id="@FieldId("crop")-hint">x,y,width,height as fractions from 0 to 1, for example 0,0,0.5,1 for the left half.</div>
                                                @{ ErrorMessage("crop"); }
                                                <input class="govuk-input govuk-input--width-20@(ErrorFor("crop") is null ? "" : " govuk-input--error")" id="@FieldId("crop")" name="props[crop]"
                                                       value="@FieldValue("crop")" aria-describedby="@FieldId("crop")-hint @DescribedBy("crop")" spellcheck="false" data-image-editor-crop />
                                            </div>
                                            <div class="@GroupClass("focal")">
                                                <label class="govuk-label" for="@FieldId("focal")">Focal point (optional)</label>
                                                <div class="govuk-hint" id="@FieldId("focal")-hint">x,y as fractions of the whole image, from 0 to 1. It is used only when an aspect ratio is set: it keeps this point in view when that shape cuts the image or the crop.</div>
                                                @{ ErrorMessage("focal"); }
                                                <input class="govuk-input govuk-input--width-10@(ErrorFor("focal") is null ? "" : " govuk-input--error")" id="@FieldId("focal")" name="props[focal]"
                                                       value="@FieldValue("focal")" aria-describedby="@FieldId("focal")-hint @DescribedBy("focal")" spellcheck="false" data-image-editor-focal />
                                            </div>
                                        </div>
                                    </details>

                                    <div class="app-image-editor__preview" data-image-editor-preview hidden>
                                        <h3 class="govuk-heading-s">Preview (not saved yet)</h3>
                                        <div data-image-editor-preview-body></div>
                                    </div>
                                </div>
                            }
                            break;
                    }

                    <button class="govuk-button cpb-btn" type="submit">Save</button>
                </form>
            </div>
        </details>
    }
</div>
