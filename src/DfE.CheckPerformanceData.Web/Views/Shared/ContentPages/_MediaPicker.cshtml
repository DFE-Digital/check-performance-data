@using DfE.CheckPerformanceData.Application.Admin
@using DfE.CheckPerformanceData.Application.Media.Upload
@using DfE.CheckPerformanceData.Web.Admin.Nav
@inject IAdminAccessPolicy AccessPolicy
@*
    The media picker: one modal dialog per editor page, opened by media-picker.js for the Image
    widget and the rich text editor. It lists the library a page at a time, with a search, and
    lets the editor upload an image into the library. It sits outside every widget form, so
    Enter in its search box never saves a widget. Its own antiforgery token goes in the
    X-XSRF-TOKEN header of each upload.
*@
@* The picker's endpoints need the media section. Without it the page gets no picker: the Image
   widget keeps its typed image id field, and rich text takes no pasted images. *@
@if (!await AccessPolicy.CanAccessAsync(User, AdminNavKeys.Media))
{
    return;
}
<dialog class="govuk-modal-dialogue__box app-media-picker" id="media-picker" aria-labelledby="media-picker-title"
        data-media-picker
        data-list-url="/admin/media/picker"
        data-upload-url="/admin/media/picker/upload"
        data-max-bytes="@MediaUploadLimits.MaxFileBytes">
    <div class="govuk-modal-dialogue__header">
        <button type="button" class="govuk-modal-dialogue__close" aria-label="Close" data-media-picker-close>&times;</button>
    </div>
    <div class="govuk-modal-dialogue__content">
        <h2 class="govuk-heading-l" id="media-picker-title">Choose an image</h2>
        @Html.AntiForgeryToken()

        <form class="app-media-picker__search" role="search" data-media-picker-search>
            <div class="govuk-form-group govuk-!-margin-bottom-4">
                <label class="govuk-label" for="media-picker-search">Search the media library</label>
                <div class="govuk-hint" id="media-picker-search-hint">Search by file name, alt text, caption, credit or tag.</div>
                <div class="app-media-picker__search-row">
                    <input class="govuk-input govuk-!-width-two-thirds" id="media-picker-search" name="q" type="search"
                           aria-describedby="media-picker-search-hint" spellcheck="false" autocomplete="off" />
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">Search</button>
                </div>
            </div>
        </form>

        <p class="govuk-body" role="status" aria-live="polite" data-media-picker-status></p>

        <form data-media-picker-choose>
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Images in the library</legend>
                <div class="app-media-picker__grid" data-media-picker-grid></div>
            </fieldset>
            <nav class="app-media-picker__paging" aria-label="Pages of images" data-media-picker-paging hidden>
                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-media-picker-prev>Previous page</button>
                <span class="govuk-body" data-media-picker-page></span>
                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-media-picker-next>Next page</button>
            </nav>
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button" data-media-picker-use disabled aria-disabled="true">Use this image</button>
                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-media-picker-cancel>Cancel</button>
            </div>
        </form>

        <h3 class="govuk-heading-m">Upload a new image</h3>
        <div class="govuk-form-group" data-media-picker-upload-group>
            <label class="govuk-label" for="media-picker-file">Upload a file</label>
            <div class="govuk-hint" id="media-picker-file-hint">PNG, JPEG, GIF, WebP or SVG, up to 20 MB. It is added to the media library.</div>
            <p class="govuk-error-message" id="media-picker-file-error" data-media-picker-upload-error hidden></p>
            <input class="govuk-file-upload" id="media-picker-file" name="file" type="file" aria-describedby="media-picker-file-hint"
                   accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml,.png,.jpg,.jpeg,.gif,.webp,.svg" />
        </div>
        <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-media-picker-upload>Upload</button>
    </div>
</dialog>
