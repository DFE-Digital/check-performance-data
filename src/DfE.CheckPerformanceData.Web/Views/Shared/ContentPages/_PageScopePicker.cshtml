@using DfE.CheckPerformanceData.Web.Models.Guidance
@model PageScopePickerField
@{
    var picker = ViewData[PageScopePickerModel.ViewDataKey] as PageScopePickerModel ?? PageScopePickerModel.Empty;
    // Each page posts its id. Anything the widget stores that no longer matches a page is listed
    // after the pages, ticked, so saving the form can't silently drop it and the editor can see
    // it is stale.
    var items = picker.ItemsFor(Model.PageIds, Model.Scope);
    var i = 0;
}
<div class="govuk-form-group">
    <input type="hidden" name="scopePicker" value="true" />
    <fieldset class="govuk-fieldset" aria-describedby="@Model.IdPrefix-hint">
        <legend class="govuk-fieldset__legend">@Model.Legend</legend>
        <div id="@Model.IdPrefix-hint" class="govuk-hint">@Model.Hint</div>
        <div class="govuk-checkboxes govuk-checkboxes--small cpb-scope-picker" data-module="govuk-checkboxes">
            @foreach (var item in items)
            {
                var id = $"{Model.IdPrefix}-{i++}";
                <div class="govuk-checkboxes__item cpb-scope-picker__item" style="margin-left: @(item.Depth * 24)px">
                    <input class="govuk-checkboxes__input" id="@id" name="scopePages" type="checkbox"
                           value="@item.Value" @(item.Ticked ? "checked" : null) />
                    <label class="govuk-label govuk-checkboxes__label" for="@id">
                        @if (item.Path is not null)
                        {
                            @item.Label <span class="govuk-hint govuk-!-display-inline cpb-scope-picker__path">/@item.Path</span>
                        }
                        else
                        {
                            @item.Label <span class="govuk-hint govuk-!-display-inline">(@item.Note)</span>
                        }
                    </label>
                </div>
            }
        </div>
    </fieldset>
</div>
