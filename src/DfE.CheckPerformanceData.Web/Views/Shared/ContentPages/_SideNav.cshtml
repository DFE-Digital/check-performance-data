@using DfE.CheckPerformanceData.Application.ContentPages
@model IReadOnlyList<ContentNavItem>
@*
    Page-side navigation used by the PageNav widget in both "headings" (auto H2/H3/H4 of the
    current page) and "children" (a sibling/child page list) modes. The list itself is rendered
    by _SideNavList, which recurses, so nesting depth is decided by the nav builder rather than
    by how many levels this markup happens to spell out.
*@
@if (Model.Count > 0)
{
    <nav class="moj-side-navigation" aria-label="Page contents">
        @await Html.PartialAsync("ContentPages/_SideNavList", Model)
    </nav>
}
