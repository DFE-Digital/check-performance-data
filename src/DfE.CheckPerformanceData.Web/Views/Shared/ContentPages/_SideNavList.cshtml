@using DfE.CheckPerformanceData.Application.ContentPages
@model IReadOnlyList<ContentNavItem>
@*
    One level of the page-side navigation, rendered recursively so the markup does not need
    changing each time the nav learns about another heading level. Marks the entry whose Href
    matches the current request path as active, which triggers the blue left bar via
    moj-side-navigation__item--active; in-page anchors never match, so a headings nav has no
    active item.
*@
@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    bool IsActive(string href) =>
        !string.IsNullOrEmpty(href) && !href.StartsWith('#')
        && string.Equals(href.TrimEnd('/'), currentPath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}
@if (Model.Count > 0)
{
    <ul class="moj-side-navigation__list">
        @foreach (var item in Model)
        {
            var itemActive = IsActive(item.Href);
            <li class="moj-side-navigation__item @(itemActive ? "moj-side-navigation__item--active" : "")">
                <a href="@item.Href" @(itemActive ? "aria-current=page" : "")>@item.Text</a>
                @if (item.Children.Count > 0)
                {
                    @await Html.PartialAsync("ContentPages/_SideNavList", item.Children)
                }
            </li>
        }
    </ul>
}
