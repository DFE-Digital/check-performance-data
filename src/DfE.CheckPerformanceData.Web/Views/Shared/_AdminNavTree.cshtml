@using DfE.CheckPerformanceData.Web.Admin.Nav
@using DfE.CheckPerformanceData.Web.Controllers.ViewModels
@model IReadOnlyList<AdminNavNodeViewModel>
@{
    var currentPath = (string)(ViewData["AdminCurrentPath"] ?? string.Empty);
    var activeKey = (string?)ViewData["AdminActiveKey"];
    var adminHomeActive = string.Equals(currentPath, "/admin", StringComparison.Ordinal);
}

<nav class="admin-nav-tree" aria-label="Administration navigation">
    <ul class="tv tv-root">
        <li class="tv-item">
            <div class="tv-row">
                <span class="tv-connector"></span>
                <a href="/admin" class="tv-link admin-nav-tree__heading @(adminHomeActive ? "tv-link-active" : "")" @(adminHomeActive ? "aria-current=page" : "")>Administration</a>
            </div>
        </li>

        @foreach (var node in Model)
        {
            var isLast = node == Model.Last();
            @await Html.PartialAsync("_AdminNavNode", new AdminNavNodePartialModel(node, isLast, activeKey))
        }
    </ul>
</nav>
