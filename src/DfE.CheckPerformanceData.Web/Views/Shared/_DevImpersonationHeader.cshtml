@using DfE.CheckPerformanceData.Web.Controllers
@using Microsoft.Extensions.Hosting
@inject IHostEnvironment Env

@*
    Dev-only header affordance. Renders nothing in Production. Lives in the GDS
    service-navigation list immediately after the existing nav items so it shares the
    row; the dev-impersonate-item class pushes it to the far right via flex utility
    margins in site.css.
*@

@if (!Env.IsProduction())
{
    var isEditor = User.IsInRole(WikiConstants.EditorRole);
    var href     = isEditor ? "/dev/impersonate/user" : "/dev/impersonate/editor";
    var label    = isEditor ? "Impersonate unprivileged user" : "Impersonate admin";

    <li class="govuk-service-navigation__item dev-impersonate-item">
        <a class="govuk-service-navigation__link" href="@href">@label</a>
    </li>
}
