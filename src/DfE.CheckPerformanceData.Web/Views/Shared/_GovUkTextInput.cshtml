@model DfE.CheckPerformanceData.Web.ViewComponents.GovUkTextInputViewModel

<div class="govuk-form-group">
    <h1 class="govuk-label-wrapper">
        <label class="govuk-label" for="@Model.Id">
            @Model.Label
        </label>
    </h1>
    <input class="govuk-input" id="@Model.Id" name="@Model.Name" type="@Model.Type" value="@Model.Value"/>
</div>