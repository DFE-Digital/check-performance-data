@using DfE.CheckPerformanceData.Web.Settings
@using Microsoft.Extensions.Options
@inject IOptions<GtmSettings> GtmOptions
@{
    var gtm = GtmOptions.Value;

    // Basic consent mode: only load GTM when analytics consent has already been
    // granted. First-time visitors who accept via the cookie banner get GTM loaded
    // on the fly by loadGtm() in cookies.js.
    var analyticsGranted = Context.IsAnalyticsConsentGranted();
}
@if (gtm.Enabled && !string.IsNullOrEmpty(gtm.ContainerId))
{
    <script>
        // The strict CSP (#611) allows this script only because CspNonceTagHelper stamped the
        // request's nonce on it. Capture that nonce now: loadGtm may run much later (from
        // cookies.js after consent), when document.currentScript is null. GTM copies the nonce
        // from its own loader script onto the tags it injects, so setting it here is what keeps
        // those tags permitted without an inline-script allowance.
        var gtmNonce = document.currentScript ? document.currentScript.nonce : '';

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }

        gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
        });

        // Loads the GTM container. Guarded so it only ever runs once, regardless of
        // whether it is called inline below (returning consented user) or from
        // cookies.js when the user accepts via the banner / preferences page.
        window.loadGtm = function () {
            if (window.__gtmLoaded) return;
            window.__gtmLoaded = true;
            gtag('consent', 'update', { 'analytics_storage': 'granted' });
            (function (w, d, s, l, i) {
                w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.nonce = gtmNonce;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl +
                    '&gtm_auth=@gtm.AuthKey&gtm_preview=@gtm.PreviewId&gtm_cookies_win=x';
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', '@gtm.ContainerId');
        };
    </script>
    @if (analyticsGranted)
    {
        <script>window.loadGtm();</script>
    }
}
