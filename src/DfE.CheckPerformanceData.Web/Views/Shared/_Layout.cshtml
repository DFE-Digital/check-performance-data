@using DfE.CheckPerformanceData.Web.Controllers
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@{
    Layout = "_GovUkPageTemplate";
}
<head>
    @await Html.PartialAsync("_GtmHead")
    @Html.GovUkFrontendStyleImports()
    <link rel="stylesheet" href="~/css/dfefrontend-2.0.0.min.css" />
    <link rel="stylesheet" href="~/css/accessible-autocomplete.min.css" />
</head>
@section BodyStart {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("_CookieBanner")
    @await Html.PartialAsync("_GtmBody")
}

@section Header {
    <govuk-header home-page-url="https://gov.uk/"/>
    <govuk-service-navigation service-name="Check Performance Data" service-url="#">
        <govuk-service-navigation-nav>
            @{
                var selectedWindowId = Context.Session.GetString("SelectedWindowId");
            }
            <govuk-service-navigation-nav-item href="/help">Help</govuk-service-navigation-nav-item>
            @if (selectedWindowId is not null)
            {
                <govuk-service-navigation-nav-item href="@Url.Action("Index", "CheckYourPupilData", new { windowId = selectedWindowId })">Pupils</govuk-service-navigation-nav-item>
            }
            @* Dev-only impersonation affordance. Inlined here (not a partial) because
               the parent <govuk-service-navigation-nav> tag helper processes its
               children at view-compile time; partial-rendered children arrive too late
               and get dropped from the rendered output. dev-impersonate-item is the
               flex right-align hook in site.css. *@
            @if (!HostEnvironment.IsProduction())
            {
                if (User.IsInRole(WikiConstants.EditorRole))
                {
                    <govuk-service-navigation-nav-item href="/dev/impersonate/user" class="dev-impersonate-item">Impersonate unprivileged user</govuk-service-navigation-nav-item>
                }
                else
                {
                    <govuk-service-navigation-nav-item href="/dev/impersonate/editor" class="dev-impersonate-item">Impersonate admin</govuk-service-navigation-nav-item>
                }
            }
        </govuk-service-navigation-nav>
    </govuk-service-navigation>
    <div class="govuk-phase-banner govuk-width-container">
        <p class="govuk-phase-banner__content">
            <strong class="govuk-tag govuk-phase-banner__content__tag">
                Beta
            </strong>
            <span class="govuk-phase-banner__text">
                This is a new service – your <a class="govuk-link" href="#">feedback</a> will help us to improve it.
            </span>
        </p>
    </div>
    @if (User.Identity is { IsAuthenticated: true })
    {
        <div class="govuk-width-container sign-out-bar">
            <a href="@Url.Action("DfeSignOut", "Secret")" class="govuk-link govuk-link--no-visited-state">Sign out</a>
        </div>
    }
}

@Html.GovUkFrontendJsEnabledScript()
@RenderBody()
@Html.GovUkFrontendScriptImports()

