@section BodyEnd {
    <script src="~/js/site.js"></script>
    <script src="~/js/cookies.js"></script>
    <script src="~/js/confirm-modal.js" defer></script>
    <script src="~/js/accessible-autocomplete.min.js"></script>
    @* Back-to-top enhancement. Loaded here rather than inside _BackToTop.cshtml so
       partial renders don't emit N script tags on pages that include the partial in
       multiple regions, and so the fetch runs deferred off the critical path — no
       flash of the yet-to-be-hidden link before the hide-until-init script runs.
       The script no-ops on pages that don't render the .app-back-to-top container. *@
    <script src="~/js/back-to-top.js" defer asp-append-version="true"></script>
    @* Client-side analytics beacons (AB#286387 R18/R19/R23): help-details expand,
       external-link clicks, evidence-file selection. Fire-and-forget; never throws. *@
    <script src="~/js/analytics-events.js" defer asp-append-version="true"></script>
    @* AB#296081: courtesy client-side duplicate evidence file-name warning at selection
       time. Progressive enhancement only — the server remains the authority. *@
    <script src="~/js/evidence-upload-validation.js" defer asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
}
