@using System.Security.Claims
@using DfE.CheckPerformanceData.Application.Settings
@using DfE.CheckPerformanceData.Web.Authentication
@using DfE.CheckPerformanceData.Web.Common
@using DfE.CheckPerformanceData.Web.Controllers
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "_GovUkPageTemplate";
    // "Real DfE auth" = any authenticated identity that isn't the synthetic dev
    // impersonation scheme. Don't compare against a specific scheme name (e.g.
    // "Cookies") because the effective primary identity AuthenticationType varies
    // across the DfE Sign-In cookie, the OIDC pipeline, and the enrichment
    // ("DfeSignIn") identity added in OnTokenValidated.
    var hasRealDfeAuth = User.Identity?.IsAuthenticated == true
        && User.Identities.Any(i => i.IsAuthenticated
            && i.AuthenticationType != DevImpersonationConstants.Scheme);
    var hasEditorImpersonation = Context.Request.Cookies.TryGetValue(DevImpersonationConstants.CookieName, out var impCookie)
        && impCookie == DevImpersonationConstants.EditorValue;
    var hasAdminImpersonation = Context.Request.Cookies.TryGetValue(DevImpersonationConstants.CookieName, out var adminCookie)
        && adminCookie == DevImpersonationConstants.AdminValue;
    var showSignOut = hasRealDfeAuth || hasEditorImpersonation || hasAdminImpersonation;
    var signOutHref = hasRealDfeAuth
        ? Url.Action("DfeSignOut", "Account")
        : "/dev/impersonate/clear";
    // CMS editors now reach the admin surface too — they land on the pages tree, blocks,
    // and content-staging screens (gated per-section by the role-access grid). Show the
    // Admin link for both roles so editors don't have to know the URL by heart.
    var showAdminLink = User.IsInRole(WikiConstants.AdminRole) || User.IsInRole(WikiConstants.EditorRole);

    string? displayName = null;
    if (hasRealDfeAuth)
    {
        var given = User.FindFirst(ClaimTypes.GivenName)?.Value;
        var surname = User.FindFirst(ClaimTypes.Surname)?.Value;
        displayName = string.Join(" ", new[] { given, surname }
            .Where(s => !string.IsNullOrWhiteSpace(s)));
        if (string.IsNullOrWhiteSpace(displayName)) displayName = User.Identity?.Name;
    }

    var parens = new List<string>();
    if (!string.IsNullOrWhiteSpace(displayName)) parens.Add(displayName!);
    if (hasAdminImpersonation) parens.Add("impersonating CMS administrator");
    else if (hasEditorImpersonation) parens.Add("impersonating CMS editor");
    var signOutLabel = parens.Count > 0 ? $"Sign out ({string.Join(", ", parens)})" : "Sign out";

    // Only offer the impersonation dropdown where the dev tooling surface is enabled
    // (local dev + PR/review apps), matching the controller and DI gate. Deployed
    // DEV/QA/Preproduction never set Dev:ToolsEnabled, so the back door is hidden there.
    var devToolsEnabled = Configuration.GetValue<bool>(SettingKeys.DevToolsEnabled);
    var showImpersonateDropdown = devToolsEnabled && !HostEnvironment.IsProduction() && !showSignOut;

    // "Error: " title prefix on a failed submission (GOV.UK Design System). Done here rather
    // than per view so no page can forget it. ModelState covers the great majority — the
    // journey controller adds its validation failures there. A page whose errors live only on
    // its view model (the Summary conflict banner, for instance) sets ViewData["HasError"].
    ViewData["Title"] = PageTitle.WithErrorPrefix(
        ViewData["Title"] as string,
        !ViewData.ModelState.IsValid || ViewData["HasError"] is true);
}
<head>
    @* Form-less pages (CMS/guidance) have no __RequestVerificationToken hidden input, so
       expose the antiforgery token here for wwwroot/js/analytics-events.js (and
       test-data-seed.js's existing fallback probe) to read via fetch. *@
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    @await Html.PartialAsync("_GtmHead")
    @await Html.PartialAsync("_ClarityHead")
    @Html.GovUkFrontendStyleImports()
    <link rel="stylesheet" href="~/css/dfefrontend-2.0.0.min.css" />
    <link rel="stylesheet" href="~/css/accessible-autocomplete.min.css" />
    <link rel="stylesheet" href="~/css/moj-frontend-9.0.0.min.css" />
</head>
@section BodyStart {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("_CookieBanner")
    @await Html.PartialAsync("_GtmBody")
}

@section Header {
    <govuk-header home-page-url="https://gov.uk/"/>
    @* The service navigation is hand-rolled (not <govuk-service-navigation>) because
       the sign-in cluster needs a split-button structure: a "Sign in" link plus a
       separate caret <button> that opens a dropdown. The govuk tag helpers reject
       any custom child markup. Output matches what the tag helpers would emit, plus
       the extra dropdown markup. *@
    <section class="govuk-service-navigation" data-module="govuk-service-navigation" aria-label="Service information">
        <div class="govuk-width-container">
            <div class="govuk-service-navigation__container">
                <span class="govuk-service-navigation__service-name">
                    <a href="/" class="govuk-service-navigation__link">Check Performance Data</a>
                </span>
                <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
                    <ul class="govuk-service-navigation__list" id="govuk-service-navigation-list">
                        @{
                            var selectedWindowId = Context.Session.GetString("SelectedWindowId");
                        }
                        <li class="govuk-service-navigation__item">
                            <a class="govuk-service-navigation__link" href="/guidance">Guidance</a>
                        </li>
                        @if (User.Identity is { IsAuthenticated: true })
                        {
                            @if (selectedWindowId is not null)
                            {
                                <li class="govuk-service-navigation__item">
                                    <a class="govuk-service-navigation__link"
                                       href="@Url.Action("Index", "CheckYourPupilData", new { windowId = selectedWindowId })">Pupils</a>
                                </li>
                            }

                            <li class="govuk-service-navigation__item">
                                <a class="govuk-service-navigation__link" href="@Url.Action("Index", "EstablishmentAmendmentRequests")">Amendment requests</a>
                            </li>
                        }
                        @* Sign in / Sign out cluster.
                           States:
                             - Real DfE auth:                  "Sign out"                            -> DfeSignOut
                             - Real DfE auth + impersonation:  "Sign out (impersonating CMS admin)"  -> DfeSignOut
                             - Synthetic editor impersonation: "Sign out (impersonating CMS admin)"  -> /dev/impersonate/clear (deletes cookie, true anonymous)
                             - Anonymous (or non-editor synthetic): "Sign in" + caret dropdown for "As CMS admin" (non-prod only) *@
                        @if (showAdminLink)
                        {
                            <li class="govuk-service-navigation__item admin-link-nav-item">
                                <a class="govuk-service-navigation__link" href="/admin">Admin</a>
                            </li>
                        }
                        <li class="govuk-service-navigation__item sign-in-nav-item">
                            @if (showSignOut)
                            {
                                <a class="govuk-service-navigation__link" href="@signOutHref">@signOutLabel</a>
                            }
                            else
                            {
                                <a class="govuk-service-navigation__link sign-in-nav-item__primary" href="@Url.Action("Index", "LandingPage")">Sign in</a>
                                @if (showImpersonateDropdown)
                                {
                                    <button type="button" class="sign-in-nav-item__toggle" aria-expanded="false" aria-controls="sign-in-dropdown-menu" aria-label="Show sign in options">
                                        <svg class="sign-in-nav-item__caret" width="10" height="6" viewBox="0 0 10 6" fill="currentColor" aria-hidden="true" focusable="false"><path d="M0 0 L5 6 L10 0 Z"/></svg>
                                    </button>
                                    <ul id="sign-in-dropdown-menu" class="sign-in-dropdown-menu" hidden>
                                        <li><a class="sign-in-dropdown-menu__item" href="/dev/impersonate/editor" title="Take on the CMS editor role for this session. Useful when your real account doesn't have the editor role assigned, or when browsing anonymously, and you want to test editor-only CMS features.">As CMS Editor</a></li>
                                        <li><a class="sign-in-dropdown-menu__item" href="/dev/impersonate/admin" title="Take on the admin role for this session. Use this when testing admin-only surfaces.">As CMS Admin</a></li>
                                    </ul>
                                }
                            }
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </section>
    <div class="govuk-phase-banner govuk-width-container">
        <p class="govuk-phase-banner__content">
            <strong class="govuk-tag govuk-phase-banner__content__tag">
                Beta
            </strong>
            <span class="govuk-phase-banner__text">
                This is a new service – your <a class="govuk-link" href="/feedback-link">feedback</a> will help us to improve it.
            </span>
        </p>
    </div>
}

@Html.GovUkFrontendJsEnabledScript()
@await Html.PartialAsync("_ContactUsBanner")
@RenderBody()
@Html.GovUkFrontendScriptImports()

