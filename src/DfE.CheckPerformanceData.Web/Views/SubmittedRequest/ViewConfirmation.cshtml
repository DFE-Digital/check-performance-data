@using DfE.CheckPerformanceData.Web.Controllers.SubmittedRequest
@model ConfirmDataCorrectViewModel

@{
    ViewBag.Title = "Submitted request";
    Layout = "_Layout";
}

<a class="govuk-back-link" href="@Url.Action("Index", "AmendmentRequests", new { windowId = Model.WindowId })">Back</a>

<h1 class="govuk-heading-xl">Submitted request</h1>

<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Request type</dt>
        <dd class="govuk-summary-list__value">@Model.RequestTypeDisplay</dd>
    </div>
</dl>

<h2 class="govuk-heading-m">Submitted by</h2>
<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Email</dt>
        <dd class="govuk-summary-list__value">@Model.SubmittedByEmail</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">When</dt>
        <dd class="govuk-summary-list__value">@Model.SubmittedAtText</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Reference Number</dt>
        <dd class="govuk-summary-list__value">@Model.ReferenceNumber</dd>
    </div>
</dl>

<form method="post" action="@Url.Action("Delete", "SubmittedRequest", new { windowId = Model.WindowId, referenceNumber = Model.ReferenceNumber })">
    @Html.AntiForgeryToken()
    <govuk-button type="submit" class="govuk-button--warning">Delete request</govuk-button>
</form>

<p class="govuk-body">
    <a class="govuk-link" href="@Url.Action("Index", "AmendmentRequests", new { windowId = Model.WindowId })">Go back to amendment requests summary</a>
</p>
