@model DfE.CheckPerformanceData.Web.Controllers.WhatToChangeViewModel;
@using DfE.CheckPerformanceData.Domain.Enums
@using DfE.CheckPerformanceData.Web.Controllers.Journey

@{
    // Matches the <h1> the radios legend renders (is-page-heading="true").
    ViewBag.Title = "What pupil data would you like to amend?";
    Layout = "_Layout";
}

<a asp-action="Index" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId" class="govuk-back-link">Back</a>

<form method="post" action="@Url.Action("Index", "WhatToChange", new { windowId = Model.WindowId })">
    @Html.AntiForgeryToken()
    <govuk-radios for="SelectedWhatToChange">
        <govuk-radios-fieldset>
            <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                What pupil data would you like to change?
            </govuk-radios-fieldset-legend>

            <govuk-radios-hint>
                Select one option.
            </govuk-radios-hint>

            <govuk-radios-item value="@WhatToChange.Merge">Merge duplicate pupil records</govuk-radios-item>
            <govuk-radios-item value="@WhatToChange.Include">Include a pupil in data</govuk-radios-item>
            <govuk-radios-item value="@WhatToChange.Remove">Remove a pupil from data</govuk-radios-item>
            @if (Model.CheckingWindowType is { } windowType
                && AddPupilJourney.SupportedWindowTypes.Contains(windowType))
            {
                <govuk-radios-item value="@WhatToChange.Add">Add a pupil to data</govuk-radios-item>
            }
        </govuk-radios-fieldset>
    </govuk-radios>

    <govuk-button type="submit">Continue</govuk-button>
</form>