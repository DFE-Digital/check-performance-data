@model DfE.CheckPerformanceData.Web.Controllers.WhatToChangeViewModel;
@using DfE.CheckPerformanceData.Web.Controllers.Journey

@{
    // Matches the <h1> the radios legend renders (is-page-heading="true") — same words, and the
    // same noun, which is "student" on a 16-19 window.
    ViewBag.Title = $"What {Model.Noun.Singular} data would you like to change?";
    Layout = "_Layout";
}

<a asp-action="Index" asp-controller="CheckYourPupilData" asp-route-windowId="@Model.WindowId" class="govuk-back-link">Back</a>

<form method="post" action="@Url.Action("Index", "WhatToChange", new { windowId = Model.WindowId })">
    @Html.AntiForgeryToken()
    <govuk-radios for="SelectedWhatToChange">
        <govuk-radios-fieldset>
            <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                What @Model.Noun.Singular data would you like to change?
            </govuk-radios-fieldset-legend>

            <govuk-radios-hint>
                Select one option.
            </govuk-radios-hint>

            @* One radio for each change that has a flow file for this window type. *@
            @foreach (var change in Model.AvailableChanges)
            {
                <govuk-radios-item value="@change">@WhatToChangeLabel.For(change, Model.Noun)</govuk-radios-item>
            }
        </govuk-radios-fieldset>
    </govuk-radios>

    <govuk-button type="submit">Continue</govuk-button>
</form>
