@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.AddExerciseDataItem
@{
    ViewBag.Title = "Add data file";
}
<govuk-back-link href="@Model.CancelUrl" />
<span class="govuk-caption-l">@Model.ExerciseName</span>
<h1 class="govuk-heading-l">Add data file</h1>

@if (!ViewData.ModelState.IsValid)
{
    <govuk-error-summary>
        <govuk-error-summary-title>There is a problem</govuk-error-summary-title>
        @foreach (var entry in ViewData.ModelState.Where(e => e.Value?.Errors.Count > 0))
        {
            @foreach (var error in entry.Value!.Errors)
            {
                <govuk-error-summary-item href="#@entry.Key">@error.ErrorMessage</govuk-error-summary-item>
            }
        }
    </govuk-error-summary>
}
<p class="govuk-body">Add a CSV and schema pair to this exercise. After saving, choose the incoming CSV and its JSON schema.</p>
@if (Model.IsResultsEnquiry)
{
    <p class="govuk-body">A results file is merged into the results that schools search in a results enquiry, and each result shows this file's name as its source. A data share file is not: schools can view and download it on the exercise's tab, and no journey uses it.</p>
}
else if (Model.AsksUse)
{
    <p class="govuk-body">A pupil data file is merged with this exercise's other pupil data files into the pupils data that schools check and ask to change. Add one file for KS4, or two (included and non-included) for 16 to 19. A data share file is not: schools can view and download it on the exercise's tab, and no journey uses it.</p>
}
else
{
    <p class="govuk-body">Schools can view and download this file on the exercise's tab. It does not change the data any journey uses.</p>
}
<form method="post" action="@Model.PostUrl" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="WindowId" />
    <govuk-input for="Name">
        <govuk-input-label>Data file name</govuk-input-label>
        @if (Model.IsResultsEnquiry)
        {
            <govuk-input-hint>Schools see this name as the source of each result in this file, for example Late results 3.</govuk-input-hint>
        }
        else
        {
            <govuk-input-hint>Use a short name such as Included pupils or Late results.</govuk-input-hint>
        }
        <govuk-input-error-message asp-validation-for="Name" />
    </govuk-input>
    <govuk-checkboxes for="Required">
        <govuk-checkboxes-item value="true" checked="@Model.Required">This file is required before the exercise can be validated</govuk-checkboxes-item>
    </govuk-checkboxes>
    @* Use applies to the exercises with a journey, and inclusion only to pupil data. *@
    @if (Model.AsksUse)
    {
        <govuk-radios for="Use">
            <govuk-radios-fieldset>
                <govuk-radios-fieldset-legend class="govuk-fieldset__legend--m">What is this file for?</govuk-radios-fieldset-legend>
                <govuk-radios-error-message asp-validation-for="Use" />
                @if (Model.IsResultsEnquiry)
                {
                    <govuk-radios-item value="journey" checked="@(Model.Use == "journey")">
                        Results for the enquiry
                        <govuk-radios-item-hint>Merged into the results that schools search in a results enquiry.</govuk-radios-item-hint>
                    </govuk-radios-item>
                }
                else
                {
                    <govuk-radios-item value="journey" checked="@(Model.Use == "journey")">
                        Pupil data for the journeys
                        <govuk-radios-item-hint>Merged into the pupils data that schools check and ask to change.</govuk-radios-item-hint>
                    </govuk-radios-item>
                }
                <govuk-radios-item value="share" checked="@(Model.Use == "share")">
                    Data share only
                    <govuk-radios-item-hint>Schools can view and download it. No journey uses it, for example previously published data.</govuk-radios-item-hint>
                </govuk-radios-item>
            </govuk-radios-fieldset>
        </govuk-radios>
    }
    @if (Model.AsksInclusion)
    {
        <govuk-radios for="Inclusion">
            <govuk-radios-fieldset>
                <govuk-radios-fieldset-legend class="govuk-fieldset__legend--m">Pupil inclusion</govuk-radios-fieldset-legend>
                <govuk-radios-hint>Choose whether inclusion comes from the CSV or applies to every pupil in this file. A data share file has no inclusion, so this is ignored for it.</govuk-radios-hint>
                <govuk-radios-error-message asp-validation-for="Inclusion" />
                <govuk-radios-item value="file" checked="@(Model.Inclusion == "file")">Use the CSV's values</govuk-radios-item>
                <govuk-radios-item value="included" checked="@(Model.Inclusion == "included")">All pupils are included</govuk-radios-item>
                <govuk-radios-item value="excluded" checked="@(Model.Inclusion == "excluded")">All pupils are not included</govuk-radios-item>
            </govuk-radios-fieldset>
        </govuk-radios>
    }
    <govuk-button type="submit">Add data file</govuk-button>
    <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
</form>
