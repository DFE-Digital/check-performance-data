@model DfE.CheckPerformanceData.Web.Controllers.WindowAdmin.CheckingWindowDraft

<form method="post" action="@Model.PostUrl" novalidate> 
@Html.AntiForgeryToken()

<govuk-back-link asp-controller="WindowAdmin" asp-action="Index" />

@* One h1 only, and it says what the page is for. Two headings and a "confirm you want to delete
   this window" line on the create check-answers page were both wrong. *@
<h1 class="govuk-heading-l">@(ViewBag.Cancelation ? "Do you want to delete this window?" : "Check your answers")</h1>
<h2 class="govuk-heading-m">@Model.Title</h2>

<govuk-summary-list>
    <row>
        <key>Title</key>
        <value>@Model.Title</value>
        <row-actions>
            <action href="@Model.TitleLink(Url)" visually-hidden-text="Title">Change</action>
        </row-actions>
    </row>
    <row>
        <key>Window Type</key>
        <value>@Model.CheckingWindowType?.GetDisplayName()</value>
        <row-actions>
            <action href="@Model.CheckingWindowTypeLink(Url)" visually-hidden-text="Window Type">Change</action>
        </row-actions>
    </row>
    <row>
        <key>Key Stage</key>
        <value>@Model.KeyStage?.GetDisplayName()</value>
        <row-actions>
            <action href="@Model.KeyStageLink(Url)" visually-hidden-text="Key Stage">Change</action>
        </row-actions>
    </row>
    <row>
        <key>Checking exercises</key>
        <value>
            @(Model.Exercises.Count == 0
                ? "None"
                : string.Join(", ", Model.Exercises.OrderBy(e => e.SortOrder).Select(e => e.Name)))
        </value>
        <row-actions>
            <action href="@Model.ExercisesLink(Url)" visually-hidden-text="Checking exercises">Change</action>
        </row-actions>
    </row>
    @* #319: the window's own dates are the union of these and are never typed, so they get no row
       of their own here — only the exercises that produce them. Keyed by position in sort order
       (#466): a display-only exercise has no kind to key on. *@
    @{ var orderedExercises = Model.Exercises.OrderBy(e => e.SortOrder).ToList(); }
    @for (var i = 0; i < orderedExercises.Count; i++)
    {
        var exercise = orderedExercises[i];
        <row>
            <key>@exercise.Name dates</key>
            <value>
                @exercise.StartDate?.ToString("dd/MM/yyyy HH:mm") to @exercise.EndDate?.ToString("dd/MM/yyyy HH:mm")
            </value>
            <row-actions>
                <action href="@Url.Action("New", "ExerciseDates", new { index = i })"
                        visually-hidden-text="@exercise.Name dates">Change</action>
            </row-actions>
        </row>
    }
</govuk-summary-list>

@if (ViewBag.Cancelation)
{
    <govuk-button type="submit" name="action" value="continue">Continue</govuk-button>
    <govuk-button class="govuk-button--warning" name="action" value="delete">Delete</govuk-button>
}
else
{
    <govuk-button disabled="!@Model.IsValid" type="submit">Save and continue</govuk-button>
    <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
}

</form>