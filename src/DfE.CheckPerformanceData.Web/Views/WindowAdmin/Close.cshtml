@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.CloseExerciseViewModel

@{
    // Matches the <h1> below. HasError puts the "Error: " prefix on the browser title.
    ViewBag.Title = $"Close {Model.ExerciseLabel} early?";
    ViewData["HasError"] = Model.HasError;
}

<govuk-back-link href="@Model.CancelLink" />

@* AB#301022. The error summary and the field below are plain GOV.UK markup, not the library's
   input tag helpers: those register their error with the library's own summary, and the page
   would then render two. One field, one error, one summary. *@
@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#confirm-window-name">@Model.Error</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<h1 class="govuk-heading-l">Close @Model.ExerciseLabel early?</h1>

<govuk-warning-text icon-fallback-text="Warning">
    This exercise is due to close on @Model.ScheduledEndDate at @Model.ScheduledEndTime.
    @Model.Consequence
    You cannot undo this.
</govuk-warning-text>

<govuk-summary-list>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>Window</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.WindowTitle</govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>Checking exercise</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.ExerciseLabel</govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>Status</govuk-summary-list-row-key>
        @* Always Open: the controller only renders this page for an open exercise. *@
        <govuk-summary-list-row-value><strong class="govuk-tag govuk-tag--green">Open</strong></govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>Scheduled end</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.ScheduledEndDate @Model.ScheduledEndTime</govuk-summary-list-row-value>
    </govuk-summary-list-row>
</govuk-summary-list>

<p class="govuk-body">
    Requests schools have already submitted are sent for processing and cannot be changed
    afterwards. Drafts a school has not submitted are cancelled and cannot be resumed.
</p>

<form method="post" action="@Model.PostUrl" novalidate>
    @Html.AntiForgeryToken()

    <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
        <label class="govuk-label govuk-label--m" for="confirm-window-name">To confirm, type the window name</label>
        <div id="confirm-window-name-hint" class="govuk-hint">Enter exactly: @Model.WindowTitle</div>
        @if (Model.HasError)
        {
            <p id="confirm-window-name-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> @Model.Error
            </p>
        }
        <input class="govuk-input govuk-!-width-two-thirds @(Model.HasError ? "govuk-input--error" : "")"
               id="confirm-window-name" name="confirmWindowName" type="text"
               value="@Model.ConfirmWindowName"
               autocomplete="off" spellcheck="false"
               aria-describedby="confirm-window-name-hint @(Model.HasError ? "confirm-window-name-error" : "")">
    </div>

    <govuk-button type="submit" class="govuk-button--warning">
        Close @Model.ExerciseLabel
    </govuk-button>
    <a class="govuk-link govuk-!-margin-left-3" href="@Model.CancelLink">Cancel</a>
</form>
