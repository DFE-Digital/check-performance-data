@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.SampleSchoolConfirmItem

@{
    // Matches the <h1> below.
    ViewBag.Title = "Check the school before you add it";
}

<govuk-back-link href="@Model.ChangeUrl" />

<span class="govuk-caption-l">@Model.WindowTitle</span>
<h1 class="govuk-heading-l">Check the school before you add it</h1>

<govuk-summary-list>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>School</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@(Model.SchoolName ?? "Not in the establishment list")</govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>LAESTAB</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.LaestabDisplay</govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>URN</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.Urn</govuk-summary-list-row-value>
    </govuk-summary-list-row>
</govuk-summary-list>

<p class="govuk-body">
  After you add the school, validate each exercise of this window again.
  The school then sees sample data, not its real data.
</p>

<form method="post" action="@Model.PostUrl" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Laestab" value="@Model.Laestab" />
    <input type="hidden" name="Urn" value="@Model.Urn" />

    <div class="govuk-button-group">
        <govuk-button type="submit">Add school</govuk-button>
        <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
    </div>
</form>
