@using DfE.CheckPerformanceData.Web.Controllers.ViewModels
@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowViewModel

@{
    ViewData["Title"] = "Window Admin";
}

<govuk-back-link asp-controller="Admin" asp-action="Index" />

<h1 class="govuk-heading-xl">@ViewData["Title"]</h1>

@* Outcome of a delete, stashed by DeleteWindowController. *@
@if (TempData[DfE.CheckPerformanceData.Web.Controllers.WindowAdmin.DeleteWindowController.TempDataKey] is string deleteOutcome)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="delete-outcome-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="delete-outcome-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@deleteOutcome</p>
        </div>
    </div>
}

@if (Model.CanCreateWindow)
{
    <a href="@Url.Action("Start", "Title")" role="button" draggable="false" class="govuk-button" data-module="govuk-button">New window</a>
}

@if (Model.Windows.Count < 1)
{
    <p class="govuk-body">No valid windows</p>
}
else
{
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">Windows</caption>
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Window</th>
            <th scope="col" class="govuk-table__header">Checking exercise</th>
            <th scope="col" class="govuk-table__header">Type</th>
            <th scope="col" class="govuk-table__header">State</th>
            <th scope="col" class="govuk-table__header">Data</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
        </thead>
        @* One tbody per window, one row per exercise. The window name and its actions span the
           window's rows, so each exercise has its own name, type, state and data cells. *@
        @foreach (WindowListItem window in Model.Windows)
        {
            var rowSpan = Math.Max(window.Exercises.Count, 1);
            <tbody class="govuk-table__body">
            @for (var i = 0; i < rowSpan; i++)
            {
                <tr class="govuk-table__row">
                    @if (i == 0)
                    {
                        <th scope="rowgroup" rowspan="@rowSpan" class="govuk-table__header">
                            @window.Name
                            <span class="govuk-body-s govuk-hint govuk-!-font-weight-regular govuk-!-display-block govuk-!-margin-bottom-0">@window.StartDate.ToString("dd/MM/yyyy")</span>
                        </th>
                    }
                    @if (window.Exercises.Count == 0)
                    {
                        <td class="govuk-table__cell" colspan="4">No checking exercises</td>
                    }
                    else
                    {
                        var exercise = window.Exercises[i];
                        <td class="govuk-table__cell"><strong>@exercise.Name</strong></td>
                        <td class="govuk-table__cell">
                            <strong class="govuk-tag govuk-tag--grey">@exercise.KindLabel</strong>
                        </td>
                        <td class="govuk-table__cell">
                            <partial name="~/Views/WindowAdmin/_ExerciseStatusTag.cshtml" model="exercise.Status" />
                        </td>
                        <td class="govuk-table__cell">
                            <partial name="~/Views/WindowAdmin/_ExerciseDataTag.cshtml" model="exercise.DataStatus" />
                        </td>
                    }
                    @if (i == 0)
                    {
                        <td class="govuk-table__cell" rowspan="@rowSpan">
                            <a class="govuk-link" href="/admin/windows/summary/@window.Id">Edit<span class="govuk-visually-hidden"> @window.Name</span></a>
                            <a class="govuk-link govuk-!-margin-left-3" href="/admin/windows/@window.Id/requests">Requests<span class="govuk-visually-hidden"> for @window.Name</span></a>
                        </td>
                    }
                </tr>
            }
            </tbody>
        }
    </table>
}