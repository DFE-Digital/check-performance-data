@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.SampleSchoolRemoveItem

@{
    // Matches the <h1> below.
    ViewBag.Title = $"Stop using sample data for {Model.LaestabDisplay}?";
}

<govuk-back-link href="@Model.CancelUrl" />

<span class="govuk-caption-l">@Model.WindowTitle</span>
<h1 class="govuk-heading-l">Stop using sample data for @Model.LaestabDisplay?</h1>

<govuk-summary-list>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>LAESTAB</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.LaestabDisplay</govuk-summary-list-row-value>
    </govuk-summary-list-row>
    <govuk-summary-list-row>
        <govuk-summary-list-row-key>URN</govuk-summary-list-row-key>
        <govuk-summary-list-row-value>@Model.Urn</govuk-summary-list-row-value>
    </govuk-summary-list-row>
</govuk-summary-list>

<govuk-warning-text icon-fallback-text="Warning">
    After the next validation of each exercise, this school sees its real data.
</govuk-warning-text>

<form method="post" action="@Model.PostUrl" novalidate>
    @Html.AntiForgeryToken()

    <div class="govuk-button-group">
        <govuk-button type="submit" class="govuk-button--warning">Remove school</govuk-button>
        <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
    </div>
</form>
