@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowEditItem

<govuk-back-link asp-controller="WindowAdmin" asp-action="Index" />

<h1 class="govuk-heading-xl">@Model.Title</h1>
<h1 class="govuk-heading-l">Checking Window</h1>
<h2 class="govuk-heading-m">Window details</h2>

<govuk-summary-list>
  <row>
    <key>Title</key>
    <value>@Model.Title</value>
    <row-actions>
      <action href="@Model.TitleLink" visually-hidden-text="Title">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Is Published</key>
    <value>@Model.IsPublished</value>
  </row>
  <row>
    <key>Is Open</key>
    <value>@Model.IsOpen</value>
  </row>
  <row>
    <key>Start Date</key>
    <value>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</value>
    <row-actions>
      <action href="@Model.StartDateLink" visually-hidden-text="Start Date">Change</action>
    </row-actions>
  </row>
  <row>
    <key>End Date</key>
    <value>@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</value>
    <row-actions>
      <action href="@Model.EndDateLink" visually-hidden-text="End date">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Window Type</key>
    <value>@Model.CheckingWindowType</value>
    <row-actions>
      <action href="@Model.CheckingWindowTypeLink" visually-hidden-text="Window Type">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Turnaround commitment</key>
    <value>@(string.IsNullOrWhiteSpace(Model.TurnaroundCommitment) ? "Not set" : Model.TurnaroundCommitment)</value>
    <row-actions>
      <action href="@Model.TurnaroundCommitmentLink" visually-hidden-text="Turnaround commitment">Change</action>
    </row-actions>
  </row>

</govuk-summary-list>

<h2 class="govuk-heading-m">File details</h2>

@* One ingress/schema pair per dataset. A 16-19 window has two (included + non-included),
   because LDS supplies its pupils as two files that are ingested together in one run. *@
<govuk-summary-list>
  @foreach (var dataset in Model.Datasets)
  {
    <row>
      <key>@dataset.Label — ingress file</key>
      <value>@dataset.IngressFile</value>
      <row-actions>
        <action href="@dataset.IngressFileLink" visually-hidden-text="@dataset.Label ingress file">Change</action>
      </row-actions>
    </row>
    <row>
      <key>@dataset.Label — schema file</key>
      <value>@dataset.SchemaFile</value>
      <row-actions>
        <action href="@dataset.SchemaFileLink" visually-hidden-text="@dataset.Label schema file">Change</action>
      </row-actions>
    </row>
  }
</govuk-summary-list>


<govuk-button-link disabled="@(!Model.IsValidatable)" href="@Model.PostUrl">Validate Window</govuk-button-link>