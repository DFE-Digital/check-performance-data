@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowEditItem

@{
    // Matches the <h1> below.
    ViewBag.Title = Model.Title;
}

<govuk-back-link asp-controller="WindowAdmin" asp-action="Index" />

<h1 class="govuk-heading-xl">@Model.Title</h1>

<h2 class="govuk-heading-m">Window details</h2>

<govuk-summary-list>
  <row>
    <key>Title</key>
    <value>@Model.Title</value>
    <row-actions>
      <action href="@Model.TitleLink" visually-hidden-text="Title">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Is Published</key>
    <value>@Model.IsPublished</value>
  </row>
  <row>
    <key>Is Open</key>
    <value>@Model.IsOpen</value>
  </row>
  @* #319: the window's own dates are the union of its exercises' dates and are never typed, so
     there is no Change link here. Move an exercise's dates to move the window's. *@
  <row>
    <key>Start Date</key>
    <value>@Model.StartDate.ToString("dd/MM/yyyy HH:mm") <span class="govuk-hint govuk-!-display-inline">(earliest exercise start)</span></value>
  </row>
  <row>
    <key>End Date</key>
    <value>@Model.EndDate.ToString("dd/MM/yyyy HH:mm") <span class="govuk-hint govuk-!-display-inline">(latest exercise end)</span></value>
  </row>
  <row>
    <key>Window Type</key>
    <value>@Model.CheckingWindowType</value>
    <row-actions>
      <action href="@Model.CheckingWindowTypeLink" visually-hidden-text="Window Type">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Checking exercises</key>
    <value>@(Model.Exercises.Count == 0 ? "None" : string.Join(", ", Model.Exercises.Select(e => e.Label)))</value>
    <row-actions>
      <action href="@Model.ExercisesLink" visually-hidden-text="Checking exercises">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Turnaround commitment</key>
    <value>@(string.IsNullOrWhiteSpace(Model.TurnaroundCommitment) ? "Not set" : Model.TurnaroundCommitment)</value>
    <row-actions>
      <action href="@Model.TurnaroundCommitmentLink" visually-hidden-text="Turnaround commitment">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Next opportunity</key>
    <value>@(Model.NextOpportunity ?? "Not set")</value>
    <row-actions>
      <action href="@Model.NextOpportunityLink" visually-hidden-text="Next opportunity">Change</action>
    </row-actions>
  </row>
</govuk-summary-list>


<h2 class="govuk-heading-m">Checking exercises</h2>

@if (Model.Exercises.Count == 0)
{
  <p class="govuk-body">There are no checking exercises in this window. Add a checking exercise to set up its dates and data files.</p>
}
else
{
  <table class="govuk-table">
    <caption class="govuk-table__caption govuk-visually-hidden">Checking exercises for @Model.Title</caption>
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">Exercise</th>
        <th scope="col" class="govuk-table__header">Type</th>
        <th scope="col" class="govuk-table__header">Tab</th>
        <th scope="col" class="govuk-table__header">Checking dates</th>
        <th scope="col" class="govuk-table__header">Actions</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      @foreach (var exercise in Model.Exercises)
      {
        <tr class="govuk-table__row">
          <th scope="row" class="govuk-table__header">
            <a class="govuk-link" href="#exercise-@exercise.ExerciseId">@exercise.Label</a>
          </th>
          <td class="govuk-table__cell">
            @DfE.CheckPerformanceData.Web.Controllers.WindowAdmin.ExerciseLabels.For(exercise.ExerciseType)
            @if (exercise.DisplayOnly)
            {
                <strong class="govuk-tag govuk-tag--grey">Display data only</strong>
            }
          </td>
          <td class="govuk-table__cell">@(exercise.TabName ?? "Not configured")</td>
          <td class="govuk-table__cell">
            @exercise.StartDate.ToString("dd/MM/yyyy HH:mm")<br />
            to @exercise.EndDate.ToString("dd/MM/yyyy HH:mm")
          </td>
          <td class="govuk-table__cell"><a class="govuk-link" href="@exercise.EditLink">Edit<span class="govuk-visually-hidden"> @exercise.Label</span></a></td>
        </tr>
      }
    </tbody>
  </table>
}
<govuk-button-link href="@Model.AddExerciseLink">Add checking exercise</govuk-button-link>
