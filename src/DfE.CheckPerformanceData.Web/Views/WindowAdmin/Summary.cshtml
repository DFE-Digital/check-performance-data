@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowEditItem

@{
    // Matches the <h1> below.
    ViewBag.Title = Model.Title;
}

<govuk-back-link asp-controller="WindowAdmin" asp-action="Index" />

<h1 class="govuk-heading-xl">@Model.Title</h1>

@* Outcome of a close or of a hand-over, stashed by CloseExerciseController or
   SendExerciseRequestsController. Quotes what actually happened. *@
@if (TempData[DfE.CheckPerformanceData.Web.Controllers.WindowAdmin.CloseExerciseController.TempDataKey] is string closeOutcome)
{
  <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
       aria-labelledby="close-outcome-title" data-module="govuk-notification-banner">
    <div class="govuk-notification-banner__header">
      <h2 class="govuk-notification-banner__title" id="close-outcome-title">Success</h2>
    </div>
    <div class="govuk-notification-banner__content">
      <p class="govuk-notification-banner__heading">@closeOutcome</p>
    </div>
  </div>
}

@* AB#301022: a close or hand-over that was refused — the exercise was not in the state the action
   needs. Neutral, not an error: nothing the admin typed was wrong. *@
@if (TempData[DfE.CheckPerformanceData.Web.Controllers.WindowAdmin.SendExerciseRequestsController.RefusedTempDataKey] is string closeRefused)
{
  <div class="govuk-notification-banner" role="region"
       aria-labelledby="close-refused-title" data-module="govuk-notification-banner">
    <div class="govuk-notification-banner__header">
      <h2 class="govuk-notification-banner__title" id="close-refused-title">Important</h2>
    </div>
    <div class="govuk-notification-banner__content">
      <p class="govuk-notification-banner__heading">@closeRefused</p>
    </div>
  </div>
}

<h2 class="govuk-heading-m">Window details</h2>

<govuk-summary-list>
  <row>
    <key>Title</key>
    <value>@Model.Title</value>
    <row-actions>
      <action href="@Model.TitleLink" visually-hidden-text="Title">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Is Published</key>
    <value>@Model.IsPublished</value>
  </row>
  <row>
    <key>Is Open</key>
    <value>@Model.IsOpen</value>
  </row>
  @* #319: the window's own dates are the union of its exercises' dates and are never typed, so
     there is no Change link here. Move an exercise's dates to move the window's. *@
  <row>
    <key>Start Date</key>
    <value>@Model.StartDate.ToString("dd/MM/yyyy HH:mm") <span class="govuk-hint govuk-!-display-inline">(earliest exercise start)</span></value>
  </row>
  <row>
    <key>End Date</key>
    <value>@Model.EndDate.ToString("dd/MM/yyyy HH:mm") <span class="govuk-hint govuk-!-display-inline">(latest exercise end)</span></value>
  </row>
  <row>
    <key>Window Type</key>
    <value>@Model.CheckingWindowType</value>
    <row-actions>
      <action href="@Model.CheckingWindowTypeLink" visually-hidden-text="Window Type">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Checking exercises</key>
    <value>@(Model.Exercises.Count == 0 ? "None" : string.Join(", ", Model.Exercises.Select(e => e.Label)))</value>
    <row-actions>
      <action href="@Model.ExercisesLink" visually-hidden-text="Checking exercises">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Turnaround commitment</key>
    <value>@(string.IsNullOrWhiteSpace(Model.TurnaroundCommitment) ? "Not set" : Model.TurnaroundCommitment)</value>
    <row-actions>
      <action href="@Model.TurnaroundCommitmentLink" visually-hidden-text="Turnaround commitment">Change</action>
    </row-actions>
  </row>
  <row>
    <key>Next opportunity</key>
    <value>@(Model.NextOpportunity ?? "Not set")</value>
    <row-actions>
      <action href="@Model.NextOpportunityLink" visually-hidden-text="Next opportunity">Change</action>
    </row-actions>
  </row>
</govuk-summary-list>

@* One section per checking exercise. Each validates independently — a window is usable while
   another of its exercises is still unvalidated. *@
@foreach (var exercise in Model.Exercises)
{
  <h2 class="govuk-heading-m">@exercise.Label</h2>

  <govuk-summary-list>
    <row>
      <key>Start Date</key>
      <value>@exercise.StartDate.ToString("dd/MM/yyyy HH:mm")</value>
      <row-actions>
        <action href="@exercise.DatesLink" visually-hidden-text="@exercise.Label start date">Change</action>
      </row-actions>
    </row>
    <row>
      <key>End Date</key>
      <value>@exercise.EndDate.ToString("dd/MM/yyyy HH:mm")</value>
      <row-actions>
        <action href="@exercise.DatesLink" visually-hidden-text="@exercise.Label end date">Change</action>
      </row-actions>
    </row>
    <row>
      <key>Status</key>
      <value><strong class="govuk-tag @exercise.StatusTagClass">@exercise.StatusLabel</strong></value>
    </row>
    <row>
      <key>Validated</key>
      <value>
        @if (exercise.IsValidated)
        {
          @($"Yes, {exercise.ValidatedAt:dd/MM/yyyy HH:mm}")
        }
        else if (exercise.IsStale)
        {
          @* The stamp's checksums no longer match the files the exercise holds, so it describes
             data that has since been replaced. Saying "No" would lose that distinction. *@
          @($"Not since the files changed (last validated {exercise.ValidatedAt:dd/MM/yyyy HH:mm})")
        }
        else
        {
          @:No
        }
      </value>
    </row>
  </govuk-summary-list>

  @if (exercise.Datasets.Count == 0)
  {
    <p class="govuk-body">This exercise has no ingress files to load.</p>
  }
  else
  {
    <govuk-summary-list>
      @foreach (var dataset in exercise.Datasets)
      {
        @* An optional slot is a file the supplier may deliver later, or not at all — the results
           feed's late, revised and retention files. Saying so is what stops an admin waiting for a
           file that is not coming before validating the ones that have arrived. *@
        <row>
          <key>@dataset.Label — ingress file@(dataset.Required ? "" : " (optional)")</key>
          <value>@(string.IsNullOrWhiteSpace(dataset.IngressFile) ? "Not supplied" : dataset.IngressFile)</value>
          <row-actions>
            <action href="@dataset.IngressFileLink" visually-hidden-text="@dataset.Label ingress file">Change</action>
          </row-actions>
        </row>
        <row>
          <key>@dataset.Label — schema file@(dataset.Required ? "" : " (optional)")</key>
          <value>@(string.IsNullOrWhiteSpace(dataset.SchemaFile) ? "Not supplied" : dataset.SchemaFile)</value>
          <row-actions>
            <action href="@dataset.SchemaFileLink" visually-hidden-text="@dataset.Label schema file">Change</action>
          </row-actions>
        </row>
      }
    </govuk-summary-list>
  }

  <div class="govuk-button-group">
    @if (exercise.Datasets.Count > 0)
    {
      <govuk-button-link disabled="@(!exercise.IsValidatable)" href="@exercise.ValidateLink">
        Validate @exercise.Label
      </govuk-button-link>
    }

    @* AB#301022: Close is offered only while schools can still use the exercise, and it does not
       depend on the exercise having ingress files. The label is in the VISIBLE text, so the
       repeated-accessible-name rule needs no govuk-visually-hidden suffix here. *@
    @if (exercise.IsOpen)
    {
      <govuk-button-link class="govuk-button--warning" href="@exercise.CloseLink">
        Close @exercise.Label
      </govuk-button-link>
    }

    @* Once an exercise has closed — early or on schedule — its requests can still be handed
       over. Nothing does that automatically at a scheduled end. *@
    @if (exercise.HasClosed)
    {
      <govuk-button-link class="govuk-button--warning" href="@exercise.SendRequestsLink">
        Send @exercise.Label requests for processing
      </govuk-button-link>
    }
  </div>
}
