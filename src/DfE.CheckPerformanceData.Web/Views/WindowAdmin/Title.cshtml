@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.WindowTitleEditItem

<form method="post" action="@Model.PostUrl" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="WindowId" value="@Model.WindowId" />
    
    <govuk-input for="@Model.Title">
        <govuk-input-label is-page-heading="true" class="govuk-label--l">Edit title for @Model.Title</govuk-input-label>
        <govuk-input-hint>Enter the name for the window.</govuk-input-hint>
        <govuk-input-error-message asp-validation-for="Title" />
    </govuk-input>
    
    <govuk-button type="submit">Save and continue</govuk-button>
    <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
</form>