@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.ValidationViewModel

@{
    // Matches the <h1> below. #319: a run belongs to one checking exercise, so the page says which.
    ViewBag.Title = $"Validate {Model.ExerciseLabel}";
}

<h1 class="govuk-heading-l">Validate @Model.ExerciseLabel</h1>

@* No-JS fallback: the POST renders this summary once processing has run to completion. *@
@if (Model.ProcessingResult is not null)
{
    var failed = Model.ProcessingResult.ErrorCount > 0;
    <div class="govuk-panel govuk-panel--confirmation">
        @* h2, not h1: the page already has one above. Two would break the single-h1 rule the
           moment the no-JS fallback rendered its result. *@
        <h2 class="govuk-panel__title">@(failed ? "Validation failed" : "Validation complete")</h2>
        <div class="govuk-panel__body">@Model.ProcessingResult.ErrorLogs</div>
    </div>

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Records read</dt>
            <dd class="govuk-summary-list__value">@Model.ProcessingResult.RecordsRead</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Files written</dt>
            <dd class="govuk-summary-list__value">@Model.ProcessingResult.FilesWritten</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Errors</dt>
            <dd class="govuk-summary-list__value">@Model.ProcessingResult.ErrorCount</dd>
        </div>
    </dl>

    @if (Model.ProcessingResult.SchoolSummary is { Count: > 0 } schoolSummary)
    {
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--m">Records processed per LAESTAB</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">LAESTAB</th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric">Records processed</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var school in schoolSummary)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@school.Laestab</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@school.RecordCount</td>
                    </tr>
                }
            </tbody>
            <tfoot class="govuk-table__foot">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">Total LAESTAB: @schoolSummary.Count</th>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@schoolSummary.Sum(s => s.RecordCount)</td>
                </tr>
            </tfoot>
        </table>
    }
}

<div class="validate-window" data-module="validate-progress" data-stream-url="@Model.StreamUrl">

    @* Progressive enhancement: JS hides this form and drives the live stream instead. The form
       still works without JS, posting to the fallback action above. *@
    <form method="post" action="@Model.PostUrl" novalidate data-validate-form>
        @Html.AntiForgeryToken()
        <govuk-button type="submit" data-validate-start>Run validation</govuk-button>
    </form>

    <div class="govuk-!-display-none" data-validate-status-wrapper>
        <p class="govuk-body" data-validate-status aria-live="polite">Starting checks…</p>

        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Records read</dt>
                <dd class="govuk-summary-list__value" data-validate-records-read>0</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Records processed</dt>
                <dd class="govuk-summary-list__value" data-validate-records-processed>0</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Files written</dt>
                <dd class="govuk-summary-list__value" data-validate-files-written>0</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Errors</dt>
                <dd class="govuk-summary-list__value" data-validate-errors>0</dd>
            </div>
        </dl>
    </div>

    <div class="govuk-!-display-none" data-validate-summary aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/js/validate-progress.js" asp-append-version="true"></script>
}
