@model DfE.CheckPerformanceData.Web.Controllers.ViewModels.WindowAdmin.ExerciseExtensionItem
@* AB#307773, decision 10. Shown on the extension form when some schools have no data file in the
   exercise's current release. The controller saves only once ConfirmNoData is ticked, so this holds
   without JavaScript: the next POST carries the tick. Plain checkbox markup, not the library's
   checkboxes tag helper: there is no error on it, and that helper can render a second summary. *@
<div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
        <span class="govuk-visually-hidden">Warning</span>
        @if (Model.ExerciseHasNoRelease)
        {
            @:This exercise has no release yet, so no school has a data file.
        }
        else
        {
            @:These schools have no data file in the current release. You can still add them: they may get their data in a later release.
        }
    </strong>
</div>
<ul class="govuk-list govuk-list--bullet">
    @foreach (var school in Model.SchoolsWithoutData)
    {
        <li>@school</li>
    }
</ul>
<div class="govuk-form-group">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="ConfirmNoData" name="ConfirmNoData" type="checkbox" value="true"
                   @(Model.ConfirmNoData ? "checked" : null) />
            <label class="govuk-label govuk-checkboxes__label" for="ConfirmNoData">@Model.ConfirmLabel</label>
        </div>
    </div>
</div>
