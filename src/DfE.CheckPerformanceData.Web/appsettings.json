{
  "GoogleTagManager": {
    "Enabled": true,
    "ContainerId": "GTM-KNBZVW7Q",
    "AuthKey": "",
    "PreviewId": ""
  },
  "Clarity": {
    "Enabled": true,
    "ProjectId": "wjrp3ai9r0"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Postgres",
          "tableName": "Logs",
          "needAutoCreateTable": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "PollySettings": {
    "MaxRetryAttempts": 3,
    "BaseDelayMilliseconds": 1000,
    "JitterMilliseconds": 500
  },
  "Dev": {
    "ToolsEnabled": false
  }
}
