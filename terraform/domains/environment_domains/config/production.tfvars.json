{
  "hosted_zone": {
    "check-performance-data.education.gov.uk": {
      "front_door_name": "s189p01-cypd-dom-fd",
      "resource_group_name": "s189p01-cypd-dom-rg",
      "domains": [
        "apex"
      ],
      "cached_paths": [
        "/assets/*"
      ],
      "environment_short": "pd",
      "origin_hostname": "check-performance-data-production.teacherservices.cloud"
    }
  },
  "rate_limit_max": 1000,
  "allow_aks": true,
  "block_ip": true,
  "rate_limit": [
    {
      "agent": "allow-admins",
      "priority": 10,
      "enabled": "true",
      "type": "MatchRule",
      "action": "Allow",
      "match_variable": "RemoteAddr",
      "operator": "IPMatch",
      "match_values": ["192.168.10.10/32", "192.168.10.0/24"]
    },
    {
      "agent": "allow-monitoring",
      "priority": 20,
      "enabled": "true",
      "type": "MatchRule",
      "action": "Allow",
      "match_variable": "RemoteAddr",
      "operator": "IPMatch",
      "match_values": ["192.168.20.20/32"]
    },
    {
      "agent": "block-all-other",
      "priority": 200,
      "enabled": "true",
      "type": "MatchRule",
      "action": "Block",
      "match_variable": "RemoteAddr",
      "operator": "IPMatch",
      "match_values": ["0.0.0.0/0", "::/0"]
    }
  ]
}
